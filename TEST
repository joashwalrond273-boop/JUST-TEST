-- Freecam Script Logic. Global on purpose (main chunk is near Luau's 200-local limit).
FreecamState = {
	active = false,
	pos = Vector3.zero,
	yaw = 0,
	pitch = 0,
	speed = 50,
	turn = 1,
	keys = {},
	lookDelta = Vector2.zero,
	controls = nil,
	saved = nil,
	frozen = false,
	frozenHumanoid = nil,
	frozenParts = nil,
}

-- Grab the default ControlModule so the on-screen joystick (mobile) and WASD (PC)
-- can be read through one API.
function getPlayerControls()
	local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
	local playerModule = playerScripts and playerScripts:FindFirstChild("PlayerModule")
	if not playerModule then return nil end
	local ok, module = pcall(require, playerModule)
	if not ok or not module then return nil end
	local ok2, controls = pcall(function() return module:GetControls() end)
	if ok2 then return controls end
	return nil
end

-- Move input in camera space: X is right, -Z is forward (the ControlModule
-- convention shared by the mobile thumbstick and the keyboard).
function getMoveVector()
	local controls = FreecamState.controls
	if controls then
		local ok, v = pcall(function() return controls:GetMoveVector() end)
		if ok and typeof(v) == "Vector3" and v.Magnitude > 0 then
			return v
		end
	end
	return nil
end

-- The default mobile joystick sits under PlayerGui.TouchGui. Touches that start
-- there are movement, not camera, so they must not swing the view.
function isJoystickTouch(position)
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local touchGui = playerGui and playerGui:FindFirstChild("TouchGui")
	if not touchGui then return false end
	local frame = touchGui:FindFirstChild("ThumbstickFrame", true)
	if not frame then return false end
	local topLeft = frame.AbsolutePosition
	local size = frame.AbsoluteSize
	return position.X >= topLeft.X and position.X <= topLeft.X + size.X
		and position.Y >= topLeft.Y and position.Y <= topLeft.Y + size.Y
end

-- Hold the body still while freecam is active: no walking, turning or jumping.
-- The body parts are also anchored, because plenty of games rewrite WalkSpeed
-- every frame, which would drag the character along with the joystick.
function freezeCharacter(freeze)
	local humanoid = getHumanoid()
	if freeze then
		if FreecamState.frozen and FreecamState.frozenHumanoid == humanoid then return end
		if humanoid then
			FreecamState.saved = {
				WalkSpeed = humanoid.WalkSpeed,
				AutoRotate = humanoid.AutoRotate,
				JumpPower = humanoid.JumpPower,
				JumpHeight = humanoid.JumpHeight,
			}
			humanoid.WalkSpeed = 0
			humanoid.AutoRotate = false
			humanoid.JumpPower = 0
			humanoid.JumpHeight = 0
			FreecamState.frozenHumanoid = humanoid

			local character = humanoid.Parent
			local pinned = {}
			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") and not part.Anchored then
						part.AssemblyLinearVelocity = Vector3.zero
						part.AssemblyAngularVelocity = Vector3.zero
						part.Anchored = true
						table.insert(pinned, part)
					end
				end
			end
			FreecamState.frozenParts = pinned
		end
		FreecamState.frozen = true
	else
		local saved = FreecamState.saved
		if humanoid and saved then
			humanoid.WalkSpeed = saved.WalkSpeed
			humanoid.AutoRotate = saved.AutoRotate
			humanoid.JumpPower = saved.JumpPower
			humanoid.JumpHeight = saved.JumpHeight
		end

		local pinned = FreecamState.frozenParts
		if pinned then
			for _, part in ipairs(pinned) do
				if part and part.Parent then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
					part.Anchored = false
				end
			end
		end

		FreecamState.frozen = false
		FreecamState.saved = nil
		FreecamState.frozenHumanoid = nil
		FreecamState.frozenParts = nil
	end
end

function stopFreecam()
	FreecamState.active = false
	FreecamState.keys = {}
	FreecamState.lookDelta = Vector2.zero
	disconnect("FreecamLoop")
	disconnect("FreecamInputBegan")
	disconnect("FreecamInputEnded")
	disconnect("FreecamTouch")
	freezeCharacter(false)
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		local localHum = getHumanoid()
		if localHum then camera.CameraSubject = localHum end
	end
	pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
end

function startFreecam()
	disconnect("FreecamLoop")
	disconnect("FreecamInputBegan")
	disconnect("FreecamInputEnded")
	disconnect("FreecamTouch")
	local camera = workspace.CurrentCamera
	if not camera then return end

	FreecamState.active = true
	FreecamState.keys = {}
	FreecamState.lookDelta = Vector2.zero
	FreecamState.controls = getPlayerControls()
	FreecamState.pos = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	FreecamState.yaw = math.atan2(-look.X, -look.Z)
	FreecamState.pitch = math.asin(math.clamp(look.Y, -1, 1))
	FreecamState.speed = (Options.FreecamSpeed and Options.FreecamSpeed.Value) or 50
	FreecamState.turn = ((Options.FreecamTurnSpeed and Options.FreecamTurnSpeed.Value) or 100) / 100

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CameraSubject = nil
	pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter end)
	freezeCharacter(true)

	-- Extra keys: Space/E up, Ctrl/Q down, Shift to sprint (PC).
	track("FreecamInputBegan", UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			FreecamState.keys[input.KeyCode] = true
		end
	end))
	track("FreecamInputEnded", UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			FreecamState.keys[input.KeyCode] = nil
		end
	end))
	-- Drag to look on mobile. Joystick touches move the camera instead, so they are
	-- filtered out by position and handled through the ControlModule. Touch deltas
	-- are Vector3, so they are flattened before being accumulated.
	track("FreecamTouch", UserInputService.TouchMoved:Connect(function(input)
		if isJoystickTouch(input.Position) then return end
		local d = input.Delta
		FreecamState.lookDelta = FreecamState.lookDelta + Vector2.new(d.X, d.Y)
	end))

	track("FreecamLoop", RunService.RenderStepped:Connect(function(dt)
		if not FreecamState.active then return end
		local cam = workspace.CurrentCamera
		if not cam then return end

		-- Re-freeze if the character respawned while freecam is on.
		if FreecamState.frozenHumanoid ~= getHumanoid() then
			FreecamState.frozen = false
			freezeCharacter(true)
		end

		-- Look with the mouse (PC) or a touch drag (mobile). A drag covers far fewer
		-- pixels than a mouse, so touch gets a higher sensitivity. Both are scaled by
		-- the Turn Speed slider.
		local mouseDelta = UserInputService:GetMouseDelta()
		local touchDelta = FreecamState.lookDelta
		FreecamState.lookDelta = Vector2.zero
		local turnScale = FreecamState.turn
		local turnX = (mouseDelta.X * 0.0040 + touchDelta.X * 0.0125) * turnScale
		local turnY = (mouseDelta.Y * 0.0040 + touchDelta.Y * 0.0125) * turnScale
		FreecamState.yaw = FreecamState.yaw - turnX
		FreecamState.pitch = math.clamp(FreecamState.pitch - turnY, math.rad(-89), math.rad(89))
		local rotation = CFrame.fromEulerAnglesYXZ(FreecamState.pitch, FreecamState.yaw, 0)

		-- Move with the joystick / WASD; the body stays put while the camera flies.
		local move = Vector3.zero
		local input = getMoveVector()
		if input then
			move = rotation.RightVector * input.X + rotation.LookVector * (-input.Z)
		else
			local keys = FreecamState.keys
			if keys[Enum.KeyCode.W] then move = move + rotation.LookVector end
			if keys[Enum.KeyCode.S] then move = move - rotation.LookVector end
			if keys[Enum.KeyCode.A] then move = move - rotation.RightVector end
			if keys[Enum.KeyCode.D] then move = move + rotation.RightVector end
			if keys[Enum.KeyCode.Space] or keys[Enum.KeyCode.E] then move = move + Vector3.new(0, 1, 0) end
			if keys[Enum.KeyCode.LeftControl] or keys[Enum.KeyCode.Q] then move = move - Vector3.new(0, 1, 0) end
		end

		local speed = FreecamState.speed
		if FreecamState.keys[Enum.KeyCode.LeftShift] then speed = speed * 2 end
		if move.Magnitude > 0 then move = move.Unit end

		FreecamState.pos = FreecamState.pos + move * speed * dt
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CameraSubject = nil
		cam.CFrame = CFrame.new(FreecamState.pos) * rotation
	end))
end

