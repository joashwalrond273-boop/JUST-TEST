		track("AdminSpectateAlert_Loop", RunService.Heartbeat:Connect(function()
			if not spectateAlertActive then return end

			local now = tick()
			if now - spectateLastAlert < 4 then return end

			local ok, spectatingAdmin = pcall(getAdminSpectatingMe)
			if ok and spectatingAdmin then
				spectateLastAlert = now
				Library:Notify({ Title = "SPECTATE ALERT", Description = spectatingAdmin .. " may be spectating you!", Time = 4 })
			end
		end))

		Library:Notify({ Title = "Spectate Alert", Description = "Enabled", Time = 2 })
	end)

