	-- layout, so without that call a slider that just became visible stayed
	-- clipped. (Same pattern as WaterBypassFOV in the Aimbot CONFIG sub-tab.)
	local function setVisible(element, visible)
		if element and element.SetVisible then
			element:SetVisible(visible and true or false)
		end
	end

	setVisible(Options.AutoSwingSlot, true)
	setVisible(Toggles.SwingSpeedToggle, true)
	setVisible(Options.SwingSpeedVal, isSwingSpeed)
	setVisible(Options.AutoSwingSpeed, isAnyToggled)
	setVisible(Options.PlayerStuds, isSmartSwingToggled)
	setVisible(Toggles.SmartSwingIgnoreTeam, isSmartSwingToggled)

	-- A sub-tab measures itself from AbsoluteContentSize, which the layout engine
	-- only refreshes after the current frame's UI pass, so re-run the resize on
	-- the next frame as well to pick up the height the newly shown slider adds.
	task.defer(function()
		if AutoSwingTabBox and AutoSwingTabBox.Resize then
			AutoSwingTabBox:Resize()
		end
	end)
end

