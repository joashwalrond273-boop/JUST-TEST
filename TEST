-- Look for a matching forge/furnace already close to the player so the armor
-- buttons craft with it instead of building a duplicate structure. Global on
-- purpose: the main chunk is at Luau's 200-local register limit.
function findNearbyForge(playerPosition, matcher, radius)
	radius = radius or 20
	local structures = workspace:FindFirstChild("placedStructures")
	if not structures then return nil end
	local best, bestDist = nil, math.huge
	for _, structure in pairs(structures:GetChildren()) do
		local candidates = { structure }
		for _, child in ipairs(structure:GetChildren()) do
			table.insert(candidates, child)
		end
		for _, cand in ipairs(candidates) do
			if matcher(cand) then
				local okPos, pos = pcall(function()
					if cand:IsA("BasePart") then
						return cand.Position
					elseif cand:IsA("Model") then
						return cand:GetPivot().Position
					end
					local primary = cand.PrimaryPart
					return primary and primary.Position or nil
				end)
				if okPos and pos then
					local dist = (pos - playerPosition).Magnitude
					if dist <= radius and dist < bestDist then
						best, bestDist = cand, dist
					end
				end
			end
		end
	end
	return best
end

