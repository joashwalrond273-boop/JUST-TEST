			{197, "Sword"},
			{202, "Helmet"},
			{200, "Chestplate"},
			{201, "Pants"},
		}

		if furnace then
			for _, item in ipairs(itemsToCraft) do
				if isArmorPieceSelected(item[2]) then
					pcall(function()
						craftRemote:InvokeServer(item[1], furnace, 1, 0)
					end)
				end
			end

			task.wait(getCraftDelay())

			if not (Toggles.ArmorCraftOnly and Toggles.ArmorCraftOnly.Value) then
				if isArmorPieceSelected("Sword") then
					pcall(function()
						equipHotbarRemote:InvokeServer("inventory", armorSlot, 197)
					end)
				end
				if isArmorPieceSelected("Helmet") then
					pcall(function()
						equipClothingRemote:InvokeServer("inventory", 1, 202)
					end)
				end
				if isArmorPieceSelected("Chestplate") then
					pcall(function()
						equipClothingRemote:InvokeServer("inventory", 2, 200)
					end)
				end
				if isArmorPieceSelected("Pants") then
					pcall(function()
						equipClothingRemote:InvokeServer("inventory", 3, 201)
					end)
				end
			end

			if not usedExistingForge then
				pcall(function()
					deleteRemote:FireServer(furnace)
				end)
			end

		else
			Library:Notify({ Title = "Bluesteel", Description = "Furnace not found", Time = 3 })
		end
	end,
})

