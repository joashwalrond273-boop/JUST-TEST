-- Reset-then-teleport helper: resets the character first, then teleports on respawn.
local pendingTeleportResolve = nil
local pendingTeleportLabel = nil
local pendingTeleportGlue = nil

track("TeleportResetRespawn", LocalPlayer.CharacterAdded:Connect(function()
	if not pendingTeleportResolve then return end
	local resolve = pendingTeleportResolve
	local label = pendingTeleportLabel
	local glue = pendingTeleportGlue
	pendingTeleportResolve = nil
	pendingTeleportLabel = nil
	pendingTeleportGlue = nil

	disconnect("TeleportGlue")

	-- Non-glue teleports keep the original short pause.
	if not glue then
		task.wait(1)
	end

	-- Grab the fresh character the moment its root exists (~1 frame).
	local root = getRootPart()
	local waitStart = tick()
	while not root and tick() - waitStart < 3 do
		task.wait()
		root = getRootPart()
	end
	if not root then
		Library:Notify({ Title = "Reset & Teleport", Description = "Character not found.", Time = 2 })
		return
	end

	local cf = resolve()
	if not cf then return end

	-- Warp to the destination immediately on spawn instead of waiting behind.
	root.CFrame = cf
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	if glue then
		-- Keep the destination pinned for only a few frames so the solver cannot
		-- build up the ejection impulse that shows up as a fling, then let go.
		-- No PlatformStand and no long hold, so the player is never left glued
		-- in the air unable to move after a teleport.
		local glueStart = tick()
		track("TeleportGlue", RunService.Stepped:Connect(function()
			local glueRoot = getRootPart()
			if not glueRoot then return end

			-- Cancel motion while pinned
			glueRoot.AssemblyLinearVelocity = Vector3.zero
			glueRoot.AssemblyAngularVelocity = Vector3.zero
			glueRoot.CFrame = cf

			if tick() - glueStart >= 0.1 then
				disconnect("TeleportGlue")
			end
		end))
	end

	Library:Notify({ Title = "Reset & Teleport", Description = "Teleported to " .. label, Time = 2 })
end))

resetAndTeleport = function(targetPos, label, glue)
	local resolve
	if type(targetPos) == "function" then
		resolve = targetPos
	else
		resolve = function()
			return CFrame.new(targetPos + Vector3.new(0, 10, 0))
		end
	end

	pendingTeleportResolve = resolve
	pendingTeleportLabel = label
	pendingTeleportGlue = glue or nil

	local remoteInterface = ReplicatedStorage:FindFirstChild("remoteInterface")
	local characterFolder = remoteInterface and remoteInterface:FindFirstChild("character")
	local resetRemote = characterFolder and characterFolder:FindFirstChild("reset")
	if resetRemote then
		local ok = pcall(function()
			resetRemote:InvokeServer()
		end)
		if ok then
			return
		end
	end

	-- Reset unavailable: fall back to a direct teleport.
	pendingTeleportResolve = nil
	pendingTeleportLabel = nil
	pendingTeleportGlue = nil
	local root = getRootPart()
	if not root then
		Library:Notify({ Title = "Teleport", Description = "Character not found.", Time = 3 })
		return
	end
	local cf = resolve()
	if cf then
		root.CFrame = cf
		Library:Notify({ Title = "Teleport", Description = "Teleported to " .. label, Time = 1.5 })
	end
end

-- Meteor
TSG_PickActiveMeteor = function()
	local active = ReplicatedStorage:FindFirstChild("activeEvents")
	if not active then return nil end
	local now = workspace:GetServerTimeNow()
	local soonest, soonestAt = nil, math.huge
	local latest, latestAt = nil, -math.huge
	for _, ev in ipairs(active:GetChildren()) do
		if ev:IsA("Folder") and ev:GetAttribute("type") == "Meteor" then
			local impactAt = ev:GetAttribute("ImpactAt")
			if typeof(impactAt) == "number" then
				if impactAt >= now and impactAt < soonestAt then
					soonest, soonestAt = ev, impactAt
				end
				if impactAt > latestAt then
					latest, latestAt = ev, impactAt
				end
			end
		end
	end
	return soonest or latest
end

TSG_TeleportToMeteor = function(ev, label)
	local target = ev and ev:GetAttribute("TargetCFrame")
	if typeof(target) ~= "CFrame" then
		Library:Notify({ Title = "Meteor", Description = "No meteor landing point found.", Time = 2 })
		return
	end
	local cf = CFrame.new(target.Position + Vector3.new(0, 8, 0))
	resetAndTeleport(function() return cf end, label or "Meteor", true)
end

