function getMineableFolder()
	return workspace:FindFirstChild("worldResources") and workspace.worldResources:FindFirstChild("mineable")
end

-- Walk every resource node under a world-resources folder. Nodes live in chunk
-- folders, but some builds nest deeper or place them directly, so we scan any
-- Folder descendants and treat every non-Folder object as a node.
function forEachResourceNode(folder, callback)
	if not folder then return end
	local function scan(container, depth)
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Folder") then
				if depth < 4 then scan(child, depth + 1) end
			else
				callback(child)
			end
		end
	end
	scan(folder, 0)
end

function getChoppableFolder()
	return workspace:FindFirstChild("worldResources") and workspace.worldResources:FindFirstChild("choppable")
end

-- Ore nodes are sometimes Models (with a PrimaryPart) and sometimes plain
-- BaseParts, so resolve whichever part actually exists.
function getMineableAnchor(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

function refreshSelector(option, folder)
	if not option then return end

	local previous = option.Value

	local found = {}
	forEachResourceNode(folder, function(obj)
		if obj.Name and obj.Name ~= "" then
			found[obj.Name] = true
		end
	end)

	-- Keep the current choice in the list. The folder briefly empties while a
	-- reset streams chunks back in, and Obsidian's SetValues drops the selected
	-- value from the dropdown whenever it is missing from the new list.
	if previous and previous ~= "None" then
		found[previous] = true
	end

	local names = {}
	for name in pairs(found) do table.insert(names, name) end
	table.sort(names)

	local values = { "None" }
	for _, name in ipairs(names) do table.insert(values, name) end
	option:SetValues(values)
end

function refreshFarmSelector()
	refreshSelector(Options.FarmSelector, getMineableFolder())
end

function refreshChopSelector()
