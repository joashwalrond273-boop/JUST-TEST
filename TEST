				for _, structure in pairs(workspace.placedStructures:GetChildren()) do
					if structure.Name:lower():find("bluesteel") then
						furnace = structure
						break
					end
					for _, child in ipairs(structure:GetChildren()) do
						if child.Name:lower():find("bluesteel") then
							furnace = child
							break
						end
					end
					if furnace then break end
				end
			end)
		end

