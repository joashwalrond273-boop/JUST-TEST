-- True whenever silent aim can be active at all: either the main toggle is on,
-- or the Slot System is on, which arms silent aim by itself for the picked slots
-- (so the main toggle is not needed in that case).
function SilentAimHK.armed()
	return (Toggles.SilentAimHK and Toggles.SilentAimHK.Value) == true
		or (Toggles.SAHKSlotSystem and Toggles.SAHKSlotSystem.Value) == true
end

function SilentAimHK.isEnabled()
	-- Slot System drives silent aim on its own: while it is on, holding a tool in
	-- one of the picked slots enables silent aim, and any other tool disables it.
	-- SlotAllowed is a cached heartbeat sample, so this never makes an engine call
	-- from inside the __namecall / __index hook.
	if Toggles.SAHKSlotSystem and Toggles.SAHKSlotSystem.Value then
		return SilentAimHK.SlotAllowed == true
	end
	return (Toggles.SilentAimHK and Toggles.SilentAimHK.Value) == true
end

-- Which of the four interception methods are switched on right now.
function SilentAimHK.getAimMethods()
	local selected = Options.SAHKAimMethods and Options.SAHKAimMethods.Value
	local result = { ray = false, fire = false, invoke = false, mouse = false }
	if type(selected) ~= "table" then
		result.ray = true
		return result
	end
	for key, value in pairs(selected) do
		local name = type(key) == "string" and key or value
		if name == "Raycast" then
			result.ray = true
		elseif name == "FireServer" then
			result.fire = true
		elseif name == "InvokeServer" then
			result.invoke = true
		elseif name == "Mouse.Hit" then
			result.mouse = true
		end
	end
	if not (result.ray or result.fire or result.invoke or result.mouse) then
		result.ray = true
	end
	return result
end

-- Remote names to intercept, parsed out of the "Remote Gestalt" text box.
function SilentAimHK.getRemoteNames()
	local text = (Options.SAHKRemoteGestalt and Options.SAHKRemoteGestalt.Value) or ""
	local cache = SilentAimHK.RemoteNameCache
	if cache and cache.text == text then
		return cache.names
	end
	local names = {}
	for item in string.gmatch(text, "[^,]+") do
		local trimmed = string.match(item, "^%s*(.-)%s*$")
		if trimmed ~= "" then
			table.insert(names, string.lower(trimmed))
		end
	end
	if #names == 0 then
		names = { "hit", "bullet", "projectile", "hitscan" }
	end
	SilentAimHK.RemoteNameCache = { text = text, names = names }
	return names
end

-- The name of every remote the game fires used to be lowercased and scanned
-- against every pattern on each intercepted call. Remote names are few and
-- stable, so the lowercase + match result is memoised and only rebuilt when the
-- pattern list itself changes.
SilentAimHK.MatchCache = nil

function SilentAimHK.matchesRemote(name)
	local names = SilentAimHK.getRemoteNames()
	local cache = SilentAimHK.MatchCache
	if not cache or cache.names ~= names then
		cache = { names = names, hits = {} }
		SilentAimHK.MatchCache = cache
	end
	local hit = cache.hits[name]
	if hit == nil then
		local lower = string.lower(name)
		hit = false
		for i = 1, #names do
			if string.find(lower, names[i], 1, true) then
				hit = true
				break
			end
		end
		cache.hits[name] = hit
	end
	return hit
end

-- Picks the body part to aim at for a character, honouring the Target Part
-- setting. "Random" rolls the Headshot Chance so the aim wanders between the
-- head and the torso instead of always taking the same one.
function SilentAimHK.getTargetPart(character)
	local mode = (Options.SAHKTargetPart and Options.SAHKTargetPart.Value) or "Head"
	if mode == "Random" then
		local chance = (Options.SAHKHeadshotChance and Options.SAHKHeadshotChance.Value) or 100
		if math.random(1, 100) <= chance then
			return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
		end
		return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
	end
	return character:FindFirstChild(mode)
		or character:FindFirstChild("Head")
		or character:FindFirstChild("HumanoidRootPart")
end

-- True when nothing solid sits between the camera and the target. Cached for a
-- fraction of a second because the check is a raycast per player.
function SilentAimHK.isVisible(player, character)
	local now = tick()
	local entry = SilentAimHK.WallCache[player]
	if entry and entry.char == character and now - entry.t < 0.2 then
		return entry.visible
	end
	local camera = workspace.CurrentCamera
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local visible = false
	if camera and root then
		local origin = camera.CFrame.Position
		local direction = root.Position - origin
		SilentAimHK.RayParams.FilterDescendantsInstances = { character, LocalPlayer.Character }
		visible = direction.Magnitude <= 0 or workspace:Raycast(origin, direction, SilentAimHK.RayParams) == nil
	end
	SilentAimHK.WallCache[player] = { t = now, visible = visible, char = character }
	return visible
end

-- Prediction is built in rather than exposed as a slider; kept at 0 so no
-- velocity lead is applied for now.
function SilentAimHK.predict(part)
	if not part or not part.Parent then
		return part and part.Position or nil
	end
	local pos = part.Position
	local predTime = 0
	if predTime <= 0 then
		return pos
	end
	return pos + ((part.AssemblyLinearVelocity or Vector3.zero) * predTime)
end

-- Picks the target part every throttle tick. FOV Radius limits the search unless
-- 360 Mode is on; Priority Mode then decides which valid target wins.
function SilentAimHK.findTarget()
	local camera = workspace.CurrentCamera
	local character = getCharacter()
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not camera or not root then return nil end

	local threeSixty = (Toggles.SAHK360Mode and Toggles.SAHK360Mode.Value) or false
	local radius = (Options.SAHKFOVRadius and Options.SAHKFOVRadius.Value) or 100
	local range = (Options.SAHKTargetRange and Options.SAHKTargetRange.Value) or 500
	local wallCheck = (Toggles.SAHKWallCheck and Toggles.SAHKWallCheck.Value) or false
	local priority = (Options.SAHKPriorityMode and Options.SAHKPriorityMode.Value) or "Crosshair"

	local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	local bestPart, bestScore = nil, math.huge

	for _, otherPlayer in ipairs(TSG_PlayerList) do
		if otherPlayer ~= LocalPlayer and not isTeammate(otherPlayer) then
			local otherChar = otherPlayer.Character
			local humanoid = otherChar and otherChar:FindFirstChildOfClass("Humanoid")
			if otherChar and humanoid and humanoid.Health > 0 and not otherChar:FindFirstChildOfClass("ForceField") then
				local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
				if otherRoot then
					local worldDist = (otherRoot.Position - root.Position).Magnitude
					if worldDist <= range then
						local part = SilentAimHK.getTargetPart(otherChar)
						if part and part.Parent and (not wallCheck or SilentAimHK.isVisible(otherPlayer, otherChar)) then
							local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
							local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
							-- The FOV circle only constrains while 360 Mode is off.
							local inFOV = threeSixty or (onScreen and screenDist <= radius)
							if inFOV then
								local score
								if priority == "Distance" then
									score = worldDist
								elseif priority == "Health" then
									score = humanoid.Health
								else
									score = screenDist
								end
								if score < bestScore then
									bestPart, bestScore = part, score
								end
							end
						end
					end
				end
			end
		end
	end

	return bestPart
end

-- FOV ring, drawn with the executor's Drawing API (same as the box ESP). If the
-- executor has no Drawing it is simply skipped.
function SilentAimHK.drawRing(visible, radius, camera)
	if visible and not SilentAimHK.Ring and not SilentAimHK.RingUnsupported then
		if typeof(Drawing) == "table" and typeof(Drawing.new) == "function" then
			pcall(function()
				local circle = Drawing.new("Circle")
				circle.Thickness = 1
				circle.NumSides = 60
				circle.Filled = false
				circle.Transparency = 1
				circle.Color = Color3.fromRGB(255, 255, 255)
				circle.Visible = false
				SilentAimHK.Ring = circle
				-- Reuse the global the unload handler already removes.
				fovCircle = circle
			end)
		else
			SilentAimHK.RingUnsupported = true
		end
	end
	local circle = SilentAimHK.Ring
	if circle then
		circle.Visible = visible and true or false
		if visible then
			-- The radius is eased toward this target by stepRing, so dragging the FOV
			-- Radius slider grows / shrinks the circle smoothly instead of snapping.
			-- On first show there is no current radius yet, so it starts at size.
			SilentAimHK.RingTargetRadius = math.max(1, radius)
			if not SilentAimHK.RingRadius then
				SilentAimHK.RingRadius = SilentAimHK.RingTargetRadius
			end
			circle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
		end
	end
end

-- Eases the FOV ring toward its target radius. Framerate independent (exponential
-- approach), so resizing looks the same at any FPS.
function SilentAimHK.stepRing(dt)
	local circle = SilentAimHK.Ring
	if not circle or not circle.Visible then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	local target = SilentAimHK.RingTargetRadius or 0
	local current = SilentAimHK.RingRadius or target
	local alpha = 1 - math.exp(-14 * (dt or 0))
	current = current + (target - current) * alpha
	if math.abs(target - current) < 0.5 then
		current = target
	end
	SilentAimHK.RingRadius = current
	circle.Radius = math.max(1, current)
	circle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
end

-- The FOV ring can be hidden from the menu while the FOV Radius limit keeps
-- working behind the scenes.
function SilentAimHK.showRing()
	return (Toggles.SAHKShowRing and Toggles.SAHKShowRing.Value) or false
end

function SilentAimHK.update()
	local camera = workspace.CurrentCamera
	if not isAlive() then
		SilentAimHK.Target = nil
		SilentAimHK.drawRing(false, 0, camera)
		return
	end
	local radius = (Options.SAHKFOVRadius and Options.SAHKFOVRadius.Value) or 100
	-- The ring only shows while silent aim is actually active, so with the Slot
	-- System on it appears with the chosen weapon and hides for every other tool.
	SilentAimHK.drawRing(SilentAimHK.isEnabled() and SilentAimHK.showRing(), radius, camera)
	SilentAimHK.Target = SilentAimHK.findTarget()
end

-- Rebuilds a {X=,Y=,Z=} table with the supplied vector, keeping any extra keys.
function SilentAimHK.makeVecTable(template, newVec)
	local copied = table.clone(template)
	for key in pairs(copied) do
		local lower = type(key) == "string" and string.lower(key) or key
		if lower == "x" then
			copied[key] = newVec.X
		elseif lower == "y" then
			copied[key] = newVec.Y
		elseif lower == "z" then
			copied[key] = newVec.Z
		end
	end
	return copied
end

-- How far in front of the target a teleported origin sits. Scaled to the target
-- part so the projectile never spawns inside the target's own hitbox, which
-- would make the game register the shot as starting past the target.
function SilentAimHK.teleportClearance(hitPart)
	if hitPart and hitPart.Parent then
		return (hitPart.Size.Magnitude * 0.5) + 3
	end
	return 5
end

-- Rewrites a single value the game passed to a ray/remote so it points at the
-- target. keyHint is the lowercase argument/field name it sat under.
function SilentAimHK.rewriteValue(val, keyHint, targetPos, hitPart, bulletTeleport)
	local t = typeof(val)
	local clearance = bulletTeleport and SilentAimHK.teleportClearance(hitPart) or 0
	if t == "Vector3" then
		if SilentAimHK.V3_DIR[keyHint] then
			return (targetPos - val).Unit
		elseif SilentAimHK.V3_ORG[keyHint] then
			if bulletTeleport then
				return targetPos - ((targetPos - val).Unit * clearance)
			end
			return val
		elseif SilentAimHK.V3_HIT[keyHint] then
			return targetPos
		end
		return val
	elseif t == "CFrame" then
		if SilentAimHK.CF_ORG[keyHint] then
			if bulletTeleport then
				return CFrame.new(targetPos - ((targetPos - val.Position).Unit * clearance))
			end
			return val
		end
		return CFrame.lookAt(val.Position, targetPos)
	elseif t == "Ray" then
		local origin = val.Origin
		if bulletTeleport then
			origin = targetPos - ((targetPos - origin).Unit * clearance)
		end
		return Ray.new(origin, (targetPos - origin).Unit * 1000)
	elseif t == "table" then
		local isVec = (val.X ~= nil or val.x ~= nil)
			and (val.Y ~= nil or val.y ~= nil)
			and (val.Z ~= nil or val.z ~= nil)
		if isVec then
			local vec = Vector3.new(val.X or val.x, val.Y or val.y, val.Z or val.z)
			if SilentAimHK.TV_HIT[keyHint] then
				return SilentAimHK.makeVecTable(val, targetPos)
			elseif SilentAimHK.TV_DIR[keyHint] then
				return SilentAimHK.makeVecTable(val, (targetPos - vec).Unit)
			elseif SilentAimHK.TV_ORG[keyHint] then
				if bulletTeleport then
					return SilentAimHK.makeVecTable(val, targetPos - ((targetPos - vec).Unit * clearance))
				end
				return val
			end
			return val
		end
		local rebuilt = {}
		local hasDirection, hasHitPosition, hasHitPart = false, false, false
		for key, value in pairs(val) do
			local lower = type(key) == "string" and string.lower(key) or key
			rebuilt[key] = SilentAimHK.rewriteValue(value, lower, targetPos, hitPart, bulletTeleport)
			if SilentAimHK.TV_DIR[lower] then
				if SilentAimHK.KEY_DIR2[lower] then
					hasDirection = true
				end
			elseif SilentAimHK.TV_HIT[lower] then
				hasHitPosition = true
			elseif lower == "hitpart" or lower == "target" then
				hasHitPart = true
			end
		end
		-- A bare direction is not enough for most games, so a hit position (and
		-- usually a hit part) is attached alongside it.
		if hasDirection then
			if not hasHitPosition then rebuilt["hitPosition"] = targetPos end
			if not hasHitPart then rebuilt["hitPart"] = hitPart end
		end
		return rebuilt
	end
	return val
end

-- The __namecall wrapper. The shared dispatcher calls it as
-- handler(previous, ...) and only registers it while silent aim is armed, so it
-- does not cost anything at all while the feature is off.
function SilentAimHK.Namecall(original, ...)
	if not original then return end
	if not SilentAimHK.isEnabled() then
		return original(...)
	end

	local method = getnamecallmethod()
	if method ~= "Raycast" and method ~= "FireServer" and method ~= "InvokeServer" then
		return original(...)
	end
	-- Only the game's own calls are rewritten; anything this script fires
	-- (melee remotes, its own raycasts...) is left exactly as it is.
	if checkcaller() then
		return original(...)
	end

	local methods = SilentAimHK.getAimMethods()
	local isRay = (method == "Raycast")
	if isRay then
		if not methods.ray then return original(...) end
	else
		if method == "FireServer" then
			if not methods.fire then return original(...) end
		elseif not methods.invoke then
			return original(...)
		end
		local remote = ...
		if typeof(remote) ~= "Instance" then return original(...) end
		local class = remote.ClassName
		if class ~= "RemoteEvent" and class ~= "RemoteFunction" and class ~= "UnreliableRemoteEvent" then
			return original(...)
		end
		if not SilentAimHK.matchesRemote(remote.Name) then return original(...) end
	end

	-- Hit Chance is rolled per call: a miss just lets the original call through.
	local chance = (Options.SAHKHitChance and Options.SAHKHitChance.Value) or 100
	if chance <= 0 or (chance < 100 and math.random(1, 100) > chance) then
		return original(...)
	end

	local hitPart = SilentAimHK.Target
	if not hitPart or not hitPart.Parent then return original(...) end
	local targetPos = SilentAimHK.predict(hitPart)
	if not targetPos then return original(...) end

	local wallBang = (Toggles.SAHKWallBang and Toggles.SAHKWallBang.Value) or false
	local bulletTeleport = (Toggles.SAHKBulletTeleport and Toggles.SAHKBulletTeleport.Value) or false

	if isRay then
		local raySelf, origin, direction = ...
		if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
			return original(...)
		end
		local toTarget = targetPos - origin
		-- While the player is in the water the game drives its swim / buoyancy /
		-- terrain state with these very same Raycast calls, so returning the
		-- spoofed hit there is what makes the water act strange (walking on the
		-- seabed, random flings). The fake hit is therefore skipped in water.
		-- SilentAimHK.InWater is a cached sample, so no engine call is made from
		-- inside the hook. The direction rewrite below still runs, so silent aim
		-- is unaffected.
		if wallBang and SilentAimHK.shotWindowOpen() and not SilentAimHK.InWater then
			-- Pretend the ray already hit the target so wall checks pass. Only
			-- done during the player's own shot so the game's terrain /
			-- movement raycasts keep their real results.
			local dist = toTarget.Magnitude
			return {
				Instance = hitPart,
				Position = targetPos,
				-- Guard the zero-distance case so the normal is never NaN.
				Normal = dist > 0.001 and toTarget.Unit or -direction.Unit,
				Material = hitPart.Material,
				Distance = dist,
			}
		end
		-- A hitscan ray has no travel time to remove, and moving its origin next
		-- to the target makes the game's own Raycast start inside the target and
		-- register a miss, so Bullet Teleport leaves the origin alone here.
		return original(raySelf, origin, toTarget.Unit * direction.Magnitude, select(4, ...))
	end

	local args = table.pack(...)
	local count = args.n
	for i = 1, count do
		local arg = args[i]
		local argType = typeof(arg)
		if argType == "table" then
			args[i] = SilentAimHK.rewriteValue(arg, nil, targetPos, hitPart, bulletTeleport)
		elseif argType == "Vector3" or argType == "CFrame" or argType == "Ray" then
			args[i] = SilentAimHK.rewriteValue(arg, "direction", targetPos, hitPart, bulletTeleport)
		end
	end

	if wallBang and SilentAimHK.shotWindowOpen() then
		for i = 1, count do
			local arg = args[i]
			if type(arg) == "table" then
				for key in pairs(arg) do
					local lower = type(key) == "string" and string.lower(key) or key
					if SilentAimHK.WB_KEYS[lower] then
						arg[key] = true
					end
				end
			end
		end
	end

	return original(table.unpack(args, 1, count))
end

-- Optional Mouse.Hit interception. Only installed while "Mouse.Hit" is one of
-- the chosen Aim Methods, because an __index hook on game runs for every
-- property read the game's scripts make.
function SilentAimHK.mouseIndex(original, self, key)
	if not SilentAimHK.MouseKeys[key] or self ~= SilentAimHK.CachedMouse then
		return original(self, key)
	end
	if not SilentAimHK.isEnabled() or (checkcaller and checkcaller()) then
		return original(self, key)
	end
	-- Only rewrite the mouse while a weapon is in hand. The build system reads
	-- Mouse.Target / Mouse.UnitRay to place its preview, so hijacking those while
	-- a build tool is out would snap the preview onto the aim target instead of
	-- following the cursor.
	if not SilentAimHK.HeldWeapon then
		return original(self, key)
	end
	local part = SilentAimHK.Target
	if not part or not part.Parent then
		return original(self, key)
	end
	if key == "Target" then
		return part
	elseif key == "TargetFilter" then
		return nil
	end
	local camera = workspace.CurrentCamera
	if not camera then return original(self, key) end
	local pos = SilentAimHK.predict(part)
	if not pos then return original(self, key) end
	if key == "X" or key == "Y" then
		local screen = camera:WorldToViewportPoint(pos)
		if key == "X" then return screen.X end
		return screen.Y
	end
	local origin = camera.CFrame.Position
	local direction = pos - origin
	if direction.Magnitude < 0.001 then
		return original(self, key)
	end
	if key == "Hit" then
		return CFrame.lookAt(pos, pos + direction.Unit)
	end
	return Ray.new(origin, direction.Unit * (direction.Magnitude + 5))
end

function SilentAimHK.installMouseHook()
	if SilentAimHK.MouseHook or not SilentAimHK.Supported or not hookmetamethod then return end
	local mouse = LocalPlayer:GetMouse()
	if not mouse then return end
	SilentAimHK.CachedMouse = mouse
	local previous
	local ok = pcall(function()
		previous = hookmetamethod(game, "__index", function(self, key)
			return SilentAimHK.mouseIndex(previous, self, key)
		end)
	end)
	if ok then
		SilentAimHK.MouseHook = previous
	end
end

function SilentAimHK.removeMouseHook()
	if not SilentAimHK.MouseHook then return end
	pcall(function()
		hookmetamethod(game, "__index", SilentAimHK.MouseHook)
	end)
	SilentAimHK.MouseHook = nil
	SilentAimHK.CachedMouse = nil
end

function SilentAimHK.syncMouseHook()
	-- Armed (not isEnabled) so the hook exists as soon as silent aim could run:
	-- mouseIndex itself returns the real value while the feature is not active,
	-- so installing it early is safe and it works the moment a slot tool is out.
	if SilentAimHK.armed() and SilentAimHK.getAimMethods().mouse then
		SilentAimHK.installMouseHook()
	else
		SilentAimHK.removeMouseHook()
	end
end

-- Remote scanner behind the "Scan Remotes" button.
function SilentAimHK.scanRemotes()
	local names = SilentAimHK.getRemoteNames()
	local found = {}
	local function search(parent)
		if not parent then return end
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("UnreliableRemoteEvent") then
				local lower = string.lower(child.Name)
				for _, pattern in ipairs(names) do
					if string.find(lower, pattern, 1, true) then
						found[child.Name] = true
						break
					end
				end
			end
			if child:IsA("Folder") or child:IsA("Model") then
				search(child)
			end
		end
	end
	search(ReplicatedStorage)
	search(workspace)
	local list = {}
	for name in pairs(found) do
		table.insert(list, name)
	end
	table.sort(list)
	SilentAimHK.DetectedRemotes = list
	return list
end

-- The wrapper is registered with the shared dispatcher from SilentAimHK.sync()
-- only while silent aim is armed, so nothing is installed at load.
if not (hookmetamethod and getnamecallmethod and checkcaller) then
	warn("[URIEL]: Silent Aim needs hookmetamethod, getnamecallmethod and checkcaller")
end

-- Open the WallBang window on the player's own attack (mouse click or tool
-- activated). Only the WallBang fake result / wall flags depend on this window,
-- so normal silent aim keeps behaving exactly as it did.
track("SilentAimHKShotInput", UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not SilentAimHK.isEnabled() then return end
	local inputType = input.UserInputType
	if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
		SilentAimHK.markShot()
	end
end))
if LocalPlayer.Character then
	SilentAimHK.hookShotChar(LocalPlayer.Character)
end
track("SilentAimHKShotCharAdded", LocalPlayer.CharacterAdded:Connect(function(char)
	SilentAimHK.hookShotChar(char)
end))

-- Connects / disconnects the silent aim loop. Runs whenever either thing that
-- can arm silent aim flips: the main toggle, or the Slot System (which arms it
-- by itself). Sharing one path keeps the loop running only while silent aim
-- could actually do something.
function SilentAimHK.sync()
	local armed = SilentAimHK.armed()
	if armed == SilentAimHK.connected then return end
	SilentAimHK.connected = armed
	-- The __namecall wrapper only exists while silent aim is armed. Registering
	-- it here (and removing it below) is what keeps the game's metamethod
	-- untouched the rest of the time.
	if armed then
		if SilentAimHK.Supported then
			TSG_AddNamecallHook(SilentAimHK.Namecall)
		end
	else
		TSG_RemoveNamecallHook(SilentAimHK.Namecall)
	end
	disconnect("SilentAimHKLoop")
	disconnect("SilentAimHKAnim")
	SilentAimHK.syncMouseHook()
	if armed then
		-- Sample the slot flag now (safe here: this runs on the UI thread, not
		-- inside the hook) so silent aim can't be briefly active before the
		-- heartbeat loop's first tick.
		SilentAimHK.SlotAllowed = (not (Toggles.SAHKSlotSystem and Toggles.SAHKSlotSystem.Value))
			or isAdvanceSlotAllowed(Options.SAHKSlotSystemSlot)
		SilentAimHK.Accum = 0
		SilentAimHK.Target = nil
		-- Draw the ring immediately so it never trails a throttled update.
		SilentAimHK.drawRing(SilentAimHK.showRing(), (Options.SAHKFOVRadius and Options.SAHKFOVRadius.Value) or 100, workspace.CurrentCamera)
		-- Unthrottled loop that eases the ring to a new size, so dragging the FOV
		-- Radius slider animates instead of snapping.
		track("SilentAimHKAnim", RunService.RenderStepped:Connect(function(dt)
			SilentAimHK.stepRing(dt)
		end))
		track("SilentAimHKLoop", RunService.Heartbeat:Connect(function(dt)
			-- Refresh the WallBang water sample here, off the hook's stack, so the
			-- intercept itself never triggers another engine call.
			if Toggles.SAHKWallBang and Toggles.SAHKWallBang.Value then
				SilentAimHK.InWater = isInWater()
			end
			-- Same idea for the mouse guard: keep the "weapon in hand" sample up to
			-- date here so the mouse interception below never has to do item-data
			-- lookups while the game is reading Mouse.Target.
			SilentAimHK.HeldWeapon = IsHoldingWeapon()
			-- Slot System sample, also refreshed off the hook's stack. With the
			-- Slot System off this is simply true, so silent aim is unrestricted.
			SilentAimHK.SlotAllowed = (not (Toggles.SAHKSlotSystem and Toggles.SAHKSlotSystem.Value))
				or isAdvanceSlotAllowed(Options.SAHKSlotSystemSlot)
			local responsiveness = (Options.SAHKResponsiveness and Options.SAHKResponsiveness.Value) or 0.5
			SilentAimHK.Accum = SilentAimHK.Accum + (dt or 0)
			if SilentAimHK.Accum < responsiveness then return end
			SilentAimHK.Accum = 0
			SilentAimHK.update()
		end))
		Library:Notify({ Title = "Silent Aim", Description = "Enabled", Time = 2 })
	else
		SilentAimHK.Target = nil
		SilentAimHK.drawRing(false, 0, workspace.CurrentCamera)
		Library:Notify({ Title = "Silent Aim", Description = "Disabled", Time = 2 })
	end
end

Toggles.SilentAimHK:OnChanged(function()
	SilentAimHK.sync()
end)

-- The Slot System arms / disarms silent aim by itself, so it drives the same path.
Toggles.SAHKSlotSystem:OnChanged(function()
	SilentAimHK.sync()
end)

-- Show / hide the ring the moment the checkbox is toggled.
Toggles.SAHKShowRing:OnChanged(function()
	if SilentAimHK.armed() then
		local radius = (Options.SAHKFOVRadius and Options.SAHKFOVRadius.Value) or 100
		SilentAimHK.drawRing(Toggles.SAHKShowRing.Value and true or false, radius, workspace.CurrentCamera)
	end
end)

-- The mouse hook only needs to exist while "Mouse.Hit" is selected.
Options.SAHKAimMethods:OnChanged(function()
	SilentAimHK.syncMouseHook()
end)

-- Push the new radius to the ring the moment the slider moves, so the smooth
-- resize starts right away instead of waiting for the next throttled update.
Options.SAHKFOVRadius:OnChanged(function()
	if SilentAimHK.armed() and SilentAimHK.showRing() then
		SilentAimHK.drawRing(true, Options.SAHKFOVRadius.Value or 100, workspace.CurrentCamera)
	end
end)

