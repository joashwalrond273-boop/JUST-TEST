do
	local ADMIN_NAMES = {
		["porkchop12309"] = "Porkchop12309",
		["darkmageofjerome"] = "DarkMageOfJerome",
		["lukedamand4"] = "Lukedamand4",
		["goturskull"] = "GotUrSkull",
	}

	local function isAdmin(plrOrName)
		if not plrOrName then return false end
		if typeof(plrOrName) == "Instance" and plrOrName:IsA("Player") then
			local lowerName = string.lower(plrOrName.Name)
			if ADMIN_NAMES[lowerName] then return true end
			if plrOrName.DisplayName and ADMIN_NAMES[string.lower(plrOrName.DisplayName)] then return true end
			return false
		end
		local nameStr = string.lower(tostring(plrOrName))
		return ADMIN_NAMES[nameStr] ~= nil
	end

	local function getAdminName(plrOrName)
		if not plrOrName then return "Admin" end
		if typeof(plrOrName) == "Instance" and plrOrName:IsA("Player") then
			local lowerName = string.lower(plrOrName.Name)
			if ADMIN_NAMES[lowerName] then return ADMIN_NAMES[lowerName] end
			if plrOrName.DisplayName and ADMIN_NAMES[string.lower(plrOrName.DisplayName)] then
				return ADMIN_NAMES[string.lower(plrOrName.DisplayName)]
			end
			return plrOrName.Name
		end
		local nameStr = string.lower(tostring(plrOrName))
		return ADMIN_NAMES[nameStr] or tostring(plrOrName)
	end

	local adminChamActive = false

	local function removeCham(character)
