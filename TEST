-- Hit effect: a short-lived cosmetic burst where the melee hit landed.
-- Declared as a global on purpose (the main chunk is at Luau's 200-local limit).
Xeno_PlayHitEffect = function(hitArgs)
	pcall(function()
		local selected = Options.HitEffectSelect and Options.HitEffectSelect.Value
		if not selected or selected == "None" then return end

		-- Cap the spawn rate so a fast kill-aura can't pile up effect folders.
		local now = tick()
		if now - (XenoHitEffectLast or 0) < 0.08 then return end
		XenoHitEffectLast = now

		local character = getCharacter()
		local selfRoot = character and character:FindFirstChild("HumanoidRootPart")

		-- Find where the hit landed. Player hits carry the target (a Player or a
		-- character model) as the second argument; otherwise fall back to the
		-- nearest other player, then to the local character. Keep the target's
		-- body part so effects like Fire can cling to it.
		local position
		local targetRoot
		local arg = hitArgs and hitArgs[2]
		if typeof(arg) == "Instance" then
			local char = arg
			if arg:IsA("Player") then
				char = arg.Character
			end
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
					or char.PrimaryPart
					or char:FindFirstChildWhichIsA("BasePart")
				if root then
					position = root.Position
					targetRoot = root
				end
			end
		end

		if not position and selfRoot then
			local closest, closestDist
			for _, p in ipairs(AimlockPlayers or TSG_PlayerList) do
				if p ~= LocalPlayer and p.Character then
					local r = p.Character:FindFirstChild("HumanoidRootPart")
					if r then
						local dist = (r.Position - selfRoot.Position).Magnitude
						if dist <= 30 and (not closestDist or dist < closestDist) then
							closest, closestDist = r, dist
						end
					end
				end
			end
			if closest then
				position = closest.Position
				targetRoot = closest
			else
				position = selfRoot.Position
				targetRoot = selfRoot
			end
		end

		if not position then return end

		local fxFolder = Instance.new("Folder")
		fxFolder.Name = "XenoHitFX"
		fxFolder.Parent = workspace

		local anchor = Instance.new("Part")
		anchor.Name = "XenoFXAnchor"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.CastShadow = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(0.1, 0.1, 0.1)
		anchor.CFrame = CFrame.new(position)
		anchor.Parent = fxFolder

		local emitters = {}
		local extras = {}
		local function addEmitter(parent, props)
			local pe = Instance.new("ParticleEmitter")
			for key, value in pairs(props) do
				pe[key] = value
			end
			pe.Parent = parent or anchor
			table.insert(emitters, pe)
			return pe
		end

		-- emitWindow = how long particles keep spawning; totalLife = cleanup time.
		local emitWindow = 0.25
		local totalLife = 1.6

		if selected == "Lightning" then
			emitWindow = 0.2
			totalLife = 0.7

			local flash = Instance.new("PointLight")
			flash.Color = Color3.fromRGB(180, 220, 255)
			flash.Range = 24
			flash.Brightness = 4
			flash.Parent = anchor

			addEmitter(anchor, {
				Texture = "rbxasset://textures/particles/sparkles_main.dds",
				Color = ColorSequence.new(Color3.fromRGB(200, 230, 255)),
				Size = NumberSequence.new(1.4),
				Transparency = NumberSequence.new(0.1),
				Lifetime = NumberRange.new(0.3),
				Rate = 70,
				Speed = NumberRange.new(8, 16),
				SpreadAngle = Vector2.new(180, 180),
				LightEmission = 1,
			})

			-- Jagged bolt drawn from above the target down onto it.
			local points = { position + Vector3.new(0, 9, 0) }
			local segments = 6
			for i = 1, segments - 1 do
				local t = i / segments
				local base = position + Vector3.new(0, 9, 0) * (1 - t)
				local jitter = (1 - t) * 2.2
				points[#points + 1] = base + Vector3.new(
					(math.random() - 0.5) * jitter,
					0,
					(math.random() - 0.5) * jitter
				)
			end
			points[#points + 1] = position + Vector3.new(0, 1, 0)

			for i = 1, #points - 1 do
				local fromPos = points[i]
				local toPos = points[i + 1]
				local delta = toPos - fromPos
				local bolt = Instance.new("Part")
				bolt.Anchored = true
				bolt.CanCollide = false
				bolt.CanQuery = false
				bolt.CastShadow = false
				bolt.Material = Enum.Material.Neon
				bolt.Color = Color3.fromRGB(170, 220, 255)
				bolt.Size = Vector3.new(0.2, 0.2, delta.Magnitude)
				bolt.CFrame = CFrame.lookAt(fromPos + delta * 0.5, toPos)
				bolt.Parent = fxFolder
			end
		elseif selected == "Smoke" then
			emitWindow = 0.6
			totalLife = 2.6
			addEmitter(anchor, {
				Texture = "rbxasset://textures/particles/smoke_main.dds",
				Color = ColorSequence.new(Color3.fromRGB(80, 80, 80), Color3.fromRGB(190, 190, 190)),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 2.5),
					NumberSequenceKeypoint.new(1, 10),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = NumberRange.new(1.4, 1.9),
				Rate = 50,
				Speed = NumberRange.new(3, 7),
				SpreadAngle = Vector2.new(40, 40),
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-60, 60),
			})
		elseif selected == "Fire" then
			-- Big flames that cling to the target's body for ~1 second.
			emitWindow = 1
			totalLife = 1.4
			local attach = (targetRoot and targetRoot.Parent) and targetRoot or anchor

			local burn = Instance.new("PointLight")
			burn.Color = Color3.fromRGB(255, 140, 40)
			burn.Range = 18
			burn.Brightness = 2.5
			burn.Parent = attach
			table.insert(extras, burn)

			addEmitter(attach, {
				Texture = "rbxasset://textures/particles/fire_main.dds",
				Color = ColorSequence.new(Color3.fromRGB(255, 210, 80), Color3.fromRGB(255, 60, 0)),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 5),
					NumberSequenceKeypoint.new(1, 1.5),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.15),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = NumberRange.new(0.6, 1),
				Rate = 90,
				Speed = NumberRange.new(5, 9),
				SpreadAngle = Vector2.new(30, 30),
				LightEmission = 0.8,
			})
		elseif selected == "Explosion" then
			emitWindow = 0.15
			totalLife = 1.5

			local flash = Instance.new("PointLight")
			flash.Color = Color3.fromRGB(255, 170, 60)
			flash.Range = 32
			flash.Brightness = 5
			flash.Parent = anchor
			task.delay(0.2, function()
				if flash.Parent then flash:Destroy() end
			end)

			addEmitter(anchor, {
				Texture = "rbxasset://textures/particles/fire_main.dds",
