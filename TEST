local espObjects = {}
-- Cached list of the other players, so the per-frame ESP loop never rebuilds it.
-- Refreshed only when someone joins or leaves.
-- Kept global on purpose: the main chunk is at Luau's 200-local register limit.
espPlayerList = {}
function refreshESPPlayerList()
	local list = {}
	for _, p in ipairs(TSG_PlayerList) do
		if p ~= LocalPlayer then
			table.insert(list, p)
		end
	end
	espPlayerList = list
end
local espFolder = nil

local function getESPFolder()
	if espFolder and espFolder.Parent then
		return espFolder
	end
	pcall(function()
		local safeParent = nil
		if typeof(gethui) == "function" then
			safeParent = gethui()
		elseif typeof(CoreGui) == "Instance" then
			safeParent = CoreGui
		else
			safeParent = workspace
		end
		espFolder = Instance.new("Folder")
		espFolder.Name = "TSG_PlayerESP_Folder"
		espFolder.Parent = safeParent
	end)
	return espFolder or workspace
end

local function removePlayerESP(player)
	local entry = espObjects[player]
	if entry then
		if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
		if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
		if entry.box then pcall(function() entry.box:Destroy() end) end
		if entry.charCon then pcall(function() entry.charCon:Disconnect() end) end
		espObjects[player] = nil
	end
end

local function clearESP()
	for player in pairs(espObjects) do
		removePlayerESP(player)
	end
	table.clear(espObjects)
	if espFolder then
		pcall(function() espFolder:ClearAllChildren() end)
	end
end

-- Box ESP uses the executor's Drawing API: no Instances and rendered in C++,
-- so it stays extremely cheap even with many players on screen.
local hasDrawing = (typeof(Drawing) == "table" and typeof(Drawing.new) == "function")

local function createBoxDrawing()
	if not hasDrawing then return nil end
	local box
	local ok = pcall(function()
		box = Drawing.new("Square")
		box.Thickness = 1
		box.Filled = false
		box.Transparency = 1
		box.Visible = false
		box.Color = (Options and Options.BoxESPColor and Options.BoxESPColor.Value) or Color3.fromRGB(255, 255, 255)
	end)
	if ok then return box end
	return nil
end

local function getOrCreateESP(player)
	if player == LocalPlayer then return nil end
	local entry = espObjects[player]
	local character = player.Character

	-- Fast path: an entry stays valid for as long as the same character is
	-- alive, so the FindFirstChild lookups below only run on spawn/respawn
	-- instead of on every ESP update.
	if entry and entry.character == character and entry.root and entry.root.Parent then
		return entry
	end

	if not character then
		if entry then
			if entry.billboard then entry.billboard.Enabled = false end
			if entry.highlight then entry.highlight.Enabled = false end
			if entry.box then entry.box.Visible = false end
		end
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then
		if entry then
			if entry.billboard then entry.billboard.Enabled = false end
			if entry.highlight then entry.highlight.Enabled = false end
			if entry.box then entry.box.Visible = false end
		end
		return nil
	end

	if not entry or entry.character ~= character then
		if entry then
			if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
			if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
			if entry.box then pcall(function() entry.box:Destroy() end) end
		end

		local maxDist = (Options and Options.ESPDistance and Options.ESPDistance.Value) or 500
		local pColor = (Options and Options.PlayerESPColor and Options.PlayerESPColor.Value) or Color3.fromRGB(255, 255, 255)
		local dColor = (Options and Options.ShowDistanceColor and Options.ShowDistanceColor.Value) or Color3.fromRGB(255, 255, 255)
		local showDist = (Toggles and Toggles.ShowDistance and Toggles.ShowDistance.Value) or false
		local showHealth = (Toggles and Toggles.PlayerHealthBar and Toggles.PlayerHealthBar.Value) or false
		local showHpText = (Toggles and Toggles.ShowHealthText and Toggles.ShowHealthText.Value) or false
		local espMasterOn = (Toggles and Toggles.PlayerESP and Toggles.PlayerESP.Value) or false

		-- Ultra-lightweight native BillboardGui (0% Lua overhead, Engine C++ rendered)
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "TSG_Billboard"
		billboard.Size = UDim2.fromOffset(150, 48)
		billboard.StudsOffset = Vector3.new(0, 3.2, 0)
		billboard.AlwaysOnTop = true
		billboard.Adornee = root
		billboard.MaxDistance = maxDist
		billboard.Enabled = espMasterOn
		billboard.Parent = getESPFolder()

		local container = Instance.new("Frame")
		container.Name = "Container"
		container.BackgroundTransparency = 1
		container.Size = UDim2.fromScale(1, 1)
		container.Parent = billboard

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "NameLabel"
		nameLabel.Size = UDim2.new(1, 0, 0, 15)
		nameLabel.Position = UDim2.new(0, 0, 0, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.TextColor3 = pColor
		nameLabel.TextStrokeTransparency = 0.2
		nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 13
		nameLabel.Text = player.Name
		nameLabel.Parent = container

		local distLabel = Instance.new("TextLabel")
		distLabel.Name = "DistLabel"
		distLabel.Size = UDim2.new(1, 0, 0, 13)
		distLabel.Position = UDim2.new(0, 0, 0, 15)
		distLabel.BackgroundTransparency = 1
		distLabel.TextColor3 = dColor
		distLabel.TextStrokeTransparency = 0.3
		distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		distLabel.Font = Enum.Font.Gotham
		distLabel.TextSize = 11
		distLabel.Text = "0m"
		distLabel.Visible = showDist
		distLabel.Parent = container

		local healthBg = Instance.new("Frame")
		healthBg.Name = "HealthBg"
		healthBg.Size = UDim2.new(0, 60, 0, 3)
		healthBg.Position = UDim2.new(0.5, -30, 0, 30)
		healthBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		healthBg.BorderColor3 = Color3.fromRGB(0, 0, 0)
		healthBg.BorderSizePixel = 1
		healthBg.Visible = showHealth
		healthBg.Parent = container

		local healthFill = Instance.new("Frame")
		healthFill.Name = "HealthFill"
		healthFill.Size = UDim2.new(1, 0, 1, 0)
		healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		healthFill.BorderSizePixel = 0
		healthFill.Parent = healthBg

		local hpText = Instance.new("TextLabel")
		hpText.Name = "HPText"
		hpText.Size = UDim2.new(1, 0, 0, 10)
		hpText.Position = UDim2.new(0, 0, 0, 34)
		hpText.BackgroundTransparency = 1
		hpText.TextColor3 = Color3.fromRGB(0, 255, 120)
		hpText.TextStrokeTransparency = 0.3
		hpText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		hpText.Font = Enum.Font.GothamBold
		hpText.TextSize = 10
		hpText.Text = "100 HP"
		hpText.Visible = showHpText
		hpText.Parent = container

		-- Outline ESP is created lazily by the update loop, and only for players
		-- close enough to be worth the extra render pass.
		entry = {
			player = player,
			character = character,
			root = root,
			hum = hum,
			billboard = billboard,
			nameLabel = nameLabel,
			distLabel = distLabel,
			healthBg = healthBg,
			healthFill = healthFill,
			hpText = hpText,
			highlight = nil,
			lastDist = -1,
			lastHealth = -1,
		}
		espObjects[player] = entry
	else
		entry.root = root
		entry.hum = hum
		if entry.billboard and entry.billboard.Adornee ~= root then
			entry.billboard.Adornee = root
		end
		if entry.highlight and entry.highlight.Adornee ~= character then
			entry.highlight.Adornee = character
		end
	end

	return entry
end

local lastThrottledUpdate = 0
-- Global on purpose: the main chunk is already at Luau's 200-local register limit.
TSG_ESPUpdatePrev = 0

local function updateAllESP()
	if not Toggles.PlayerESP or not Toggles.PlayerESP.Value then return end

	local now = tick()
	-- The engine positions the BillboardGui itself, so the Lua side does not need
	-- to run every frame. ~20 Hz looks identical while cutting the per-frame Lua
	-- work (and the property writes it can trigger) by two thirds.
	if now - TSG_ESPUpdatePrev < 0.05 then return end
	TSG_ESPUpdatePrev = now

	local myRoot = getRootPart()
	local myPos = myRoot and myRoot.Position
	local shouldThrottle = (now - lastThrottledUpdate >= 0.1)

	if shouldThrottle then
		lastThrottledUpdate = now
	end

	local maxDist = (Options and Options.ESPDistance and Options.ESPDistance.Value) or 500
	local showDist = (Toggles and Toggles.ShowDistance and Toggles.ShowDistance.Value) or false
	local showHealth = (Toggles and Toggles.PlayerHealthBar and Toggles.PlayerHealthBar.Value) or false
	local showHpText = (Toggles and Toggles.ShowHealthText and Toggles.ShowHealthText.Value) or false
	local outlineEnabled = (Toggles.OutlineESP and Toggles.OutlineESP.Value) or false
	local boxEnabled = (Toggles and Toggles.BoxESP and Toggles.BoxESP.Value) or false

	for _, player in ipairs(espPlayerList) do
		if player ~= LocalPlayer then
			local entry = getOrCreateESP(player)
			if entry and entry.root and entry.hum and entry.hum.Health > 0 and entry.character.Parent then
				local dist = myPos and (entry.root.Position - myPos).Magnitude or 0
				local inRange = (dist <= maxDist)

				-- Native Billboard handles 3D position automatically via C++
				if entry.billboard.Enabled ~= inRange then
					entry.billboard.Enabled = inRange
				end

				-- Outline ESP draws through a Highlight instance, which forces an
				-- extra render pass per adorned character on mobile, so it is only
				-- built while the option is on and the player is close enough.
				local shouldHl = outlineEnabled and inRange and (dist <= 250)
				if shouldHl then
					if not entry.highlight then
						local hl = Instance.new("Highlight")
						hl.FillTransparency = 1
						hl.OutlineColor = (Options and Options.OutlineESPColor and Options.OutlineESPColor.Value) or Color3.fromRGB(255, 255, 255)
						hl.OutlineTransparency = 0
						-- Occluded instead of AlwaysOnTop: the outline now respects
						-- depth, so the engine skips the through-wall render pass
						-- that made this the heaviest GPU cost on mobile.
						hl.DepthMode = Enum.HighlightDepthMode.Occluded
						hl.Adornee = entry.character
						hl.Parent = getESPFolder()
						entry.highlight = hl
					end
					if not entry.highlight.Enabled then
						entry.highlight.Enabled = true
					end
				elseif entry.highlight and entry.highlight.Enabled then
					entry.highlight.Enabled = false
				end

				-- Box ESP: lightweight 2D bounding box drawn via the Drawing API
				if boxEnabled then
					if not entry.box then
						entry.box = createBoxDrawing()
					end
					local box = entry.box
					local camera = workspace.CurrentCamera
					if box then
						if camera and inRange then
							local top = camera:WorldToViewportPoint(entry.root.Position + Vector3.new(0, 3, 0))
							local bottom = camera:WorldToViewportPoint(entry.root.Position - Vector3.new(0, 3, 0))
							if top.Z > 0 and bottom.Z > 0 then
								local height = math.max(math.abs(bottom.Y - top.Y), 1)
								local width = height * 0.6
								box.Size = Vector2.new(width, height)
								box.Position = Vector2.new(top.X - width / 2, top.Y)
								box.Visible = true
							else
								box.Visible = false
							end
						else
							box.Visible = false
						end
					end
				elseif entry.box then
					entry.box.Visible = false
				end

				-- Throttled text and health updates (0 FPS drop)
				if inRange and shouldThrottle then
					if showDist then
						local roundedDist = math.floor(dist)
						if entry.lastDist ~= roundedDist then
							entry.lastDist = roundedDist
							entry.distLabel.Text = tostring(roundedDist) .. "m"
						end
						if not entry.distLabel.Visible then
							entry.distLabel.Visible = true
						end
					else
						if entry.distLabel.Visible then
							entry.distLabel.Visible = false
						end
					end

					if showHealth then
						local curHealth = entry.hum.Health
						if entry.lastHealth ~= curHealth then
							entry.lastHealth = curHealth
							local maxH = entry.hum.MaxHealth > 0 and entry.hum.MaxHealth or 100
							local pct = math.clamp(curHealth / maxH, 0, 1)
							entry.healthFill.Size = UDim2.new(pct, 0, 1, 0)
							entry.healthFill.BackgroundColor3 = Color3.fromHSV(pct * 0.33, 1, 1)
						end
						if not entry.healthBg.Visible then
							entry.healthBg.Visible = true
						end
					else
						if entry.healthBg.Visible then
							entry.healthBg.Visible = false
						end
					end

					if showHpText then
						local curHealth = math.floor(entry.hum.Health)
						local hpStr = tostring(curHealth) .. " HP"
						if entry.hpText.Text ~= hpStr then
							entry.hpText.Text = hpStr
						end
						if not entry.hpText.Visible then
							entry.hpText.Visible = true
						end
					else
						if entry.hpText.Visible then
							entry.hpText.Visible = false
						end
					end
				end
			else
				if entry and entry.billboard and entry.billboard.Enabled then entry.billboard.Enabled = false end
				if entry and entry.highlight and entry.highlight.Enabled then entry.highlight.Enabled = false end
				if entry and entry.box and entry.box.Visible then entry.box.Visible = false end
			end
		end
	end
end

Toggles.PlayerESP:OnChanged(function()
	if updatePlayerESPVisibility then
		updatePlayerESPVisibility()
	end
	disconnect("ESP_Loop")
	disconnect("ESP_PlayerAdded")
	disconnect("ESP_PlayerRemoving")
	if not Toggles.PlayerESP.Value then
		clearESP()
		return
	end

	refreshESPPlayerList()
	track("ESP_Loop", RunService.RenderStepped:Connect(updateAllESP))

	for _, player in ipairs(espPlayerList) do
		if player ~= LocalPlayer then
			local entry = espObjects[player] or {}
			if entry.charCon then entry.charCon:Disconnect() end
			entry.charCon = player.CharacterAdded:Connect(function()
				task.wait(0.2)
				if Toggles.PlayerESP and Toggles.PlayerESP.Value then
					getOrCreateESP(player)
				end
			end)
		end
	end

	track("ESP_PlayerAdded", Players.PlayerAdded:Connect(function(player)
		refreshESPPlayerList()
		player.CharacterAdded:Connect(function()
			task.wait(0.2)
			if Toggles.PlayerESP and Toggles.PlayerESP.Value then
				getOrCreateESP(player)
			end
		end)
	end))

	track("ESP_PlayerRemoving", Players.PlayerRemoving:Connect(function(player)
		refreshESPPlayerList()
		removePlayerESP(player)
	end))

	updateAllESP()
end)

-- ==========================================
-- Boss ESP (highlight + health bar on the live boss bodies)
-- Bosses are clones of ReplicatedStorage.game.AIModels and they only ever live
-- as direct children of workspace.AI_Server / workspace.AI_Client, so we hook
-- those two folders instead of rescanning the entire game. Attaching and
-- detaching is event driven, and the only recurring work is a throttled 5 Hz
-- pass that bails out immediately whenever no boss is tracked.
do
	local BOSS_MODELS = {
		"Arena Kraken Eye",
		"Arena Kraken Arm",
		"Marvin",
		"The Juggernaut",
		"The Titan",
		"The Samurai",
		"The Great Spider",
	}

	local bossESPs = {}
	local BOSS_HL_NAME = "URIEL_BossESP_Highlight"
	local BOSS_BB_NAME = "URIEL_BossESP_Billboard"
	local BOSS_MAX_DISTANCE = 500
	local bossLastRefresh = 0
	local bossLastUpdate = 0

	-- Substring match so a clone carrying a numeric suffix still counts.
	local function isBossName(name)
		if type(name) ~= "string" then return nil end
		for _, boss in ipairs(BOSS_MODELS) do
			if name == boss or string.find(name, boss, 1, true) then
				return boss
			end
		end
		return nil
	end

	local function bossHumanoid(inst)
		if inst and inst:IsA("Model") then
			return inst:FindFirstChildOfClass("Humanoid")
		end
		return nil
	end

	local function bossPart(inst)
		if not inst then return nil end
		if inst:IsA("BasePart") then return inst end
		return inst.PrimaryPart
			or inst:FindFirstChild("HumanoidRootPart")
			or inst:FindFirstChildWhichIsA("BasePart")
	end

	-- Lightweight BillboardGui health bar, same style as the player ESP.
	local function createBossHealthBar(part)
		local billboard = Instance.new("BillboardGui")
		billboard.Name = BOSS_BB_NAME
		billboard.Size = UDim2.fromOffset(100, 24)
		billboard.StudsOffset = Vector3.new(0, 3.2, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = BOSS_MAX_DISTANCE
		billboard.Adornee = part
		billboard.Parent = getESPFolder()

		local hpText = Instance.new("TextLabel")
		hpText.Name = "HPText"
		hpText.Size = UDim2.new(1, 0, 0, 12)
		hpText.Position = UDim2.new(0, 0, 0, 0)
		hpText.BackgroundTransparency = 1
		hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
		hpText.TextStrokeTransparency = 0.3
		hpText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		hpText.Font = Enum.Font.GothamBold
		hpText.TextSize = 11
		hpText.Text = ""
		hpText.Parent = billboard

		local healthBg = Instance.new("Frame")
		healthBg.Name = "HealthBg"
		healthBg.Size = UDim2.new(1, 0, 0, 5)
		healthBg.Position = UDim2.new(0, 0, 0, 14)
		healthBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		healthBg.BorderColor3 = Color3.fromRGB(0, 0, 0)
		healthBg.BorderSizePixel = 1
		healthBg.Parent = billboard

		local healthFill = Instance.new("Frame")
		healthFill.Name = "HealthFill"
		healthFill.Size = UDim2.new(1, 0, 1, 0)
		healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		healthFill.BorderSizePixel = 0
		healthFill.Parent = healthBg

		return billboard, healthFill, hpText
	end

	-- Redraw the bar only when the health value actually changed.
	local function updateBossBar(entry)
		local hum = entry.hum
		if not (hum and hum.Parent) then return end
		local curHealth = hum.Health
		if entry.lastHealth == curHealth then return end
		entry.lastHealth = curHealth
		local maxH = hum.MaxHealth > 0 and hum.MaxHealth or 100
		local pct = math.clamp(curHealth / maxH, 0, 1)
		entry.healthFill.Size = UDim2.new(pct, 0, 1, 0)
		entry.healthFill.BackgroundColor3 = Color3.fromHSV(pct * 0.33, 1, 1)
		entry.hpText.Text = tostring(math.floor(curHealth)) .. " HP"
	end

	local function detachBoss(inst)
		local entry = bossESPs[inst]
		if not entry then return end
		bossESPs[inst] = nil
		if entry.highlight then
			pcall(function() entry.highlight:Destroy() end)
		end
		if entry.billboard then
			pcall(function() entry.billboard:Destroy() end)
		end
	end

	local function clearBossESPs()
		for inst in pairs(bossESPs) do
			detachBoss(inst)
		end
	end

	local function attachBoss(inst)
		if bossESPs[inst] or not inst or not inst.Parent then return end
		if not isBossName(inst.Name) then return end

		local hl = Instance.new("Highlight")
		hl.Name = BOSS_HL_NAME
		hl.FillColor = Color3.fromRGB(255, 60, 60)
		hl.FillTransparency = 0.6
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.OutlineTransparency = 0
		-- Occluded instead of AlwaysOnTop: skips the through-wall render pass,
		-- which is the expensive part on mobile.
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Adornee = inst
		hl.Parent = getESPFolder()

		local entry = {
			highlight = hl,
			lastHealth = -1,
		}

		-- Bosses that are proper models carry a Humanoid, so they get a health
		-- bar too; plain part bosses only get the highlight.
		local hum = bossHumanoid(inst)
		local part = bossPart(inst)
		if hum and part then
			local billboard, healthFill, hpText = createBossHealthBar(part)
			entry.billboard = billboard
			entry.healthFill = healthFill
			entry.hpText = hpText
			entry.hum = hum
			entry.part = part
			updateBossBar(entry)
		end

		bossESPs[inst] = entry
	end

	local function onBossChildAdded(child)
		-- Defer so the clone has finished parenting before we read its parts.
		task.defer(function()
			if Toggles.BossHighlighter and Toggles.BossHighlighter.Value then
				attachBoss(child)
			end
		end)
	end

	local function onBossChildRemoved(child)
		detachBoss(child)
	end

	-- Only the two AI folders are hooked, and only once each, so this is cheap
	-- enough to re-check on a slow cadence in case the folders stream in late.
	local function refreshBossHooks()
		for _, folderName in ipairs({"AI_Server", "AI_Client"}) do
			local folder = workspace:FindFirstChild(folderName)
			if folder and not Connections["BossESP_Added_" .. folderName] then
				track("BossESP_Added_" .. folderName, folder.ChildAdded:Connect(onBossChildAdded))
				track("BossESP_Removed_" .. folderName, folder.ChildRemoved:Connect(onBossChildRemoved))
				-- One-time sweep of this folder's direct children only (tiny list).
				for _, child in ipairs(folder:GetChildren()) do
					attachBoss(child)
				end
			end
		end
	end

	local function updateBossESP()
		local now = tick()
		if now - bossLastRefresh >= 1 then
			bossLastRefresh = now
			refreshBossHooks()
		end

		-- Nothing tracked: one lookup and out. This is the usual case, so the
		-- per-frame cost while enabled but boss-free is effectively nil.
		if not next(bossESPs) then return end

		-- Throttle the visual updates to 5 Hz instead of every frame.
		if now - bossLastUpdate < 0.2 then return end
		bossLastUpdate = now

		local root = getRootPart()
		local myPos = root and root.Position

		for inst, entry in pairs(bossESPs) do
			local hum = entry.hum
			if (not inst.Parent) or (hum and hum.Health <= 0) then
				detachBoss(inst)
			else
				local part = entry.part
				if not (part and part.Parent) then
					part = bossPart(inst)
					entry.part = part
					if entry.billboard then entry.billboard.Adornee = part or inst end
				end

				-- Only show the boss while it is within range.
				local inRange = true
				if myPos and part then
					inRange = (part.Position - myPos).Magnitude <= BOSS_MAX_DISTANCE
				end

				entry.highlight.Enabled = inRange

				if entry.billboard then
					entry.billboard.Enabled = inRange
					if inRange then updateBossBar(entry) end
				end
			end
		end
	end

	Toggles.BossHighlighter:OnChanged(function()
		disconnect("BossESP_Loop")
		disconnect("BossESP_Added_AI_Server")
		disconnect("BossESP_Added_AI_Client")
		disconnect("BossESP_Removed_AI_Server")
		disconnect("BossESP_Removed_AI_Client")
		clearBossESPs()
		bossLastRefresh = 0
		bossLastUpdate = 0

		if not Toggles.BossHighlighter.Value then
			return
		end

		refreshBossHooks()
		track("BossESP_Loop", RunService.Heartbeat:Connect(updateBossESP))
	end)
end

