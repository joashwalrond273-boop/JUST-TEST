			getgenv().PingSpoofer = spoofer
		else
			spoofer.SpoofPing = state
		end

		-- Only wire the readout once; the handler checks SpoofPing each time so
		-- turning the checkbox off restores the real ping immediately.
		if state and not spoofer.Hooked then
			spoofer.Hooked = true
			pcall(function()
				for _, v in pairs(game.CoreGui.RobloxGui.PerformanceStats:GetChildren()) do
					if v.Name == "PS_Button" and v.StatsMiniTextPanelClass.TitleLabel.Text == "Ping" then
						local memory = v.StatsMiniTextPanelClass.ValueLabel
						memory:GetPropertyChangedSignal("Text"):Connect(function()
							local active = getgenv().PingSpoofer
							if active and active.SpoofPing then
								local random = math.random(active.StartOfPingSpoofer, active.EndOfPingSpoofer)
								memory.Text = (random * 1.23) .. " ms"
							end
						end)
					end
				end
			end)
		end

		Library:Notify({
			Title = "Ping Spoofer",
			Description = state and "Ping spoofing activated!" or "Ping spoofing disabled.",
			Time = 2,
		})
	end,
})

