do
	local shieldHudGui = nil
	local shieldHudLabel = nil
	local shieldHudCountLabel = nil
	local shieldHudStroke = nil
	local shieldHudRunning = false
	local shieldHudLastText = ""
	local shieldHudLastCount = ""

	-- Shield HUD 2.0: live state readout instead of a plain on/off light.
	--   BLOCKING        -> the block pose / setShield is currently held
	--   BREAK           -> the guard just broke (brief red flash)
	--   RECHARGING x.xs -> the game's shieldReload cooldown is still ticking
	--   READY           -> the shield is available again
	-- ShieldParryBreakUntil / ShieldAnimBreakUntil are the cooldown stamps the
	-- rest of the shield system already keeps, so the HUD just reads them.
	local function refreshShieldHud()
		if not shieldHudLabel then return end

		local now = tick()
		local shielded = ShieldAnimHeld or isShielding
		local breakUntil = math.max(ShieldParryBreakUntil or 0, ShieldAnimBreakUntil or 0)

		local text, color
		if shielded then
			text = "BLOCKING"
			color = Color3.fromRGB(0, 244, 255)
		elseif now < (ShieldBreakStamp or 0) + 0.3 then
			text = "BREAK"
			color = Color3.fromRGB(255, 70, 70)
		elseif now < breakUntil then
			text = string.format("RECHARGING %.1fs", breakUntil - now)
			color = Color3.fromRGB(255, 170, 0)
		else
			text = "READY"
			color = Color3.fromRGB(120, 255, 120)
		end

		if text ~= shieldHudLastText then
			shieldHudLastText = text
			shieldHudLabel.Text = text
			shieldHudLabel.TextColor3 = color
			if shieldHudStroke then
				shieldHudStroke.Color = color
			end
		end

		if shieldHudCountLabel then
			local countText = "BLOCKS " .. tostring(ShieldHudBlocks or 0)
			if countText ~= shieldHudLastCount then
				shieldHudLastCount = countText
				shieldHudCountLabel.Text = countText
			end
		end
	end

	local function buildShieldHud()
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if not playerGui then return end

		shieldHudGui = Instance.new("ScreenGui")
		shieldHudGui.Name = "XenoShieldHud"
		shieldHudGui.ResetOnSpawn = false
		shieldHudGui.IgnoreGuiInset = true
		shieldHudGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		shieldHudGui.Parent = playerGui

		local frame = Instance.new("Frame")
		frame.Name = "Panel"
		frame.Position = UDim2.new(0, 16, 0, 230)
		frame.Size = UDim2.new(0, 150, 0, 38)
		frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		frame.BackgroundTransparency = 0.25
		frame.BorderSizePixel = 0
		frame.Active = true
		frame.Parent = shieldHudGui

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = frame

		shieldHudStroke = Instance.new("UIStroke")
		shieldHudStroke.Color = Color3.fromRGB(0, 244, 255)
		shieldHudStroke.Transparency = 0.4
		shieldHudStroke.Thickness = 1
		shieldHudStroke.Parent = frame

		shieldHudLabel = Instance.new("TextLabel")
		shieldHudLabel.Size = UDim2.new(1, -12, 0, 18)
		shieldHudLabel.Position = UDim2.new(0, 6, 0, 3)
		shieldHudLabel.BackgroundTransparency = 1
		shieldHudLabel.Font = Enum.Font.Code
		shieldHudLabel.TextSize = 12
		shieldHudLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		shieldHudLabel.TextXAlignment = Enum.TextXAlignment.Left
		shieldHudLabel.Text = "READY"
		shieldHudLabel.Parent = frame

		shieldHudCountLabel = Instance.new("TextLabel")
		shieldHudCountLabel.Size = UDim2.new(1, -12, 0, 14)
		shieldHudCountLabel.Position = UDim2.new(0, 6, 0, 21)
		shieldHudCountLabel.BackgroundTransparency = 1
		shieldHudCountLabel.Font = Enum.Font.Code
		shieldHudCountLabel.TextSize = 10
		shieldHudCountLabel.TextColor3 = Color3.fromRGB(170, 170, 170)
		shieldHudCountLabel.TextXAlignment = Enum.TextXAlignment.Left
		shieldHudCountLabel.Text = "BLOCKS 0"
		shieldHudCountLabel.Parent = frame

		local dragging, dragStart, dragPos = false, nil, nil
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				dragPos = frame.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
		frame.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				frame.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + delta.X, dragPos.Y.Scale, dragPos.Y.Offset + delta.Y)
			end
		end)
	end

	Toggles.ShieldHud:OnChanged(function()
		shieldHudRunning = false
		disconnect("ShieldHud_Loop")

		if shieldHudGui then
			shieldHudGui:Destroy()
			shieldHudGui = nil
			shieldHudLabel = nil
			shieldHudCountLabel = nil
			shieldHudStroke = nil
		end
		shieldHudLastText = ""
		shieldHudLastCount = ""

		if not Toggles.ShieldHud.Value then
			Library:Notify({ Title = "Shield HUD", Description = "Disabled", Time = 2 })
			return
		end

		buildShieldHud()
		refreshShieldHud()
		shieldHudRunning = true

		track("ShieldHud_Loop", RunService.RenderStepped:Connect(function()
			if not shieldHudRunning or not shieldHudLabel then return end
			refreshShieldHud()
		end))

		Library:Notify({ Title = "Shield HUD", Description = "Enabled", Time = 2 })
	end)

end

-- Shield Notifier: raises a notification when the shield breaks (posture break /
-- refire) and again when it is back up. It only reads the same break stamps the
-- Shield HUD uses, so it works whether or not the Shield HUD is enabled.
Toggles.ShieldNotifier:OnChanged(function()
	disconnect("ShieldNotifier")
	local wasBroken = false

	if not Toggles.ShieldNotifier.Value then
		Library:Notify({ Title = "Shield Notifier", Description = "Disabled", Time = 2 })
		return
	end

	track("ShieldNotifier", RunService.Heartbeat:Connect(function()
		local now = tick()
