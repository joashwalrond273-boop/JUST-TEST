-- Meteor Alert: warns and resets the character when a meteor's landing point is
-- within 300 studs of us. The landing point streams in as an attribute shortly
-- after the event folder appears, so each new meteor is watched for a moment.
TSG_MeteorAlertSeen = {}

function TSG_CheckMeteorAlert(ev)
	if not (Toggles.MeteorAlert and Toggles.MeteorAlert.Value) then return end
	if typeof(ev) ~= "Instance" or not ev.Parent then return end
	if ev:GetAttribute("type") ~= "Meteor" then return end
	if TSG_MeteorAlertSeen[ev] then return end

	-- Ignore events that already landed; only warn about incoming meteors.
	local impactAt = ev:GetAttribute("ImpactAt")
	if typeof(impactAt) == "number" and impactAt < workspace:GetServerTimeNow() then return end

	local target = ev:GetAttribute("TargetCFrame")
	if typeof(target) ~= "CFrame" then return end
	local root = getRootPart()
	if not root then return end

	local dist = (root.Position - target.Position).Magnitude
	if dist > 300 then return end

	TSG_MeteorAlertSeen[ev] = true

	Library:Notify({
		Title = "Meteor Alert",
		Description = string.format("Meteor landing %.0f studs away - resetting!", dist),
		Time = 4,
	})

	local humanoid = getHumanoid()
	if humanoid and humanoid.Health > 0 then
		pcall(function()
			humanoid.Health = 0
		end)
	end
end

function TSG_WatchMeteorAlert(ev)
	-- Poll briefly so the alert still fires when TargetCFrame arrives late.
	for _ = 1, 10 do
		if not (Toggles.MeteorAlert and Toggles.MeteorAlert.Value) then return end
		if typeof(ev) ~= "Instance" or not ev.Parent then return end
		if TSG_MeteorAlertSeen[ev] then return end
		if typeof(ev:GetAttribute("TargetCFrame")) == "CFrame" then
			TSG_CheckMeteorAlert(ev)
			return
		end
		task.wait(0.3)
	end
end

Toggles.MeteorAlert:OnChanged(function()
	disconnect("MeteorAlert")
	TSG_MeteorAlertSeen = {}
	if not Toggles.MeteorAlert.Value then return end

	local active = ReplicatedStorage:WaitForChild("activeEvents", 10)
	if not active then
		Library:Notify({ Title = "Meteor Alert", Description = "activeEvents not found.", Time = 3 })
		Toggles.MeteorAlert:SetValue(false)
		return
	end

	for _, ev in ipairs(active:GetChildren()) do
		if ev:IsA("Folder") then
			task.spawn(TSG_WatchMeteorAlert, ev)
		end
	end

	track("MeteorAlert", active.ChildAdded:Connect(function(ev)
		if not ev:IsA("Folder") then return end
		task.spawn(TSG_WatchMeteorAlert, ev)
	end))
end)

