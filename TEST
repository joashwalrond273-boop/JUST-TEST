		local parts = {}
		if clone:IsA("BasePart") then
			table.insert(parts, clone)
		end
		for _, desc in ipairs(clone:GetDescendants()) do
			if desc:IsA("BasePart") then
				table.insert(parts, desc)
			end
		end
		return parts
	end

	-- Admin pieces that should glow. A BloomEffect in Lighting makes the
	-- light each piece emits bleed into a soft halo, so the whole outfit
	-- reads as glowing without changing its colours or material.
	local GLOW_ITEMS = {
		["Admin Helmet"] = true,
		["Admin Armor"] = true,
		["Admin Pants"] = true,
		["Admin Bag"] = true,
	}

	-- Every piece that currently glows, so the bloom can be switched back off
	-- once the last one is taken off instead of bleeding GPU on a full-screen
	-- post-process pass for the rest of the session.
	local glowParts = {}

	local function setBloomActive(active)
		local lighting = game:GetService("Lighting")
		local bloom = lighting:FindFirstChild("XenoGlowBloom")
		if active then
			if not bloom or not bloom:IsA("BloomEffect") then
				if bloom then bloom:Destroy() end
				bloom = Instance.new("BloomEffect")
				bloom.Name = "XenoGlowBloom"
				bloom.Intensity = 1.1
				bloom.Size = 20
				bloom.Threshold = 0.95
				bloom.Parent = lighting
			end
			bloom.Enabled = true
		elseif bloom then
			bloom:Destroy()
		end
	end

	-- Forget pieces that have been removed and match the bloom to what is
	-- actually worn right now.
	local function refreshGlowBloom()
		for part in pairs(glowParts) do
			if not part.Parent then
				glowParts[part] = nil
			end
		end
		setBloomActive(next(glowParts) ~= nil)
	end

	local function applyGlow(part)
		if not part:IsA("BasePart") then return end
		if part:GetAttribute("XenoGlow") then return end
		part:SetAttribute("XenoGlow", true)
		part.Material = Enum.Material.Neon
		glowParts[part] = true
		setBloomActive(true)
	end

	-- Hide the character's own hair (workspace.Characters.<name>.avatarHair)
	-- while the Admin Helmet is worn, so it doesn't poke through the helmet.
	local function findAvatarHair()
		local containers = {}
		local charFolder = workspace:FindFirstChild("Characters")
		if charFolder then
			local model = charFolder:FindFirstChild(LocalPlayer.Name)
			if model then table.insert(containers, model) end
		end
		local character = getCharacter()
		if character then table.insert(containers, character) end
		for _, container in ipairs(containers) do
			local hair = container:FindFirstChild("avatarHair")
			if hair then return hair end
		end
		return nil
	end

	local function syncAvatarHair()
		local hair = findAvatarHair()
		if not hair then return end
		local hidden = activeCosmetics["Admin Helmet"] ~= nil or activeCosmetics["Mod Helmet"] ~= nil

		local function applyPart(part)
			if hidden then
				if part:GetAttribute("XenoHairTransparency") == nil then
					part:SetAttribute("XenoHairTransparency", part.Transparency)
				end
				part.Transparency = 1
			else
				local original = part:GetAttribute("XenoHairTransparency")
				if original ~= nil then
					part.Transparency = original
					part:SetAttribute("XenoHairTransparency", nil)
				end
			end
		end

		if hair:IsA("BasePart") then
			applyPart(hair)
		else
			for _, desc in ipairs(hair:GetDescendants()) do
				if desc:IsA("BasePart") then
					applyPart(desc)
				end
			end
		end
	end

	local function normalizeName(n)
		return (n:gsub("[%s_%-]", ""):lower())
	end

	local function weldToPart(target, handle, weldName)
		local existing = target:FindFirstChild(weldName)
		if existing then
			existing:Destroy()
		end

		local weld = Instance.new("Motor6D")
		weld.Name = weldName
		weld.Part0 = target
		weld.Part1 = handle
		weld.C0 = target.CFrame:ToObjectSpace(handle.CFrame)
		weld.C1 = CFrame.new()
		weld.Parent = target
	end

	local function wearCosmetic(name)
		local character = getCharacter()
		local head = character and character:FindFirstChild("Head")
		local hum = getHumanoid()
		if not (character and head and hum) then return end

		clearCosmetic(name)

		local path = COSMETIC_PATHS[name] or {"game", "Cosmetics", "cosmetics", name}
		local template = resolvePath(ReplicatedStorage, table.unpack(path))
		if not template then
			Library:Notify({ Title = "Cosmetics", Description = name .. " not found", Time = 3 })
			return
		end

		local clone = template:Clone()
		clone.Name = "XenoCosmetic"
		clone:SetAttribute("XenoCosmetic", name)

		local parts = collectParts(clone)
		if #parts == 0 then
			clone:Destroy()
			return
		end

		-- Strip the template's own joints/animation so the piece stays put
		for _, desc in ipairs(clone:GetDescendants()) do
			if desc:IsA("JointInstance") or desc:IsA("WeldConstraint")
				or desc:IsA("Humanoid") or desc:IsA("Animator") or desc:IsA("AnimationController")
				or desc:IsA("Script") or desc:IsA("LocalScript") then
				desc:Destroy()
			end
		end
		for _, part in ipairs(parts) do
			part.CanCollide = false
			part.Massless = true
		end

		local anchor = clone:FindFirstChild("Handle")
		if not (anchor and anchor:IsA("BasePart")) then
			anchor = parts[1]
		end

		local headTop = head.CFrame * CFrame.new(0, head.Size.Y * 0.5, 0) * (COSMETIC_ADJUST[name] or CFrame.new())

		if clone:IsA("BasePart") then
			clone.CFrame = headTop
		else
			local ok = pcall(function()
				clone.PrimaryPart = anchor
				clone:PivotTo(headTop)
			end)
			if not ok then
				anchor.CFrame = headTop
			end
		end

		clone.Parent = character

		-- Anchor every part and remember how each one sits relative to the
		-- head. Anchored parts never wobble or get knocked around, and the
		-- piece is re-glued onto the head each frame so it stays perfectly
		-- stuck while walking.
		local frames = {}
		local useColor = isWearColorOn("Head Wear")
		local headColor = Options.CosmeticSelectColor and Options.CosmeticSelectColor.Value or Color3.fromRGB(255, 255, 255)
		for i, part in ipairs(parts) do
			part.Anchored = true
			part.CanCollide = false
			part.Massless = true
			if useColor then part.Color = headColor end
			if GLOW_ITEMS[name] then applyGlow(part) end
			frames[i] = { part = part, offset = head.CFrame:Inverse() * part.CFrame }
		end
		activeCosmetics[name] = frames
	end

	-- Recolour every head piece that is currently worn
	local function applyHeadColor()
		local color = Options.CosmeticSelectColor and Options.CosmeticSelectColor.Value or Color3.fromRGB(255, 255, 255)
		for _, frames in pairs(activeCosmetics) do
			for _, entry in ipairs(frames) do
				if entry.part:IsA("BasePart") then
					entry.part.Color = color
				end
			end
		end
	end

	-- Put the original colours back by rebuilding each worn piece
	local function restoreHeadColors()
		for name in pairs(activeCosmetics) do
			wearCosmetic(name)
		end
	end

	-- Glue every worn piece back onto the head. The head reference is cached so
	-- we don't run a FindFirstChild namecall every frame, and the CFrame loop is
	-- skipped entirely while the head is not moving.
	local cachedHead = nil
	local cachedHeadCFrame = nil
	local function followHead()
		local head = cachedHead
		if not head or not head.Parent then
			local character = getCharacter()
			head = character and character:FindFirstChild("Head")
			cachedHead = head
			cachedHeadCFrame = nil
		end
		if not head then return end

		local headCFrame = head.CFrame
		if headCFrame == cachedHeadCFrame then return end
		cachedHeadCFrame = headCFrame

		for _, frames in pairs(activeCosmetics) do
			for _, entry in ipairs(frames) do
				if entry.part.Parent then
					entry.part.CFrame = headCFrame * entry.offset
				end
			end
		end
	end

	-- The game can try to weld our pieces to the head itself; that would fight
	-- our anchoring. Instead of scanning the whole character on a timer, drop
	-- any joint that touches one of our parts the moment it is added.
	local function hookJointCleaner(character)
		disconnect("XenoCosmetic_JointClean")
		if not character then return end
		track("XenoCosmetic_JointClean", character.DescendantAdded:Connect(function(obj)
			if not (obj:IsA("JointInstance") or obj:IsA("WeldConstraint")) then return end
			local p0, p1 = obj.Part0, obj.Part1
			if not p0 and not p1 then return end
			for _, frames in pairs(activeCosmetics) do
				for _, entry in ipairs(frames) do
					if entry.part == p0 or entry.part == p1 then
						obj:Destroy()
						return
					end
				end
			end
		end))
	end

	Options.CosmeticSelect:OnChanged(function()
		disconnect("XenoCosmetic_CharacterAdded")
		disconnect("XenoCosmetic_Loop")
		disconnect("XenoCosmetic_JointClean")

		cachedHead = nil
		cachedHeadCFrame = nil

		local selected = Options.CosmeticSelect.Value
		local wanted = {}
		if typeof(selected) == "table" then
			for name, on in pairs(selected) do
				if on == true and name ~= "None" then
					wanted[name] = true
				end
			end
		end

		-- Drop the pieces that are no longer selected
		for name in pairs(activeCosmetics) do
			if not wanted[name] then
				clearCosmetic(name)
				activeCosmetics[name] = nil
			end
		end

		-- Put on the newly selected pieces
		for name in pairs(wanted) do
			if not activeCosmetics[name] then
				wearCosmetic(name)
			end
		end

		syncAvatarHair()

		if next(activeCosmetics) == nil then
			return
		end

		hookJointCleaner(getCharacter())

		track("XenoCosmetic_CharacterAdded", LocalPlayer.CharacterAdded:Connect(function(char)
			task.wait(0.5)
			cachedHead = nil
			cachedHeadCFrame = nil
			hookJointCleaner(char)
			for name in pairs(activeCosmetics) do
				wearCosmetic(name)
			end
			syncAvatarHair()
		end))

		-- Glue the pieces back onto the head every frame, and make sure the
		-- game doesn't weld them to the head itself
		local lastCheck = 0
		track("XenoCosmetic_Loop", RunService.RenderStepped:Connect(function()
			followHead()

			local now = os.clock()
			if now - lastCheck < 1 then return end
			lastCheck = now

			syncAvatarHair()
			refreshGlowBloom()

			for _, frames in pairs(activeCosmetics) do
				for _, entry in ipairs(frames) do
					if entry.part.Parent then
						entry.part.Anchored = true
						entry.part.CanCollide = false
					end
				end
			end
		end))
	end)

	if Options.CosmeticSelectColor then
		Options.CosmeticSelectColor:OnChanged(function()
			if isWearColorOn("Head Wear") then
				applyHeadColor()
			end
		end)
	end

	if Options.WearColorSelect then
		local headColorWasOn = false
		Options.WearColorSelect:OnChanged(function()
			local on = isWearColorOn("Head Wear")
			if on == headColorWasOn then return end
			headColorWasOn = on
			if on then
				applyHeadColor()
			else
				restoreHeadColors()
			end
		end)
	end

	-- ============================================================
	-- Body wear / Pants wear (welded to a body part, hides native clothing)
	-- ============================================================
	local function buildWearSystem(cfg)
		-- Several pieces can be worn at once, so everything is tracked per name
		local worn = {}
		local activeIsClothing = false
		local clothingStore = nil

		local function getWearColor()
			local opt = Options[cfg.colorKey]
			return (opt and opt.Value) or Color3.fromRGB(255, 255, 255)
		end

		local function wearColorEnabled()
			return isWearColorOn(cfg.colorCategory)
		end

		-- Recolour every piece of this wear type that is currently on the body
		local function applyWearColor()
			local character = getCharacter()
			if not character then return end
			local color = getWearColor()
			for _, obj in ipairs(character:GetChildren()) do
				if obj:GetAttribute(cfg.attribute) then
					if obj:IsA("BasePart") then obj.Color = color end
					for _, desc in ipairs(obj:GetDescendants()) do
						if desc:IsA("BasePart") then desc.Color = color end
					end
				end
			end
		end

		local function rootFor(name)
			local character = getCharacter()
			if not character then return nil end
			for _, obj in ipairs(character:GetChildren()) do
				if obj:GetAttribute(cfg.attribute) == name then
					return obj
				end
			end
			return nil
		end

		local function clear(name)
			local character = getCharacter()
			if not character then return end
			for _, obj in ipairs(character:GetDescendants()) do
				local tag = obj:GetAttribute(cfg.attribute)
				if tag and (name == nil or tag == name) then
					obj:Destroy()
				end
			end
		end

		-- Remove the native Shirt/Pants entirely so only the added model shows
		local function hideNativeClothing()
			local character = getCharacter()
			if not character then return end
			for _, obj in ipairs(character:GetChildren()) do
				if obj:IsA(cfg.clothingClass) or obj.Name == cfg.clothingClass then
					obj:Destroy()
				end
			end
		end

		local function wear(name)
			local character = getCharacter()
			if not character then return end

			clear(name)
			worn[name] = nil

			local path = cfg.paths[name] or {"game", "Items", "models", name}
			local template = resolvePath(ReplicatedStorage, table.unpack(path))
			if not template then
				Library:Notify({ Title = "Cosmetics", Description = name .. " not found", Time = 3 })
				return
			end

			-- Classic clothing (Shirt/Pants): wear it as a texture so it fits the body
			-- exactly and deforms with the limbs, just like the game's own clothing.
			-- Some models nest the clothing object or bundle 3D parts with it, so
			-- search the whole template instead of only its direct children.
			local clothing = template:IsA(cfg.clothingClass) and template or nil
			if not clothing then
				for _, desc in ipairs(template:GetDescendants()) do
					if desc:IsA(cfg.clothingClass) then
						clothing = desc
						break
					end
				end
			end

			local clothingTemplate = clothing and clothing[cfg.clothingClass .. "Template"] or nil
			-- Optional: for wear types that opt in with preferClothing, fall back
			-- to a texture asset on the model when it ships no clothing object.
			if not clothingTemplate and cfg.preferClothing then
				for _, desc in ipairs(template:GetDescendants()) do
					if desc:IsA("Decal") or desc:IsA("Texture") then
						local tex = desc.Texture
						if typeof(tex) == "string" and tex ~= "" then
							clothingTemplate = tex
							break
						end
					end
				end
			end

			if clothingTemplate and (cfg.preferClothing or #collectParts(template) == 0) then
				activeIsClothing = true
				local item = character:FindFirstChildOfClass(cfg.clothingClass)
				if not item then
					item = Instance.new(cfg.clothingClass)
					item.Name = cfg.clothingClass
					item.Parent = character
				end
				if clothingStore == nil then
					clothingStore = item[cfg.clothingClass .. "Template"]
				end
				item[cfg.clothingClass .. "Template"] = clothingTemplate
				worn[name] = true
				return
			end

			activeIsClothing = false
			local target, targetOffset = cfg.getTarget()
			if not (target and getHumanoid()) then return end

			hideNativeClothing()

			local clone = template:Clone()
			clone.Name = cfg.attribute .. "_" .. name
			clone:SetAttribute(cfg.attribute, name)

			local parts = collectParts(clone)
			if #parts == 0 then
				clone:Destroy()
				return
			end

			for _, desc in ipairs(clone:GetDescendants()) do
				if desc:IsA("JointInstance") or desc:IsA("WeldConstraint")
					or desc:IsA("Humanoid") or desc:IsA("Animator") or desc:IsA("AnimationController")
					or desc:IsA("Script") or desc:IsA("LocalScript") then
					desc:Destroy()
				end
			end
			for _, part in ipairs(parts) do
				part.Anchored = false
				part.CanCollide = false
				part.Massless = true
			end

			local anchor = clone:FindFirstChild("Handle")
			if not (anchor and anchor:IsA("BasePart")) then
				anchor = parts[1]
			end

			local dest = target.CFrame * (targetOffset or CFrame.new()) * (cfg.adjust[name] or CFrame.new())

			if clone:IsA("BasePart") then
				clone.CFrame = dest
			else
				local ok = pcall(function()
					clone.PrimaryPart = anchor
					clone:PivotTo(dest)
				end)
				if not ok then
					anchor.CFrame = dest
				end
			end

			-- Optional per-item stretch: a (left/right, up/down, forward/back)
			-- size multiplier so a piece can be widened to cover the body.
			-- May be a fixed Vector3 or a function(part, t) where t runs from
			-- 0 at the bottom of the item to 1 at the top, so a piece can be
			-- tapered (e.g. wide at the hems, narrow at the waist). The
			-- multiplier is applied on the character's axes regardless of how
			-- the model itself is rotated.
			local stretch = cfg.stretch and cfg.stretch[name]
			if stretch then
				local minY, maxY = math.huge, -math.huge
				for _, part in ipairs(parts) do
					local y = part.Position.Y
					if y < minY then minY = y end
					if y > maxY then maxY = y end
				end
				local span = math.max(maxY - minY, 0.001)
				for _, part in ipairs(parts) do
					local mult, shift = stretch, nil
					if typeof(stretch) == "function" then
						mult, shift = stretch(part, (part.Position.Y - minY) / span)
					end
					if mult and mult ~= Vector3.new(1, 1, 1) then
						local cf = part.CFrame
						local function axisMult(axisVec)
							if math.abs(axisVec.X) > 0.5 then return mult.X end
							if math.abs(axisVec.Y) > 0.5 then return mult.Y end
							return mult.Z
						end
						local mr = axisMult(cf:VectorToObjectSpace(target.CFrame.RightVector))
						local mu = axisMult(cf:VectorToObjectSpace(target.CFrame.UpVector))
						local mf = axisMult(cf:VectorToObjectSpace(target.CFrame.LookVector))
						part.Size = Vector3.new(part.Size.X * mr, part.Size.Y * mu, part.Size.Z * mf)
					end
					if shift then
						part.CFrame = part.CFrame
							+ target.CFrame.RightVector * shift.X
							+ target.CFrame.UpVector * shift.Y
							+ target.CFrame.LookVector * shift.Z
					end
				end
			end

			-- Deform mode (pants): weld every piece onto the body part it
			-- belongs to so the item bends with the limbs (walk/run) instead
			-- of sitting rigidly on the hips. An exact name match wins;
			-- otherwise the nearest body part is used, so a rigged model
			-- whose pieces aren't named after the limbs still follows them.
			local matched = {}
			if cfg.deform then
				-- Body parts are direct children of the character, so scanning
				-- children is enough and far cheaper than GetDescendants.
				local bodyParts = {}
				for _, obj in ipairs(character:GetChildren()) do
					if obj:IsA("BasePart") then
						table.insert(bodyParts, obj)
					end
				end
				-- Only the part of the pants that sits at or above the hips
				-- (the waist/top) is welded to the torso so it stays together,
				-- while everything below the hips keeps deforming with the
				-- legs, so the pants still moves with the feet.
				local topPart, pinAboveY
				if cfg.deformTop then
					topPart = character:FindFirstChild(cfg.deformTop.part or "LowerTorso")
						or character:FindFirstChild("UpperTorso")
						or character:FindFirstChild("Torso")
						or character:FindFirstChild("Hips")
					if topPart then
						pinAboveY = topPart.Position.Y - topPart.Size.Y * 0.5
					end
				end
				for _, part in ipairs(parts) do
					local bestPart, bestDist
					if topPart and pinAboveY and part.Position.Y >= pinAboveY then
						bestPart = topPart
					else
						local nname = normalizeName(part.Name)
						for _, bodyPart in ipairs(bodyParts) do
							if normalizeName(bodyPart.Name) == nname then
								bestPart, bestDist = bodyPart, -1
								break
							end
							local dist = (bodyPart.Position - part.Position).Magnitude
							if not bestDist or dist < bestDist then
								bestPart = bodyPart
								bestDist = dist
							end
						end
					end
					if bestPart then
						matched[part] = true
						local weld = Instance.new("Motor6D")
						weld.Name = cfg.weldName .. "_" .. part.Name
						weld.Part0 = bestPart
						weld.Part1 = part
						weld.C0 = bestPart.CFrame:ToObjectSpace(part.CFrame)
						weld.C1 = CFrame.new()
						weld.Parent = bestPart
					end
				end
			end

			-- Weld the remaining parts to the anchor BEFORE parenting,
			-- otherwise gravity nudges the unanchored parts for a frame
			for _, part in ipairs(parts) do
				if part ~= anchor and not matched[part] then
					local weld = Instance.new("Weld")
					weld.Name = "XenoPartWeld"
					weld.Part0 = anchor
					weld.Part1 = part
					weld.C0 = anchor.CFrame:ToObjectSpace(part.CFrame)
					weld.C1 = CFrame.new()
					weld.Parent = anchor
				end
			end

			clone.Parent = character
			if not matched[anchor] then
				weldToPart(target, anchor, cfg.weldName .. "_" .. name)
			end
			if wearColorEnabled() then
				local wearColor = getWearColor()
				for _, part in ipairs(parts) do
					part.Color = wearColor
				end
			end
			if GLOW_ITEMS[name] then
				for _, part in ipairs(parts) do
					applyGlow(part)
				end
			end
			worn[name] = true
		end

		-- Put the original colours back by rebuilding each worn piece
		local function restoreWearColors()
			local names = {}
			for name in pairs(worn) do
				table.insert(names, name)
			end
			for _, name in ipairs(names) do
				wear(name)
			end
		end

		local function refresh(name)
			local character = getCharacter()
			if not character then return end

			-- Clothing wear: only re-apply if the game removed it
			if activeIsClothing then
				if not character:FindFirstChildOfClass(cfg.clothingClass) then
					wear(name)
				end
				return
			end

			local target = cfg.getTarget()
			if not target then return end

			local root = rootFor(name)
			local anchor
			if root then
				if root:IsA("BasePart") then
					anchor = root
				else
					anchor = root:FindFirstChild("Handle") or root:FindFirstChildWhichIsA("BasePart")
				end
			end

			if not anchor or root.Parent ~= character then
				wear(name)
				return
			end

			-- Keep every part unanchored/massless so the item follows the body
			-- instead of being frozen in the world or drifting
			local function fixPart(part)
				if part:IsA("BasePart") then
					part.Anchored = false
					part.CanCollide = false
					part.Massless = true
				end
			end
			fixPart(root)
			for _, obj in ipairs(root:GetDescendants()) do
				fixPart(obj)
				if (obj:IsA("JointInstance") or obj:IsA("WeldConstraint")) and obj.Name ~= "XenoPartWeld" then
					obj:Destroy()
				end
			end

			local weld = target:FindFirstChild(cfg.weldName .. "_" .. name)
			if cfg.deform then
				-- The anchor is welded to whichever body part it matched; only
				-- fall back to welding it onto the target when it didn't match
				-- anything, otherwise a duplicate joint would fight the first.
				local welded = false
				for _, obj in ipairs(character:GetChildren()) do
					if obj:IsA("BasePart") then
						local w = obj:FindFirstChild(cfg.weldName .. "_" .. anchor.Name)
						if w and w.Part1 == anchor then
							welded = true
							break
						end
					end
				end
				if not welded then
					weldToPart(target, anchor, cfg.weldName .. "_" .. name)
				end
			elseif not weld or weld.Part1 ~= anchor then
				weldToPart(target, anchor, cfg.weldName .. "_" .. name)
			end
		end

		Options[cfg.dropdown]:OnChanged(function()
			disconnect(cfg.attribute .. "_CharacterAdded")
			disconnect(cfg.attribute .. "_Loop")

			local selected = Options[cfg.dropdown].Value
			local wanted = {}
			if typeof(selected) == "table" then
				for name, on in pairs(selected) do
					if on == true and name ~= "None" then
						wanted[name] = true
					end
				end
			elseif selected and selected ~= "None" then
				wanted[selected] = true
			end

			-- Take off the pieces that are no longer selected
			for name in pairs(worn) do
				if not wanted[name] then
					clear(name)
					worn[name] = nil
				end
			end

			-- Put on the newly selected pieces
			for name in pairs(wanted) do
				if not worn[name] then
					wear(name)
				end
			end

			if next(worn) == nil then
				if activeIsClothing and clothingStore ~= nil then
					local character = getCharacter()
					local item = character and character:FindFirstChildOfClass(cfg.clothingClass)
					if item then
						item[cfg.clothingClass .. "Template"] = clothingStore
					end
				end
				activeIsClothing = false
				clothingStore = nil
				return
			end

			track(cfg.attribute .. "_CharacterAdded", LocalPlayer.CharacterAdded:Connect(function()
				task.wait(0.5)
				local names = {}
				for name in pairs(worn) do
					table.insert(names, name)
				end
				for _, name in ipairs(names) do
					wear(name)
				end
			end))

			-- Keep the items attached and the native clothing removed (model wear only)
			local lastCheck = 0
			track(cfg.attribute .. "_Loop", RunService.Heartbeat:Connect(function()
				local now = os.clock()
				if now - lastCheck < 1 then return end
				lastCheck = now
				refreshGlowBloom()
				if not activeIsClothing then
					hideNativeClothing()
				end
				local names = {}
				for name in pairs(worn) do
					table.insert(names, name)
				end
				for _, name in ipairs(names) do
					refresh(name)
				end
			end))
		end)

		if Options[cfg.colorKey] then
			Options[cfg.colorKey]:OnChanged(function()
				if wearColorEnabled() then
					applyWearColor()
				end
			end)
		end

		if Options.WearColorSelect then
			local colorWasOn = false
			Options.WearColorSelect:OnChanged(function()
				local on = wearColorEnabled()
				if on == colorWasOn then return end
				colorWasOn = on
				if on then
					applyWearColor()
				else
					restoreWearColors()
				end
			end)
		end
