				task.wait(1)
				if joinLowPingServer then
					joinLowPingServer()
				end
			end
		end
	end))

	if Toggles.ServerHopOnAdmin then
		Toggles.ServerHopOnAdmin:OnChanged(function()
			if Toggles.ServerHopOnAdmin.Value then
				for _, plr in ipairs(TSG_PlayerList) do
					if plr ~= LocalPlayer and isAdmin(plr) then
						local adminName = getAdminName(plr)
						Library:Notify({ Title = "ADMIN PRESENT", Description = adminName .. " is already in the server!", Time = 5 })
						Library:Notify({ Title = "Admin Hop", Description = "Hopping to a new server...", Time = 3 })
						task.wait(1)
						if joinLowPingServer then
							joinLowPingServer()
						end
						break
					end
				end
			end
		end)
	end
end

