-- Set while the Atlantean Slot System is the one flipping the toggle, so a
-- forced enable doesn't fake a "just entered the water" event. Kept global on
-- purpose: the main chunk is already at Luau's 200-local register limit.
AtlanteanSlotSystemForcing = false

-- Which set the auto-swap last sent: "atlantean" while the water gear is on,
-- "best" while the land gear is on. Tracked so a dip into the water only sends
-- the Atlantean equips once and getting out only restores the best set once,
-- instead of re-equipping the same set every time the water state flaps.
-- Kept global on purpose: the main chunk is at Luau's 200-local register limit.
AtlanteanSwapState = nil

Toggles.AtlanteanAutoSwap:OnChanged(function()
	disconnect("AtlanteanAutoSwap")
	if Toggles.AtlanteanAutoSwap.Value then
		-- When the slot system forces this on, start from the real water state so
		-- no transition is detected. Otherwise the swap would re-equip the gear on
		-- every forced enable, and because that equip replaces the held tool it
		-- flips the slot system straight back, looping forever.
		local wasInWater = AtlanteanSlotSystemForcing and isInWater() or false
		local pendingState = nil
		local stableTime = 0
		-- How long each state has to hold before we act. Entering the water uses
		-- the user's "Seconds In Water" slider below, so a quick dip in and out
		-- never swaps anything at all. Leaving the water waits a fixed three
		-- seconds, so the best armor/sword are only equipped again once the
		-- player has actually stayed out of the water instead of surfacing for a
		-- moment and getting the whole loadout flipped straight back.
		local EXIT_DEBOUNCE = 3
		local function equipAtlantean()
			local equipHotbarRemote = TSG.EquipHotbarRemote
			local equipClothingRemote = TSG.EquipClothingRemote
			local armorSlot = tonumber(Options.AutoArmorSlot and Options.AutoArmorSlot.Value) or 5
			if not equipHotbarRemote or not equipClothingRemote then return end
			local speed = (Options.AtlanteanEquipSpeed and Options.AtlanteanEquipSpeed.Value) or 20
			local delay = 1 / math.max(0.1, speed)
			task.spawn(function()
				pcall(function()
					equipHotbarRemote:InvokeServer("inventory", armorSlot, 357)
				end)
				task.wait(delay)
				pcall(function()
					equipClothingRemote:InvokeServer("inventory", 1, 354)
				end)
				task.wait(delay)
				pcall(function()
					equipClothingRemote:InvokeServer("inventory", 2, 355)
				end)
				task.wait(delay)
				pcall(function()
					equipClothingRemote:InvokeServer("inventory", 3, 356)
				end)
			end)
		end
		track("AtlanteanAutoSwap", RunService.Heartbeat:Connect(function(dt)
			if not isAlive() then return end
			local hum = getHumanoid()
			local char = getCharacter()
			if not hum or not char then return end
			local inWater = hum:GetState() == Enum.HumanoidStateType.Swimming or char:GetAttribute("inWater")

			if inWater == wasInWater then
				-- Steady state, nothing to do.
				pendingState = nil
				stableTime = 0
				return
			end

			-- The state just flipped. Wait for it to hold before swapping, so
			-- bobbing at the water surface doesn't spam the equip remotes.
			if pendingState ~= inWater then
				pendingState = inWater
				stableTime = 0
				return
			end
			stableTime = stableTime + (dt or 0)
			-- Entering the water only counts once the player has actually stayed
			-- under for the configured time; leaving waits the fixed three-second
			-- delay before the land set is equipped again.
			local requiredTime
			if inWater then
				requiredTime = (Options.AtlanteanWaterTime and Options.AtlanteanWaterTime.Value) or 0.5
			else
				requiredTime = EXIT_DEBOUNCE
			end
			if stableTime < requiredTime then return end

			wasInWater = inWater
			pendingState = nil
			stableTime = 0
			if inWater then
				-- Only send the water set when it is not already the one applied.
				-- The Atlantean sword being in hand counts as "already applied", so
				-- a player who is already wearing the set never gets re-equipped
				-- just for jumping back into the water.
				if AtlanteanSwapState ~= "atlantean" and GetHeldToolId() ~= 357 then
					AtlanteanSwapState = "atlantean"
					task.spawn(equipAtlantean)
				end
			elseif AtlanteanSwapState ~= "best" then
				-- Been out of the water for the full delay now: equip the best
				-- armor and sword again, once.
				AtlanteanSwapState = "best"
				task.spawn(function()
					equipBestArmor()
					equipBestSword()
				end)
			end
		end))
	end
end)

do
	local atlanteanSlotSaved = nil

	local function updateAtlanteanSlotSystemState()
		if not (Toggles.AtlanteanSlotSystem and Toggles.AtlanteanSlotSystem.Value) then return end
		if not isAlive() then return end

		local holding = isAdvanceSlotAllowed(Options.AtlanteanSlotSystemSlot)

		if holding then
			if atlanteanSlotSaved == nil then
				atlanteanSlotSaved = Toggles.AtlanteanAutoSwap and Toggles.AtlanteanAutoSwap.Value or false
			end

			if Toggles.AtlanteanAutoSwap and not Toggles.AtlanteanAutoSwap.Value then
				AtlanteanSlotSystemForcing = true
				Toggles.AtlanteanAutoSwap:SetValue(true)
				AtlanteanSlotSystemForcing = false
			end
		else
			if atlanteanSlotSaved ~= nil then
				if Toggles.AtlanteanAutoSwap and Toggles.AtlanteanAutoSwap.Value ~= atlanteanSlotSaved then
					AtlanteanSlotSystemForcing = true
					Toggles.AtlanteanAutoSwap:SetValue(atlanteanSlotSaved)
					AtlanteanSlotSystemForcing = false
				end
				atlanteanSlotSaved = nil
			end
		end
	end

	if Toggles.AtlanteanSlotSystem then
		Toggles.AtlanteanSlotSystem:OnChanged(function()
			disconnect("AtlanteanSlotSystem_Poll")
			disconnect("AtlanteanSlotSystem_ChildAdded")
			disconnect("AtlanteanSlotSystem_ChildRemoved")
			disconnect("AtlanteanSlotSystem_CharAdded")

			if Toggles.AtlanteanSlotSystem.Value then
				local function hookAtlanteanSlotChar(char)
					if not char then return end
					disconnect("AtlanteanSlotSystem_ChildAdded")
					disconnect("AtlanteanSlotSystem_ChildRemoved")
					track("AtlanteanSlotSystem_ChildAdded", char.ChildAdded:Connect(function(child)
						if child:IsA("Tool") then
							task.wait()
							updateAtlanteanSlotSystemState()
						end
					end))
					track("AtlanteanSlotSystem_ChildRemoved", char.ChildRemoved:Connect(function(child)
						if child:IsA("Tool") then
							task.wait()
							updateAtlanteanSlotSystemState()
						end
					end))
				end

				if LocalPlayer.Character then
					hookAtlanteanSlotChar(LocalPlayer.Character)
				end
				track("AtlanteanSlotSystem_CharAdded", LocalPlayer.CharacterAdded:Connect(hookAtlanteanSlotChar))

				track("AtlanteanSlotSystem_Poll", RunService.Heartbeat:Connect(function()
					updateAtlanteanSlotSystemState()
				end))

				updateAtlanteanSlotSystemState()

				Library:Notify({ Title = "Atlantean Slot System", Description = "Enabled", Time = 2 })
			else
				if atlanteanSlotSaved ~= nil then
					if Toggles.AtlanteanAutoSwap and Toggles.AtlanteanAutoSwap.Value ~= atlanteanSlotSaved then
						AtlanteanSlotSystemForcing = true
						Toggles.AtlanteanAutoSwap:SetValue(atlanteanSlotSaved)
						AtlanteanSlotSystemForcing = false
					end
					atlanteanSlotSaved = nil
				end

				Library:Notify({ Title = "Atlantean Slot System", Description = "Disabled", Time = 2 })
			end
		end)
	end

	if Options.AtlanteanSlotSystemSlot then
		Options.AtlanteanSlotSystemSlot:OnChanged(function()
			updateAtlanteanSlotSystemState()
		end)
	end
end

