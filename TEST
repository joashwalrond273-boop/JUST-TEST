	-- Shared placement/sizing so the Mod pieces sit exactly like the Admin ones
	local adminArmorStretch = function(_, t)
		-- Lift the top (chest/shoulders) a little so it sits higher.
		return Vector3.new(1, 1, 1), Vector3.new(0, 0.24 * t, 0)
	end
	local adminPantsAdjust = CFrame.new(-0.1, -0.45, -0.25) * CFrame.Angles(0, math.rad(90), 0)
	local adminPantsStretch = function(_, t)
		-- t = 0 at the hems, 1 at the waist: wider and deeper at the
		-- bottom so the feet are covered, narrower at the top so the
		-- waist fits, and the very top bends a little back.
		local width = 1.42 - 0.47 * t
		local lean = 0.07 * t - 0.1 * t * t * t
		-- Keep the mid-section (around the knee) near the waist so it
		-- doesn't pull away from it when the legs swing during jumps
		-- and swimming, just a little lower than the top.
		local knee = math.max(0, 1 - math.abs(t - 0.4) / 0.3)
		-- Lift right at the mid-to-top join so the two sections
		-- overlap and stay together at the thigh when the legs swing.
		local seam = math.max(0, 1 - math.abs(t - 0.6) / 0.25)
		-- Hem sits a touch higher, the knee section sits a little below
		-- the waist and the waist drops a little more.
		local down = 0.04 * knee - 0.10 * t + 0.04 * seam
		return Vector3.new(width, 1, 1.15), Vector3.new(0, down, lean)
	end
	local adminBagAdjust = CFrame.new(0, 0.5, 0.2) * CFrame.Angles(0, math.rad(90), 0)
	local adminBagStretch = function(_, t)
		-- Hang the bag a bit lower so it stretches down the back.
		return Vector3.new(1, 1, 1), Vector3.new(0, -0.3 * (1 - t), 0)
	end

