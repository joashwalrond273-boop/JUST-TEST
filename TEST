local function startAttach()
	disconnect("AttachLoop")
	if Toggles.AttachToggle.Value then
		track("AttachLoop", RunService.Heartbeat:Connect(function()
			if not Toggles.AttachToggle.Value then return end
			local targetName = Options.AttachPlayerList.Value
			if not targetName or targetName == "" then return end

			local targetPlayer = Players:FindFirstChild(targetName)
			local targetChar = targetPlayer and targetPlayer.Character
			local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			local char = getCharacter()
			local myRoot = getRootPart()

			if targetRoot and myRoot and isAlive() then
				local attachPosition = (Options.AttachPosition and Options.AttachPosition.Value) or "Behind"
				local attachDist = (Options.AttachDistance and Options.AttachDistance.Value) or 2.5
				if attachPosition == "Float Over" then
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 6, 0) -- Over head
				elseif attachPosition == "Hide Beneath" then
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -6, 0) -- Below feet
				elseif attachPosition == "Front" then
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -attachDist) -- In front of player
				elseif attachPosition == "Orbit" then
					local angle = tick() * 3
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(math.cos(angle) * attachDist, 0, math.sin(angle) * attachDist) -- Circle around target
				else
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, attachDist) -- Behind player
				end
				myRoot.Velocity = Vector3.zero
			end
		end))
	end
end

