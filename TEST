end

-- Node Name Filter dropdowns for the auto farms. Same streaming-refresh idea as
-- refreshSelector, but the Value of a multi dropdown is a table, so the current
-- picks are carried over manually instead of via refreshSelector.
function refreshMultiSelector(option, folder)
	if not option then return end

	local previous = option.Value
	if type(previous) ~= "table" then previous = {} end

	local found = {}
	forEachResourceNode(folder, function(obj)
		if obj.Name and obj.Name ~= "" then
			found[obj.Name] = true
		end
	end)

	-- Keep the current picks in the list. Chunks briefly empty out while a reset
	-- streams them back in, and Obsidian drops selections missing from the list.
	for name in pairs(previous) do
		found[name] = true
	end

	local names = {}
	for name in pairs(found) do
		table.insert(names, name)
	end
	table.sort(names)

	option:SetValues(names)
end

