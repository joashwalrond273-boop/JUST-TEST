do
	local clSlotSaved = {
		Camlock = nil,
		Outline = nil,
	}
	local fromCLSlotSystem = false

	local function updateCamlockSlotSystemState()
		if not (Toggles.CamlockSlotSystem and Toggles.CamlockSlotSystem.Value) then return end
		if not isAlive() then return end

		-- Water Bypass: for as long as the module is active the camlock slot
		-- system stays off, so it never forces the camlock back on while swimming.
		if isWaterBypassActive() then
			if Toggles.Camlock and Toggles.Camlock.Value then
				Toggles.Camlock:SetValue(false)
			end
			return
		end

		local holding = isAdvanceSlotAllowed(Options.CamlockSlotSystemSlot)

		if holding then
			if clSlotSaved.Camlock == nil then
				clSlotSaved.Camlock = Toggles.Camlock and Toggles.Camlock.Value or false
			end
			if clSlotSaved.Outline == nil then
				clSlotSaved.Outline = Toggles.Outline and Toggles.Outline.Value or false
			end

			if Toggles.Camlock and not Toggles.Camlock.Value then
				fromCLSlotSystem = true
				Toggles.Camlock:SetValue(true)
				fromCLSlotSystem = false
			end
			if Toggles.Outline and not Toggles.Outline.Value then
				fromCLSlotSystem = true
				Toggles.Outline:SetValue(true)
				fromCLSlotSystem = false
			end
		else
			if clSlotSaved.Camlock ~= nil then
				if Toggles.Camlock and Toggles.Camlock.Value ~= clSlotSaved.Camlock then
					fromCLSlotSystem = true
					Toggles.Camlock:SetValue(clSlotSaved.Camlock)
					fromCLSlotSystem = false
				end
				clSlotSaved.Camlock = nil
			end
			if clSlotSaved.Outline ~= nil then
				if Toggles.Outline and Toggles.Outline.Value ~= clSlotSaved.Outline then
					fromCLSlotSystem = true
					Toggles.Outline:SetValue(clSlotSaved.Outline)
					fromCLSlotSystem = false
				end
				clSlotSaved.Outline = nil
			end
		end
	end

	Toggles.CamlockSlotSystem:OnChanged(function()
		disconnect("CamlockSlotSystem_Poll")
		disconnect("CamlockSlotSystem_ChildAdded")
		disconnect("CamlockSlotSystem_ChildRemoved")
		disconnect("CamlockSlotSystem_CharAdded")

		if updatePVPModulesVisibility then
			updatePVPModulesVisibility()
		end

		if Toggles.CamlockSlotSystem.Value then
			local function hookCamlockSlotChar(char)
				if not char then return end
				disconnect("CamlockSlotSystem_ChildAdded")
				disconnect("CamlockSlotSystem_ChildRemoved")
				track("CamlockSlotSystem_ChildAdded", char.ChildAdded:Connect(function(child)
					if child:IsA("Tool") then
						task.wait()
						updateCamlockSlotSystemState()
					end
				end))
				track("CamlockSlotSystem_ChildRemoved", char.ChildRemoved:Connect(function(child)
					if child:IsA("Tool") then
						task.wait()
						updateCamlockSlotSystemState()
					end
				end))
			end

			if LocalPlayer.Character then
				hookCamlockSlotChar(LocalPlayer.Character)
			end
			track("CamlockSlotSystem_CharAdded", LocalPlayer.CharacterAdded:Connect(hookCamlockSlotChar))

			track("CamlockSlotSystem_Poll", RunService.Heartbeat:Connect(function()
				updateCamlockSlotSystemState()
			end))

			updateCamlockSlotSystemState()

			Library:Notify({ Title = "Camlock Slot System", Description = "Enabled", Time = 2 })
		else
			if clSlotSaved.Camlock ~= nil then
				if Toggles.Camlock and Toggles.Camlock.Value ~= clSlotSaved.Camlock then
					fromCLSlotSystem = true
					Toggles.Camlock:SetValue(clSlotSaved.Camlock)
					fromCLSlotSystem = false
				end
				clSlotSaved.Camlock = nil
			end
			if clSlotSaved.Outline ~= nil then
				if Toggles.Outline and Toggles.Outline.Value ~= clSlotSaved.Outline then
					fromCLSlotSystem = true
					Toggles.Outline:SetValue(clSlotSaved.Outline)
					fromCLSlotSystem = false
				end
				clSlotSaved.Outline = nil
			end
			table.clear(clSlotSaved)

			Library:Notify({ Title = "Camlock Slot System", Description = "Disabled", Time = 2 })
		end
	end)

	if Options.CamlockSlotSystemSlot then
		Options.CamlockSlotSystemSlot:OnChanged(function()
			updateCamlockSlotSystemState()
		end)
	end
end

local function applySpearSwordSlot(slot)
	if not (Toggles.SpearSword and Toggles.SpearSword.Value) then return end
	local slotNum = tonumber(slot)
	if slotNum == nil then return end
	local spearSlot = tonumber(Options.SpearSlot and Options.SpearSlot.Value) or 3
	local swordSlot = tonumber(Options.SwordSlot and Options.SwordSlot.Value) or 5
	if slotNum == spearSlot then
		if Options.CamlockStuds then
			Options.CamlockStuds:SetValue(17)
		end
		if Options.OutlineStuds then
			Options.OutlineStuds:SetValue(8)
		end
	elseif slotNum == swordSlot then
		if Options.CamlockStuds then
			Options.CamlockStuds:SetValue(17)
		end
		if Options.OutlineStuds then
			Options.OutlineStuds:SetValue(1)
		end
	end
end

local function checkCurrentSpearSwordHeld()
	if not (Toggles.SpearSword and Toggles.SpearSword.Value) then return end
	local spearSlot = tonumber(Options.SpearSlot and Options.SpearSlot.Value) or 3
	local swordSlot = tonumber(Options.SwordSlot and Options.SwordSlot.Value) or 5
	if isHoldingSelectedSlot(spearSlot) then
		applySpearSwordSlot(spearSlot)
	elseif isHoldingSelectedSlot(swordSlot) then
		applySpearSwordSlot(swordSlot)
	end
end

if Toggles.SpearSword then
	Toggles.SpearSword:OnChanged(function()
		disconnect("SpearSword_Input")
		disconnect("SpearSword_ChildAdded")
		disconnect("SpearSword_CharAdded")
		if updatePVPModulesVisibility then
			updatePVPModulesVisibility()
		end
		if Toggles.SpearSword.Value then
			checkCurrentSpearSwordHeld()

			track("SpearSword_Input", UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if not (Toggles.SpearSword and Toggles.SpearSword.Value) then return end
				if not gameProcessed and not UserInputService:GetFocusedTextBox() then
					local spearSlot = tonumber(Options.SpearSlot and Options.SpearSlot.Value) or 3
					local swordSlot = tonumber(Options.SwordSlot and Options.SwordSlot.Value) or 5
					local keyNames = {"One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Zero"}
					for _, slotNum in ipairs({spearSlot, swordSlot}) do
