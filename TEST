do
	local autoEatSlotSaved = nil

	local function updateAutoEatSlotState()
		if not (Toggles.AutoEatSlotSystem and Toggles.AutoEatSlotSystem.Value) then return end
		if not isAlive() then return end

		local holding = isAdvanceSlotAllowed(Options.AutoEatSlot)

		if holding then
			if autoEatSlotSaved == nil then
				autoEatSlotSaved = Toggles.AutoEatCustom and Toggles.AutoEatCustom.Value or false
			end

			if Toggles.AutoEatCustom and not Toggles.AutoEatCustom.Value then
				Toggles.AutoEatCustom:SetValue(true)
			end
		else
			if autoEatSlotSaved ~= nil then
				if Toggles.AutoEatCustom and Toggles.AutoEatCustom.Value ~= autoEatSlotSaved then
					Toggles.AutoEatCustom:SetValue(autoEatSlotSaved)
				end
				autoEatSlotSaved = nil
			end
		end
	end

	local function hookAutoEatSlotChar(char)
		if not char then return end
		disconnect("AutoEatSlot_ChildAdded")
		disconnect("AutoEatSlot_ChildRemoved")
		track("AutoEatSlot_ChildAdded", char.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				task.wait()
				updateAutoEatSlotState()
			end
		end))
		track("AutoEatSlot_ChildRemoved", char.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") then
				task.wait()
				updateAutoEatSlotState()
			end
		end))
	end

	if LocalPlayer.Character then
		hookAutoEatSlotChar(LocalPlayer.Character)
	end
	track("AutoEatSlot_CharAdded", LocalPlayer.CharacterAdded:Connect(hookAutoEatSlotChar))

	if Options.AutoEatSlot then
		Options.AutoEatSlot:OnChanged(function()
			updateAutoEatSlotState()
		end)
	end

	if Toggles.AutoEatSlotSystem then
		Toggles.AutoEatSlotSystem:OnChanged(function()
			disconnect("AutoEatSlot_Poll")
			if Toggles.AutoEatSlotSystem.Value then
				track("AutoEatSlot_Poll", RunService.Heartbeat:Connect(updateAutoEatSlotState))
				updateAutoEatSlotState()
				Library:Notify({ Title = "Auto Heal Slot System", Description = "Enabled", Time = 2 })
			else
				if autoEatSlotSaved ~= nil then
					if Toggles.AutoEatCustom and Toggles.AutoEatCustom.Value ~= autoEatSlotSaved then
						Toggles.AutoEatCustom:SetValue(autoEatSlotSaved)
					end
					autoEatSlotSaved = nil
				end
				Library:Notify({ Title = "Auto Heal Slot System", Description = "Disabled", Time = 2 })
			end
		end)
	end
end

