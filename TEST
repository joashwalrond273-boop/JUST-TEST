-- Infinite stamina, no fall damage, anti lava (Behavior > Disabled on workspace.Characters.[name] or Character itself)
local function hookCharFolderBehaviors()
	disconnect("CharFolder_ChildAdded")
	local folder = getCharacterFolder()
	if folder then
		track("CharFolder_ChildAdded", folder.ChildAdded:Connect(function(child)
			if child and child:IsA("Instance") then
				task.wait(0.05)
				applyCharacterModuleToggles()
			end
		end))
	end
end

local function applyCharacterModuleToggles()
	if Toggles.InfiniteStamina and Toggles.InfiniteStamina.Value then
		setBehaviorDisabled(getCharacterBehavior("stamina"), true)
	end
	if Toggles.NoFallDamage and Toggles.NoFallDamage.Value then
		setBehaviorDisabled(getCharacterBehavior("fallDamage"), true)
	end
	if Toggles.AntiLava and Toggles.AntiLava.Value then
		local char = getCharacter()
		if char then
			setBehaviorDisabled(char:FindFirstChild("worldHazards"), true)
		end
	end
end

