-- Water Bypass shared detection. Kept as globals on purpose: the main chunk is
-- already at Luau's 200-local register limit, so no extra top-level locals.
WaterRayParams = RaycastParams.new()
WaterRayParams.FilterType = Enum.RaycastFilterType.Exclude

function isInWater()
	local character = getCharacter()
	local humanoid = getHumanoid()
	if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		return true
	end
	if character and character:GetAttribute("inWater") then
		return true
	end
	local root = getRootPart()
	if not root then return false end
	WaterRayParams.FilterDescendantsInstances = { character }
	local below = workspace:Raycast(root.Position, Vector3.new(0, -15, 0), WaterRayParams)
	return below ~= nil and below.Material == Enum.Material.Water
end

-- Throttled water sample shared by the per-frame combat loops. isInWater()
-- issues a workspace:Raycast, and the Aimlock used to call it on every single
-- frame. Refreshing it a few times a second and reusing the value in between
-- removes up to one raycast per frame per loop, which is real work on mobile.
-- Kept as globals on purpose: the main chunk is at Luau's 200-local limit.
TSG_WaterSample = false
TSG_WaterSampleNext = 0
function TSG_SampleInWater()
	local now = tick()
	if now >= TSG_WaterSampleNext then
		TSG_WaterSampleNext = now + 0.2
		TSG_WaterSample = isInWater()
	end
	return TSG_WaterSample
end

local function isHoldingSelectedSlot(selectedSlot)
	if not selectedSlot then return false end
	local character = getCharacter()
	if not character then return false end
	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then return false end

	local slotStr = tostring(selectedSlot)
	local slotNum = tonumber(selectedSlot)

	if tool.Name == slotStr then
		return true
	end
	if slotNum and tonumber(tool.Name) == slotNum then
		return true
	end
	if slotNum then
		local attrSlot = tool:GetAttribute("slot") or tool:GetAttribute("Slot") or tool:GetAttribute("HotbarSlot")
		if attrSlot and (attrSlot == slotNum or tostring(attrSlot) == slotStr) then
			return true
		end
		if tool:FindFirstChild("toolModel") then
			local tmSlot = tool.toolModel:GetAttribute("slot") or tool.toolModel:GetAttribute("Slot") or tool.toolModel:GetAttribute("HotbarSlot")
			if tmSlot and (tmSlot == slotNum or tostring(tmSlot) == slotStr) then
				return true
			end
		end
	end
	if tool.Name:match("^Slot%s*" .. slotStr .. "$") or tool.Name:match("^slot%s*" .. slotStr .. "$") then
		return true
	end

	return false
end

local function isAdvanceSlotAllowed(slotOption)
	if not slotOption then return false end
	local val = slotOption.Value
	if val == nil then return false end

	if typeof(val) == "table" then
		for slotKey, isSelected in pairs(val) do
			local targetSlot = nil
			if isSelected == true then
				targetSlot = slotKey
			elseif typeof(isSelected) == "string" then
				targetSlot = isSelected
			elseif typeof(isSelected) == "number" then
				targetSlot = isSelected
			end
			if targetSlot ~= nil then
				if isHoldingSelectedSlot(targetSlot) then
					return true
				end
			end
		end
		return false
	elseif typeof(val) == "string" or typeof(val) == "number" then
		return isHoldingSelectedSlot(val)
	end

	return false
end

-- Water Bypass helpers. Globals on purpose: the main chunk is already at Luau's
-- 200-local register limit. The module only counts as active while in the water
-- AND holding one of the tools picked in the camlock Spear / Sword lists.
function isHoldingWaterTool()
	if isAdvanceSlotAllowed(Options.SpearSlot) then return true end
	if isAdvanceSlotAllowed(Options.SwordSlot) then return true end
	return false
end

function isWaterBypassActive(inWater)
	if not (Toggles.WaterBypass and Toggles.WaterBypass.Value) then return false end
	if not isHoldingWaterTool() then return false end
	if inWater == nil then
		inWater = isInWater()
	end
	return inWater
end

