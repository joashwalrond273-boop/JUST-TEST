WaypointGroup:AddInput("WaypointName", {
	Text = "Spot Name",
	Default = "",
	Placeholder = "Spawn",
})

WaypointGroup:AddButton({
	Text = "Save Current Spot",
	Func = function()
		local root = getRootPart()
		if not root then
			Library:Notify({ Title = "Waypoints", Description = "No character to save.", Time = 3 })
			return
		end
		local name = Options.WaypointName and Options.WaypointName.Value
		if not name or name == "" then
			local count = 0
			for _ in pairs(Waypoints) do
				count = count + 1
			end
			name = "Spot " .. tostring(count + 1)
		end
		-- Reusing a name simply overwrites it, so the list never gets duplicates.
		Waypoints[name] = root.Position
		refreshWaypointList()
		pcall(function()
			Options.WaypointList:SetValue(name)
		end)
		Library:Notify({ Title = "Waypoints", Description = "Saved " .. name .. ".", Time = 3 })
	end,
})

