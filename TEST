-- ==========================================
-- SHARED __namecall DISPATCHER + PLAYER LIST
-- ==========================================
-- Hooking game.__namecall is the most invasive thing this script does: while it
-- is installed the wrapper runs on EVERY method call the whole game makes.
-- Stacking three separate wrappers at load (bear trap, boss damage / hit
-- feedback, silent aim) meant three extra Lua calls plus three
-- getnamecallmethod() calls per method call even with every feature switched
-- off. Each feature now registers its handler here only while it is active and
-- the chain is rebuilt, so with nothing enabled the game's own metamethod is
-- left completely untouched.
-- Globals on purpose: the main chunk is at Luau's 200-local register limit.
TSG_NamecallBase = nil    -- the game's untouched metamethod
TSG_NamecallTop = nil     -- whatever wrapper is installed right now
TSG_NamecallHooks = {}    -- active handlers, called as handler(original, ...)

function TSG_NamecallAvailable()
	return hookmetamethod ~= nil and getnamecallmethod ~= nil
end

-- Captures the game's own metamethod once, so the chain can always be rebuilt
-- from the bottom no matter which feature is switched off first.
function TSG_CaptureNamecallBase()
	if TSG_NamecallBase then return true end
	if not TSG_NamecallAvailable() then return false end
	local original
	original = hookmetamethod(game, "__namecall", function(...)
		return original(...)
	end)
	hookmetamethod(game, "__namecall", original)
	TSG_NamecallBase = original
	TSG_NamecallTop = original
	return true
end

function TSG_RebuildNamecall()
	if not TSG_NamecallBase then return end
	local chain = TSG_NamecallBase
	for _, handler in ipairs(TSG_NamecallHooks) do
		local previous = chain
		chain = function(...)
			return handler(previous, ...)
		end
	end
	if chain ~= TSG_NamecallTop then
		TSG_NamecallTop = chain
		hookmetamethod(game, "__namecall", chain)
	end
end

function TSG_AddNamecallHook(handler)
	if not TSG_CaptureNamecallBase() then return end
	if table.find(TSG_NamecallHooks, handler) then return end
	table.insert(TSG_NamecallHooks, handler)
	TSG_RebuildNamecall()
end

function TSG_RemoveNamecallHook(handler)
	local index = table.find(TSG_NamecallHooks, handler)
	if not index then return end
	table.remove(TSG_NamecallHooks, index)
	TSG_RebuildNamecall()
end

