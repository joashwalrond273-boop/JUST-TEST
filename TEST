-- Boss damage blocking + hit feedback. Both share one wrapper, which the shared
-- dispatcher only installs while at least one of them is active.
local BossDamageEvent = resolvePath(ReplicatedStorage, "remoteInterface", "character", "hurtByAIAttack")

-- Called as handler(previous, ...). Global on purpose: the main chunk is at
-- Luau's 200-local register limit.
function TSG_BossHitNamecall(previous, ...)
	local self = ...
	local method = getnamecallmethod()

	if method == "FireServer" and BossDamageEvent and rawequal(self, BossDamageEvent) then
		if Toggles.NoBossDamage and Toggles.NoBossDamage.Value then
			return -- Block the attack to prevent damage
		end
	end

	if (method == "FireServer" or method == "InvokeServer") then
		local isMeleeHit = rawequal(self, TSG.MeleePlayerRemote)
			or rawequal(self, TSG.MeleeAI)
			or rawequal(self, TSG.MeleeAnimalRemote)
		if isMeleeHit then
			local hitArgs = table.pack(select(2, ...))
			task.defer(function()
				pcall(function()
					if Xeno_PlayHitSound then
						Xeno_PlayHitSound()
					end
					if Xeno_PlayHitEffect then
						Xeno_PlayHitEffect(hitArgs)
					end
				end)
			end)
		end
	end

	return previous(...)
end

-- True while the hit sound or hit effect would actually do something, so the
-- wrapper is not kept installed for a selection that is effectively off.
function TSG_HitFeedbackActive()
	if Toggles.HitSound and Toggles.HitSound.Value then
		local sound = Options.HitSoundSelect and Options.HitSoundSelect.Value
		if sound and sound ~= "None" then return true end
	end
	local effect = Options.HitEffectSelect and Options.HitEffectSelect.Value
	return effect ~= nil and effect ~= "None"
end

-- Registers the shared wrapper only while the boss blocker or the hit feedback
-- needs it, so with all three off the game's metamethod is left untouched.
function TSG_SyncBossHitHook()
	if (Toggles.NoBossDamage and Toggles.NoBossDamage.Value) or TSG_HitFeedbackActive() then
		TSG_AddNamecallHook(TSG_BossHitNamecall)
	else
		TSG_RemoveNamecallHook(TSG_BossHitNamecall)
	end
end

