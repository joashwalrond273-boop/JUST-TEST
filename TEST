-- Shared helper: equips the strongest Helmet / Shirt / Pants the player owns.
-- Used by the button below and by Atlantean Auto Swap. The item-data "defense"
-- value isn't reliable, so the known armor sets are ranked explicitly from
-- weakest to strongest and the best piece the player owns is equipped per slot.
function equipBestArmor()
	local equipClothingRemote = TSG.EquipClothingRemote
	if not equipClothingRemote or not TSG.ClientData or not TSG.Items then
		return
	end

	-- Weakest -> strongest.
	local armorOrder = {
		{ helmet = 202, shirt = 200, pants = 201 }, -- Bluesteel
		{ helmet = 354, shirt = 355, pants = 356 }, -- Atlantean
		{ helmet = 262, shirt = 261, pants = 260 }, -- Darksteel
		{ helmet = 404, shirt = 403, pants = 402 }, -- Samurai
		{ helmet = 541, shirt = 542, pants = 543 }, -- Juggernaut
	}

	-- getInventory() lists every item id in the game, so an id simply being
	-- present does NOT mean the player owns it. Only count entries that are
	-- actually owned (truthy, or a count greater than zero).
	local inventory = TSG.ClientData.getInventory() or {}
	local function owns(itemId)
		local entry = inventory[itemId]
		if entry == nil or entry == false then
			return false
		end
		if type(entry) == "number" then
			return entry > 0
		end
		return true
	end

	local slots = {
		{ key = "helmet", slot = 1 },
		{ key = "shirt", slot = 2 },
		{ key = "pants", slot = 3 },
	}

	for _, slotInfo in ipairs(slots) do
		for tierIndex = #armorOrder, 1, -1 do
			local itemId = armorOrder[tierIndex][slotInfo.key]
			if itemId and owns(itemId) then
				pcall(function()
					equipClothingRemote:InvokeServer("inventory", slotInfo.slot, itemId)
				end)
				break
			end
		end
	end
end

-- Shared helper: equips the strongest sword the player owns into the slot picked
-- by the "Sword Slot" dropdown. Ranked with the same weakest -> strongest order
-- as the armor sets above.
function equipBestSword()
	local equipHotbarRemote = TSG.EquipHotbarRemote
	if not equipHotbarRemote or not TSG.ClientData then
		return
	end

	local armorSlot = tonumber(Options.AutoArmorSlot and Options.AutoArmorSlot.Value) or 5

	-- Weakest -> strongest.
	local swordOrder = {
		197, -- Bluesteel
		357, -- Atlantean
		267, -- Darksteel
		406, -- Samurai
		545, -- Juggernaut
	}

	-- Same ownership rule as equipBestArmor: getInventory() lists every item id
	-- in the game, so an id simply being present does NOT mean the player owns it.
	local inventory = TSG.ClientData.getInventory() or {}
	for tierIndex = #swordOrder, 1, -1 do
		local itemId = swordOrder[tierIndex]
		local entry = inventory[itemId]
		if entry ~= nil and entry ~= false and (type(entry) ~= "number" or entry > 0) then
			pcall(function()
				equipHotbarRemote:InvokeServer("inventory", armorSlot, itemId)
			end)
			break
		end
	end
end

