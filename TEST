		local lastApply = 0
		track("InfiniteStaminaPoll", RunService.Heartbeat:Connect(function()
			local now = os.clock()
			if now - lastApply < 0.25 then return end
			lastApply = now
			if Toggles.InfiniteStamina and Toggles.InfiniteStamina.Value then
				applyCharacterModuleToggles()
			end
