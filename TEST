-- Waypoints: store your current position under a name and jump back later.
Waypoints = {}

function refreshWaypointList()
	if not Options.WaypointList then return end
	local names = {}
	for name in pairs(Waypoints) do
		table.insert(names, name)
	end
	table.sort(names)
	pcall(function()
		Options.WaypointList:SetValues(names)
	end)
end

