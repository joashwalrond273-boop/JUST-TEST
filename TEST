local function isSwingAnimation(trackObj)
	local anim = trackObj.Animation
	if not anim then return false end
	local id = anim.AnimationId
	local name = anim.Name:lower()

	if name:find("idle") or name:find("walk") or name:find("run") or name:find("jump") or
	   name:find("fall") or name:find("swim") or name:find("climb") or name:find("strafe") then
		return false
	end

	local movementIds = {
		["507766388"] = true, ["507777826"] = true, ["507767714"] = true,
		["507765000"] = true, ["507767968"] = true, ["507765644"] = true,
		["507784064"] = true, ["180426354"] = true, ["180415668"] = true,
		["180419271"] = true, ["180435571"] = true
	}
	for mId in pairs(movementIds) do
		if id:find(mId) then
			return false
		end
	end

	return true
end

local isShielding = false
local lastShieldFire = 0
local function updateImmortalMode()
	if not isAlive() or not Toggles.ImmortalMode.Value then
		if isShielding then
			isShielding = false
			FireSetShield(false)
		end
		return
	end

	local root = getRootPart()
	if not root then return end

	local shouldShield = false
	local checkDistance = (Options.ImmortalModeStuds and Options.ImmortalModeStuds.Value) or 18
	local nearestEnemy = nil
	local nearestDist = math.huge
	-- Ignore Team is baked into Infinite Shield: teammates are never targeted.
	local ignoreTeam = true

	for _, player in ipairs(TSG_PlayerList) do
		if player ~= LocalPlayer and player.Character then
			if not ignoreTeam or not isTeammate(player) then
				local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				if targetRoot and hum and hum.Health > 0 then
					local dist = (targetRoot.Position - root.Position).Magnitude
					if dist <= checkDistance then
						shouldShield = true
						if dist < nearestDist then
							nearestDist = dist
							nearestEnemy = targetRoot
						end
					end
				end
			end
		end
	end

	if shouldShield then
		-- The block only covers the way the character faces, so while the shield is
		-- up we always turn towards the closest enemy: that is the most coverage a
		-- client can give a server-side block.
		local targetToFace = nearestEnemy

		if targetToFace then
			local targetPos = targetToFace.Position
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
		end

		local shieldSpeed = (Options.ImmortalShieldSpeed and Options.ImmortalShieldSpeed.Value) or 0.1
		if tick() - lastShieldFire >= shieldSpeed then
			lastShieldFire = tick()
			if IsHoldingShieldSword() then
				-- Shield sword already in hand: the server accepts the block directly.
				FireSetShield(true)
			elseif not ShieldGhostSwapBusy and tick() - ShieldGhostSwapLast >= ShieldGhostSwapInterval then
				-- Raise the shield without holding the sword: equip one just long
				-- enough for the server to accept setShield, then hand your weapon back.
				ShieldGhostSwapLast = tick()
				GhostShieldSwap()
			end
		end
		isShielding = true
	else
		if isShielding then
			isShielding = false
			FireSetShield(false)
		end
	end
end

