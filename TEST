		end

		Library:Notify({ Title = "Highlight Admin", Description = "Enabled", Time = 2 })
	end)

	-- Alert Admin Spectates & Server Hop
	local spectateAlertActive = false
	local spectateLastAlert = 0

	local function valueReferencesMe(value)
		if typeof(value) == "Instance" then
			return value == LocalPlayer or (LocalPlayer.Character ~= nil and value == LocalPlayer.Character)
		elseif type(value) == "string" then
			return value == LocalPlayer.Name or value == tostring(LocalPlayer.UserId)
		elseif type(value) == "number" then
			return value == LocalPlayer.UserId
		end
		return false
	end

	local function getAdminSpectatingMe()
		for _, admin in ipairs(TSG_PlayerList) do
			if admin ~= LocalPlayer and isAdmin(admin) then
				local ok, attrs = pcall(function() return admin:GetAttributes() end)
				if ok and type(attrs) == "table" then
					for _, v in pairs(attrs) do
						if valueReferencesMe(v) then return getAdminName(admin) end
					end
				end

				for _, obj in ipairs(admin:GetDescendants()) do
					if obj:IsA("ObjectValue") or obj:IsA("StringValue") or obj:IsA("NumberValue") or obj:IsA("IntValue") then
						if valueReferencesMe(obj.Value) then return getAdminName(admin) end
					end
				end
			end
		end

		return nil
	end

	Toggles.AdminSpectateAlert:OnChanged(function()
		spectateAlertActive = Toggles.AdminSpectateAlert.Value
