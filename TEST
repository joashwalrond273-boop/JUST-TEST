	Func = function()
		local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local playerPosition = root.Position

		local buildRemote = TSG.BuildRemote
		local craftRemote = TSG.CraftRemote
		local armorSlot = tonumber(Options.AutoArmorSlot and Options.AutoArmorSlot.Value) or 5
		local equipHotbarRemote = TSG.EquipHotbarRemote
		local equipClothingRemote = TSG.EquipClothingRemote
		local deleteRemote = TSG.DeleteStructureRemote

		if not equipHotbarRemote or not equipClothingRemote then
			return
		end

		if Toggles.ArmorEquipOnly and Toggles.ArmorEquipOnly.Value then
			if isArmorPieceSelected("Sword") then
				pcall(function()
					equipHotbarRemote:InvokeServer("inventory", armorSlot, 357)
				end)
			end
			if isArmorPieceSelected("Helmet") then
				pcall(function()
					equipClothingRemote:InvokeServer("inventory", 1, 354)
				end)
			end
			if isArmorPieceSelected("Chestplate") then
				pcall(function()
					equipClothingRemote:InvokeServer("inventory", 2, 355)
				end)
			end
			if isArmorPieceSelected("Pants") then
				pcall(function()
					equipClothingRemote:InvokeServer("inventory", 3, 356)
				end)
			end
			return
		end

		if not buildRemote or not craftRemote then
			Library:Notify({ Title = "Error", Description = "Build/Craft remote not found", Time = 3 })
			return
		end

		-- If an Atlantean forge is already near the player, just craft with it.
		local furnace = findNearbyForge(playerPosition, function(c)
			return c.Name:lower():find("atlantean", 1, true) ~= nil
		end)
