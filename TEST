-- ==========================================
-- Aimlock: locks the camera onto a single player. It runs in the water with
-- Water Bypass, and anywhere else while names are picked in the Blacklist (then
-- it only locks onto those names). While it is locked on, the camlock stands
-- down, so the two never fight over the camera. Blacklist names are therefore
-- handled by the aimlock, while the camlock keeps locking onto everyone else.
-- Global on purpose: the main chunk is already at Luau's 200-local limit.
AimlockTargetPlayer = nil
do
	local aimlockMouseLocked = false

	-- Cached player list so the per-frame aim pick never has to rebuild it. Only
	-- refreshed when someone joins or leaves. Kept as globals on purpose: the
	-- main chunk is already at Luau's 200-local register limit.
	AimlockPlayers = {}
	function refreshAimlockPlayers()
		local list = {}
		for _, p in ipairs(TSG_PlayerList) do
			if p ~= LocalPlayer then
				table.insert(list, p)
			end
		end
		AimlockPlayers = list
	end
	refreshAimlockPlayers()
	track("AimlockPlayerAdded", Players.PlayerAdded:Connect(refreshAimlockPlayers))
	track("AimlockPlayerRemoving", Players.PlayerRemoving:Connect(refreshAimlockPlayers))

	local function aimlockReleaseMouse()
		if not aimlockMouseLocked then return end
		aimlockMouseLocked = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end

	local function aimlockPickClosest()
		local root = getRootPart()
		if not root then return nil end

		local maxDist = (Options.CamlockStuds and Options.CamlockStuds.Value) or 20

		-- Optional field of view: only targets inside the cone in front of the
		-- camera are considered. 360° (the default) means no restriction.
		local camera = workspace.CurrentCamera
		local fovAngle = (Options.WaterBypassFOV and Options.WaterBypassFOV.Value) or 360
		local useFOV = camera ~= nil and fovAngle < 360
		local coneThreshold = useFOV and math.cos(math.rad(fovAngle / 2)) or nil
		local forward = useFOV and camera.CFrame.LookVector or nil
		local camPos = useFOV and camera.CFrame.Position or nil

		-- While names are picked in the Blacklist the aimlock only looks at those
		-- names; with an empty list it keeps its old behaviour (closest
		-- non-teammate).
		local listActive = isCamlockListActive()

		local bestPlayer, bestDist = nil, maxDist
		for _, otherPlayer in ipairs(AimlockPlayers) do
			-- The ignore-team system is always on here: teammates / clanmates are
			-- never picked. A blacklisted name overrides it, otherwise picking a
			-- teammate would do nothing.
			local allowed
			if listActive then
				allowed = isCamlockBlacklisted(otherPlayer)
			else
				allowed = not isTeammate(otherPlayer)
			end
			if otherPlayer ~= LocalPlayer and otherPlayer.Character and allowed then
				local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
				local otherHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
				if otherRoot and otherHum and otherHum.Health > 0 then
					local dist = (otherRoot.Position - root.Position).Magnitude
					if dist <= bestDist then
						local inFOV = true
						if useFOV and forward then
							local dir = otherRoot.Position - camPos
							if dir.Magnitude > 0 then
								inFOV = forward:Dot(dir.Unit) >= coneThreshold
							end
						end
						if inFOV then
							bestPlayer, bestDist = otherPlayer, dist
						end
					end
				end
			end
		end
		return bestPlayer
	end

	-- The target is re-picked a few times a second; the camera lock below still
	-- runs every frame so it stays perfectly smooth.
	local aimlockTarget = nil
	local aimlockNextPick = 0

	local function aimlockStep()
		-- Runs in the water with Water Bypass, and anywhere else while names are
		-- picked in the Blacklist (then it only locks onto those names). The water
		-- sample is throttled: isWaterBypassActive() would otherwise fire a
		-- workspace raycast on every single frame.
		if not (isWaterBypassActive(TSG_SampleInWater()) or (isCamlockListActive() and isAdvanceSlotAllowed(Options.CamlockSlotSystemSlot))) then
			AimlockTargetPlayer = nil
			aimlockTarget = nil
			aimlockNextPick = 0
			aimlockReleaseMouse()
			return
		end
		if not isAlive() then
			AimlockTargetPlayer = nil
			return
		end

		local root = getRootPart()
		if not root then return end

		-- Shiftlock: the mouse stays pinned to the centre for the whole time the
		-- aimlock is active, even when there is no target to aim at. The body is
		-- never touched, so the player keeps full control of it.
		aimlockMouseLocked = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false

		local now = tick()
		if now >= aimlockNextPick then
			aimlockNextPick = now + 0.15
			aimlockTarget = aimlockPickClosest()
		end
		local closest = aimlockTarget
		if not closest or not closest.Character then
			-- No target: the camlock is free to keep working normally.
			AimlockTargetPlayer = nil
			return
		end
		-- Locked on: the camlock stands down for this target so the two never
		-- fight over the camera.
		AimlockTargetPlayer = closest

		local targetRoot = closest.Character:FindFirstChild("HumanoidRootPart")
		local aimPartName = (Options.CamlockAimPart and Options.CamlockAimPart.Value) or "Head"
		local aimPart = closest.Character:FindFirstChild(aimPartName) or targetRoot
		local camera = workspace.CurrentCamera
		if not (aimPart and camera) then
			return
		end

		local smoothness = (Options.CamlockSmoothness and Options.CamlockSmoothness.Value) or 0.2
		local lerpFactor = math.clamp(smoothness, 0.01, 1)
		camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, aimPart.Position), lerpFactor)
	end

	-- The aimlock can only do anything while Water Bypass is on or names are
	-- picked in the Camlock Blacklist, so the loop is only connected while one of
	-- those is true instead of running a callback every frame forever. Global on
	-- purpose: it is also called from the Water Bypass toggle and the Camlock
	-- Blacklist dropdown handlers.
	local aimlockConnected = false
	function TSG_AimlockSync()
		-- isCamlockListActive is declared lower down the file, so it can still be
		-- nil when this runs during load. Guard it so the load-time call below
		-- never errors out (which would skip every tab built after COMBAT).
		local should = (Toggles.WaterBypass and Toggles.WaterBypass.Value)
			or (isCamlockListActive and isCamlockListActive())
		if should == aimlockConnected then return end
		aimlockConnected = should
		disconnect("Aimlock")
		if should then
			track("Aimlock", RunService.RenderStepped:Connect(aimlockStep))
		else
			AimlockTargetPlayer = nil
			aimlockTarget = nil
			aimlockNextPick = 0
			aimlockReleaseMouse()
		end
	end
	TSG_AimlockSync()
end

-- Split targeting for the Camlock "Blacklist": names picked there are handed to
-- the Aimlock (which locks onto them), while the camlock leaves those names alone
-- and keeps locking onto everyone else. Globals on purpose: the main chunk is
-- already at Luau's 200-local register limit.
function isCamlockBlacklisted(player)
	if not player then return false end
	local list = Options.CamlockPlayerList and Options.CamlockPlayerList.Value
	if typeof(list) ~= "table" then return false end
	return list[player.Name] == true
end

-- True while at least one name is picked in the Camlock "Blacklist".
function isCamlockListActive()
	local list = Options.CamlockPlayerList and Options.CamlockPlayerList.Value
	if typeof(list) ~= "table" then return false end
	return next(list) ~= nil
end

