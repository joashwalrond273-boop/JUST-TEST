-- ==========================================
-- SILENT AIM (HK / HOOK BASED)
-- ==========================================
-- Logic for the Silent Aim menu, which is built next to the Camlock box in the
-- right column further up. This is the hook based version: it never moves the
-- camera and never resizes body parts. Instead it watches the game's own
-- Raycast / FireServer / InvokeServer calls through a __namecall hook and
-- rewrites the arguments they carry (direction, origin, hit position...) so the
-- shot lands on the chosen target while everything on screen stays untouched.
-- All state lives on one global table to stay clear of the main chunk's local
-- register budget.
SilentAimHK.Supported = (hookmetamethod ~= nil and getnamecallmethod ~= nil and checkcaller ~= nil)
SilentAimHK.MouseHook = nil
SilentAimHK.CachedMouse = nil
SilentAimHK.RemoteNameCache = nil
SilentAimHK.DetectedRemotes = {}
SilentAimHK.RingUnsupported = false
-- WallBang used to fake the result of every raycast in the game, which broke
-- the game's own water/terrain/movement queries. It is only safe on the shot
-- you are actually taking, so it is confined to a short window that opens when
-- you attack (see markShot below and the wiring after the hook install).
SilentAimHK.ShotUntil = 0
SilentAimHK.SHOT_WINDOW = 0.25
-- Water state for the WallBang guard. It is sampled on the heartbeat loop and
-- only read here, because isInWater() fires a raycast of its own: calling it
-- from inside the namecall hook re-enters the intercept while the hook is
-- still running and blows the client's stack out (that is what crashed it).
SilentAimHK.InWater = false
-- Cached "weapon in hand" flag, sampled on the same heartbeat loop. The mouse
-- interception below only rewrites Mouse.Target / Mouse.Hit / Mouse.UnitRay
-- while this is true, so it can never hijack the build preview's mouse reads.
SilentAimHK.HeldWeapon = false
-- Cached "held tool is in one of the Slot System slots" flag, sampled on the
-- same heartbeat loop. isEnabled() reads this instead of checking the tool
-- directly, because that lookup makes engine calls which would re-enter the
-- __namecall hook from inside itself.
SilentAimHK.SlotAllowed = true
-- Tracks whether the silent aim heartbeat loop is currently connected, so both
-- things that can arm silent aim (the main toggle and the Slot System) share a
-- single connect / disconnect path.
SilentAimHK.connected = false

-- Opens the WallBang window. It is called only from the player's own attack
-- (mouse click / tool activated), so the faked ray result is returned for the
-- shot actually being taken instead of for every raycast the game makes.
function SilentAimHK.markShot()
	SilentAimHK.ShotUntil = tick() + (SilentAimHK.SHOT_WINDOW or 0.25)
end

function SilentAimHK.shotWindowOpen()
	return tick() <= (SilentAimHK.ShotUntil or 0)
end

-- Keep the shot window fresh on whatever tool the player is holding.
function SilentAimHK.hookShotChar(char)
	if not char then return end
	disconnect("SilentAimHKShotTool")
	track("SilentAimHKShotTool", char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			child.Activated:Connect(function()
				SilentAimHK.markShot()
			end)
		end
	end))
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") then
			child.Activated:Connect(function()
				SilentAimHK.markShot()
			end)
		end
	end
end

