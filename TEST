				pcall(function()
					equipClothingRemote:InvokeServer("inventory", 3, 201)
				end)
			end
			return
		end

		if not buildRemote or not craftRemote then
			Library:Notify({ Title = "Error", Description = "Build/Craft remote not found", Time = 3 })
			return
		end

		-- If a Bluesteel furnace is already near the player, just craft with it.
		local furnace = findNearbyForge(playerPosition, function(c)
			return c.Name:lower():find("bluesteel", 1, true) ~= nil
		end)
