		track("CamlockPlayerAdded", Players.PlayerAdded:Connect(refreshCamlockPlayers))
		track("CamlockPlayerRemoving", Players.PlayerRemoving:Connect(refreshCamlockPlayers))

		-- The target is re-picked a few times a second; the camera lock below
		-- still runs every frame so it stays perfectly smooth.
		local camlockTarget = nil
		local camlockNextPick = 0

		-- Anything water related counts as "in water": swimming, treading on the
		-- surface, or walking/floating on it. There the camlock must leave the
		-- body completely alone and only move the camera. The downward raycast
		-- used to run on every single frame; it is now cached and refreshed a few
		-- times a second, which removes a per-frame raycast while in the water.
		local camlockWaterCache = false
		local camlockWaterNext = 0

		local camlockRayParams = RaycastParams.new()
		camlockRayParams.FilterType = Enum.RaycastFilterType.Exclude

		local function camlockInWater(character, root)
			local h = character and character:FindFirstChildOfClass("Humanoid")
			if h and h:GetState() == Enum.HumanoidStateType.Swimming then
				camlockWaterCache = true
				return true
			end
			local now = tick()
			if now < camlockWaterNext then
				return camlockWaterCache
			end
			camlockWaterNext = now + 0.2
			if not root then
				camlockWaterCache = false
				return false
			end
			camlockRayParams.FilterDescendantsInstances = { character }
			local below = workspace:Raycast(root.Position, Vector3.new(0, -15, 0), camlockRayParams)
			camlockWaterCache = below ~= nil and below.Material == Enum.Material.Water
			return camlockWaterCache
		end

		track("Camlock", RunService.RenderStepped:Connect(function(dt)
			if not isAlive() then return end
			local root = getRootPart()
			local hum = getHumanoid()
			if not root or not hum then return end

			-- In water the camlock only moves the camera. The body is left
			-- untouched, so it behaves exactly as if the camlock were off.
			local inWater = camlockInWater(LocalPlayer.Character, root)
			if inWater then
				hum.AutoRotate = true
			end

			-- Water Bypass: while in the water the camlock stays off completely so
			-- the Aimlock has full control. The mouse is left to the Aimlock loop
			-- instead of being forced back to default.
			if isWaterBypassActive(inWater) then
				camlockTarget = nil
				hum.AutoRotate = true
				return
			end

			-- The Aimlock is locked onto a Blacklist name: hand the camera over the
			-- same way. It only holds a target while one of those names is in range,
			-- so the camlock keeps working normally the rest of the time.
			if AimlockTargetPlayer then
				camlockTarget = nil
				hum.AutoRotate = true
				return
			end

			local maxDist = Options.CamlockStuds and Options.CamlockStuds.Value or 20
			local myPos = root.Position
			local targetSetting = Options.CamlockTarget and Options.CamlockTarget.Value or "All"
			local camlockPriority = (Options.CamlockPriority and Options.CamlockPriority.Value) or "Normal"
			-- Ignoring teammates is built in for Camlock (no checkbox).
			local ignoreTeam = true
			local ignoreAlly = Toggles.CamlockIgnoreAlly and Toggles.CamlockIgnoreAlly.Value
			local excludedTeams = Options.CamlockIgnoreTeams and Options.CamlockIgnoreTeams.Value or {}

			local function isExcludedTeam(p)
				if not ignoreAlly then return false end
				if not p or not p.Team then return false end
				local teamName = p.Team.Name
				if not teamName then return false end
				if typeof(excludedTeams) == "table" then
					for name, selected in pairs(excludedTeams) do
						if selected == true and name == teamName then
							return true
						end
					end
				end
				return false
			end

			local function isSameTeamOnly(p)
				if LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then
					return true
				end
				if LocalPlayer.TeamColor and p.TeamColor and LocalPlayer.TeamColor == p.TeamColor and LocalPlayer.TeamColor ~= BrickColor.new("White") then
					return true
				end
				return false
			end

			local function camlockTargetValid(p)
				if not p or p == LocalPlayer then return false end
				if isCamlockBlacklisted(p) then return false end
				local c = p.Character
				if not c then return false end
				if ignoreTeam and isSameTeamOnly(p) then return false end
				if isExcludedTeam(p) then return false end
				if targetSetting ~= "All" and p.Name ~= targetSetting then return false end
				local otherRoot = c:FindFirstChild("HumanoidRootPart")
				local otherHum = c:FindFirstChildOfClass("Humanoid")
				if not (otherRoot and otherHum and otherHum.Health > 0) then return false end
				return true, otherRoot
			end

			-- Drop a cached target that died, left, or walked out of range.
			if camlockTarget then
				local ok, otherRoot = camlockTargetValid(camlockTarget)
				if not ok or (otherRoot.Position - myPos).Magnitude > maxDist then
					camlockTarget = nil
				end
			end

			-- Re-pick the closest valid target a few times per second instead of
			-- every frame; only the camera lock needs to run every frame.
			local camlockNow = os.clock()
			if not camlockTarget or camlockNow >= camlockNextPick then
				camlockNextPick = camlockNow + 0.1
				local bestPlayer, bestDist, bestHealth, bestScore = nil, math.huge, nil, -math.huge
				for _, otherPlayer in ipairs(camlockPlayers) do
					local ok, otherRoot = camlockTargetValid(otherPlayer)
					if ok then
						local dist = (otherRoot.Position - myPos).Magnitude
						if dist <= maxDist then
							if camlockPriority == "Lowest HP Kill" or camlockPriority == "Highest HP Kill" then
								local hum = otherPlayer.Character and otherPlayer.Character:FindFirstChildOfClass("Humanoid")
								local hp = hum and hum.Health or math.huge
								if bestPlayer == nil
									or (camlockPriority == "Lowest HP Kill" and hp < bestHealth)
									or (camlockPriority == "Highest HP Kill" and hp > bestHealth) then
									bestPlayer, bestHealth = otherPlayer, hp
								end
							elseif camlockPriority == "Closest to Crosshair" then
								-- Highest dot product with the camera's look vector
								-- means the player is nearest the screen centre.
								local cam = workspace.CurrentCamera
								if cam then
									local toTarget = otherRoot.Position - cam.CFrame.Position
									if toTarget.Magnitude > 0.001 then
										local score = cam.CFrame.LookVector:Dot(toTarget.Unit)
										if bestPlayer == nil or score > bestScore then
											bestPlayer, bestScore = otherPlayer, score
										end
									end
								end
							elseif dist < bestDist then
								bestDist = dist
								bestPlayer = otherPlayer
							end
						end
					end
				end
				camlockTarget = bestPlayer
			end

			local closestPlayer = camlockTarget

			-- Outline: Stop player from getting closer than studs to players while using Camlock
			local outlineActive = (Toggles.Outline and Toggles.Outline.Value) or (Toggles.Cutline and Toggles.Cutline.Value)
			local minOutlineStuds = (Options.OutlineStuds and Options.OutlineStuds.Value) or (Options.CutlineStuds and Options.CutlineStuds.Value) or 7

			if outlineActive and not inWater then
				local outlineTargetSetting = (Options.OutlineTarget and Options.OutlineTarget.Value) or "All"
				for _, otherPlayer in ipairs(camlockPlayers) do
					if otherPlayer ~= LocalPlayer and otherPlayer.Character then
						if (not ignoreTeam or not isSameTeamOnly(otherPlayer)) and not isExcludedTeam(otherPlayer) then
							local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
							local otherHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
							if otherRoot and otherHum and otherHum.Health > 0 then
								if outlineTargetSetting == "All" or otherPlayer.Name == outlineTargetSetting then
									local otherPos = otherRoot.Position
									local offset = myPos - otherPos
									local flatOffset = Vector3.new(offset.X, 0, offset.Z)
									local flatDist = flatOffset.Magnitude

									if flatDist < minOutlineStuds then
										local pushDir
										if flatDist > 0.001 then
											pushDir = flatOffset.Unit
										else
											local backDir = -root.CFrame.LookVector
											local flatBack = Vector3.new(backDir.X, 0, backDir.Z)
											pushDir = flatBack.Magnitude > 0.001 and flatBack.Unit or Vector3.new(0, 0, 1)
										end

										myPos = Vector3.new(
											otherPos.X + pushDir.X * minOutlineStuds,
											myPos.Y,
											otherPos.Z + pushDir.Z * minOutlineStuds
										)

										pcall(function()
											local vel = root.AssemblyLinearVelocity or root.Velocity
											if vel then
												local moveTowards = vel.X * (-pushDir.X) + vel.Z * (-pushDir.Z)
												if moveTowards > 0 then
													local correctedVel = Vector3.new(
														vel.X - (-pushDir.X * moveTowards),
														vel.Y,
														vel.Z - (-pushDir.Z * moveTowards)
													)
													root.AssemblyLinearVelocity = correctedVel
													root.Velocity = correctedVel
												end
											end
										end)
									end
								end
							end
						end
					end
				end
			end

			-- Slight Pull In at 8 studs: Gently pulls forward into outline distance (never closer than outline)
			local isPullActive = (Toggles.CamlockPull and Toggles.CamlockPull.Value) or false
			if isPullActive and closestPlayer and closestPlayer.Character and not inWater then
				local targetRoot = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
				if targetRoot then
					local targetPos = targetRoot.Position
					local offset = targetPos - myPos
					local flatOffset = Vector3.new(offset.X, 0, offset.Z)
					local currentDist = flatOffset.Magnitude

					local pullTriggerDist = (Options.CamlockPullDist and Options.CamlockPullDist.Value) or 8
					local stopBoundary = outlineActive and minOutlineStuds or 7

					local pullDir = flatOffset.Magnitude > 0.0001 and flatOffset.Unit or Vector3.zero

					-- Check if the player is actively trying to move / pull away from the target
					local isMovingAway = false
					if hum and hum.MoveDirection.Magnitude > 0.05 then
						if hum.MoveDirection:Dot(pullDir) < -0.05 then
							isMovingAway = true
						end
					end
					if not isMovingAway and (UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)) then
						isMovingAway = true
					end

					local pullStrength = (Options.CamlockPullStrength and Options.CamlockPullStrength.Value) or 5
					local maxStep = pullStrength * 0.08
					local velMag = pullStrength * 2.8

					if not isMovingAway and currentDist <= pullTriggerDist and currentDist > stopBoundary then
						local pullStep = math.min(currentDist - stopBoundary, maxStep)
						myPos = Vector3.new(
							myPos.X + pullDir.X * pullStep,
							myPos.Y,
							myPos.Z + pullDir.Z * pullStep
						)

						pcall(function()
							local maxVelAllowed = math.max(0, (currentDist - stopBoundary)) / 0.016
							local safeVelMag = math.min(velMag, maxVelAllowed)
							local pullVel = pullDir * safeVelMag
							local curVel = root.AssemblyLinearVelocity or root.Velocity or Vector3.zero
							local flatCur = Vector3.new(curVel.X, 0, curVel.Z)
							local curTowards = flatCur:Dot(pullDir)
							local desiredTowards = math.max(curTowards, safeVelMag)
							local deltaTowards = desiredTowards - curTowards
							local newFlat = flatCur + pullDir * deltaTowards
							local newVel = Vector3.new(newFlat.X, curVel.Y, newFlat.Z)
							root.AssemblyLinearVelocity = newVel
							root.Velocity = newVel
						end)
					elseif currentDist <= stopBoundary and pullDir.Magnitude > 0 then
						pcall(function()
							local curVel = root.AssemblyLinearVelocity or root.Velocity or Vector3.zero
							local flatCur = Vector3.new(curVel.X, 0, curVel.Z)
							local curTowards = flatCur:Dot(pullDir)
							if curTowards > 0 then
								local newFlat = flatCur - pullDir * curTowards
								local newVel = Vector3.new(newFlat.X, curVel.Y, newFlat.Z)
								root.AssemblyLinearVelocity = newVel
								root.Velocity = newVel
							end
						end)
					end
				end
			end

			if closestPlayer then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
				UserInputService.MouseIconEnabled = false

				local targetRoot = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
				if targetRoot then
					local targetPos = targetRoot.Position
					local lookDir = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z).Unit
					if lookDir.Magnitude > 0 and not inWater then
						hum.AutoRotate = false

						-- Smoothly rotate the body toward the target instead of snapping
						-- instantly, so the turn looks natural.
						local curLook = root.CFrame.LookVector
						local curYaw = math.atan2(-curLook.X, -curLook.Z)
						local flatDir = Vector3.new(lookDir.X, 0, lookDir.Z)
						if flatDir.Magnitude > 0.001 then
							local targetYaw = math.atan2(-flatDir.X, -flatDir.Z)
							local yawDelta = ((targetYaw - curYaw + math.pi) % (2 * math.pi)) - math.pi
							local turnSpeed = (Options.CamlockTurnSmoothness and Options.CamlockTurnSmoothness.Value) or 0.2
							local turnAlpha = 1 - math.exp(-math.clamp(turnSpeed, 0.01, 1) * 60 * dt)
							local newYaw = curYaw + yawDelta * turnAlpha
							root.CFrame = CFrame.new(myPos) * CFrame.Angles(0, newYaw, 0)
						else
							root.CFrame = CFrame.new(myPos) * CFrame.Angles(0, curYaw, 0)
						end
					elseif not inWater then
						root.CFrame = CFrame.new(myPos, myPos + root.CFrame.LookVector)
					end

					-- True Camera Interpolation (Smooth Lerp). In water this always
					-- runs, since the body can't be turned to aim anymore.
					if inWater or (Toggles.CamlockCameraLerp and Toggles.CamlockCameraLerp.Value) then
						local camera = workspace.CurrentCamera
						if camera then
							local aimPartName = (Options.CamlockAimPart and Options.CamlockAimPart.Value) or "Head"
							local aimPart = closestPlayer.Character:FindFirstChild(aimPartName) or closestPlayer.Character:FindFirstChild("HumanoidRootPart") or targetRoot
							if aimPart then
								local aimPos = aimPart.Position
								-- Aim Prediction is built in (2) and Vertical Offset is 0,
								-- so neither is exposed as a slider anymore.
								local targetVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
								aimPos = aimPos + (targetVel * 0.2)
								local smoothness = (Options.CamlockSmoothness and Options.CamlockSmoothness.Value) or 0.2
								local lerpFactor = math.clamp(smoothness, 0.01, 1)

								-- In water the lock is a pure aimbot: the camera follows the
								-- target on both axes, so Free Pitch is ignored there.
								if Toggles.CamlockFreePitch and Toggles.CamlockFreePitch.Value and not inWater then
									-- Allow Look Down: interpolate only the yaw (horizontal aim) toward
									-- the target so the player keeps full vertical (pitch) control
									local curCF = camera.CFrame
									local look = curCF.LookVector
									local curYaw = math.atan2(-look.X, -look.Z)
									local curPitch = math.asin(math.clamp(look.Y, -1, 1))

									local toTarget = aimPos - curCF.Position
									local flatDir = Vector3.new(toTarget.X, 0, toTarget.Z)
									if flatDir.Magnitude > 0.001 then
										local targetYaw = math.atan2(-flatDir.X, -flatDir.Z)
										local yawDelta = ((targetYaw - curYaw + math.pi) % (2 * math.pi)) - math.pi
										local newYaw = curYaw + (yawDelta * lerpFactor)
										camera.CFrame = CFrame.new(curCF.Position) * CFrame.fromOrientation(curPitch, newYaw, 0)
									end
								else
									-- Default lock: the camera fully follows the target (pitch included)
									local desiredCF = CFrame.new(camera.CFrame.Position, aimPos)
									camera.CFrame = camera.CFrame:Lerp(desiredCF, lerpFactor)
								end
							end
						end
					end
				end
			else
				-- In water the shiftlock is kept even with no target: the mouse stays
				-- locked to the centre, while the body is left completely free.
				UserInputService.MouseBehavior = inWater and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = not inWater
				hum.AutoRotate = true
				if outlineActive and not inWater and (root.Position - myPos).Magnitude > 0.01 then
					root.CFrame = CFrame.new(myPos, myPos + root.CFrame.LookVector)
				end
			end
		end))
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		local hum = getHumanoid()
		if hum then
			hum.AutoRotate = true
		end
	end
end)

