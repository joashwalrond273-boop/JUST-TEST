local touchFlingActive = false
local function touchFlingLoop()
	local movel = 0.1
	while touchFlingActive and Toggles.TouchFling.Value do
		RunService.Heartbeat:Wait()
		if not touchFlingActive then break end
		local c = LocalPlayer.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if hrp then
			local power = (Options.TouchFlingPower and Options.TouchFlingPower.Value) or 100
			local vel = hrp.Velocity
			hrp.Velocity = vel * power + Vector3.new(0, power, 0)
			RunService.RenderStepped:Wait()
			if not touchFlingActive then break end
			hrp.Velocity = vel
			RunService.Stepped:Wait()
			if not touchFlingActive then break end
			hrp.Velocity = vel + Vector3.new(0, movel, 0)
			movel = -movel
		end
	end

	-- Cancel any leftover fling velocity so disabling never launches the player
	local c = LocalPlayer.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end

