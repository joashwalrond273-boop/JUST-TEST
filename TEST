TeleportGroup:AddButton({
	Text = "Teleport",
	Func = function()
		local player = game.Players.LocalPlayer
		local savedName = Options.TeleportPlayerList.Value

		local function notify(title, content, duration)
			if Fluent and Fluent.Notify then
				Fluent:Notify({ Title = title, Content = content, Duration = duration })
			elseif Library and Library.Notify then
				Library:Notify({ Title = title, Description = content, Time = duration })
			end
		end

		if savedName == "" or not savedName then
			notify("Tp Error", "Write a player name.", 5)
			return
		end

		local matchedPlayers = {}

		for _, targetPlayer in ipairs(TSG_PlayerList) do
			if targetPlayer ~= player and (targetPlayer.Name:lower():sub(1, #savedName) == savedName:lower() or targetPlayer.DisplayName:lower():sub(1, #savedName) == savedName:lower()) then
				table.insert(matchedPlayers, targetPlayer)
			end
		end

		if #matchedPlayers == 0 then
			notify("Tp Error", "This player cant found on the server.", 5)
			return
		elseif #matchedPlayers > 1 then
			notify("Tp Error", "There is multiple players with the same name.", 5)
			return
		end

		local targetPlayer = matchedPlayers[1]

		-- With StreamingEnabled the target's character may not be replicated to us
		-- yet (very common right after joining / when the target is far away).
		-- Wait a moment for it to stream in before giving up.
		local targetCharacter = targetPlayer.Character
		local waitStart = tick()
		while tick() - waitStart < 3 do
			targetCharacter = targetPlayer.Character
			if targetCharacter and targetCharacter:FindFirstChild("Humanoid") and targetCharacter:FindFirstChild("HumanoidRootPart") then
				break
			end
			task.wait(0.1)
		end

		if not targetCharacter or not targetCharacter:FindFirstChild("Humanoid") or targetCharacter:FindFirstChild("Humanoid").Health <= 0 then
			notify("Tp Error", "Player not loaded on your client yet (streaming). Get closer or retry.", 5)
			return
		end

		resetAndTeleport(function()
			local char = targetPlayer.Character
			if not char then return nil end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChild("Humanoid")
			if not hrp or not hum or hum.Health <= 0 then return nil end
			local targetCFrame = hrp.CFrame
			local dist = (Options.TeleportOffsetStuds and Options.TeleportOffsetStuds.Value) or 30
			local side = (Options.TeleportDirection and Options.TeleportDirection.Value) or "Behind"

			-- Direction from the target towards where we want to spawn
			local offsetDir
			if side == "Front" then
				offsetDir = targetCFrame.LookVector
			elseif side == "Left" then
				offsetDir = -targetCFrame.RightVector
			elseif side == "Right" then
				offsetDir = targetCFrame.RightVector
			else
				offsetDir = -targetCFrame.LookVector
			end

			local offsetPos = targetCFrame.Position + offsetDir * dist
			-- Face the target (works even when Spawn Distance is 0)
			return CFrame.new(offsetPos, offsetPos - offsetDir)
		end, targetPlayer.Name)
	end,
})

