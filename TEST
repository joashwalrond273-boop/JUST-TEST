		if broken and not wasBroken then
			wasBroken = true
			Library:Notify({ Title = "Shield Notifier", Description = "Shield broke - recharging", Time = 3 })
		elseif (not broken) and wasBroken then
			wasBroken = false
			Library:Notify({ Title = "Shield Notifier", Description = "Shield ready", Time = 2 })
		end
	end))

	Library:Notify({ Title = "Shield Notifier", Description = "Enabled", Time = 2 })
end)

-- Auto Shield: the shield stays down so you attack freely, and is raised only
-- when an enemy within Parry Distance starts an attack. The game's own posture
-- break (shieldReload) tells us the shield just broke and how long it recharges
-- for, so the shield stays down for that window instead of being spammed.
do
	local parryHolding = false
	local parryUntil = 0
	local parrySwingStart = 0
	local lastParryFire = 0

	local function getParryDistance()
		return (Options.ShieldParryStuds and Options.ShieldParryStuds.Value) or 12
	end

	local function getPostureBreakTime()
		local id = GetHeldToolId()
		local items = TSG.Items
		if id and items and items.getItemData then
			local ok, data = pcall(items.getItemData, id)
			if ok and data and data.PostureBreakTime then
				return data.PostureBreakTime
			end
		end
		return 0.6
	end

	local function parryDrop()
		if parryHolding then
			parryHolding = false
			FireSetShield(false)
		end
	end

	-- Parry Punish: the moment our guard posture breaks (shieldReload) we drop
	-- the shield and swing into the enemy's recovery, then Auto Shield re-raises
	-- the shield once the recharge window ends (block -> punish -> block).
	local punishUntil = 0
	local punishSwinging = false

	local function triggerParryPunish(window)
		if not (Toggles.ShieldParryPunish and Toggles.ShieldParryPunish.Value) then return end
		if not parryHolding then return end
		parryDrop()
		local endAt = tick() + math.clamp(window, 0.2, 1.5)
		punishUntil = endAt
		if punishSwinging then return end
		punishSwinging = true
		task.spawn(function()
			while tick() < endAt do
				if not (Toggles.ShieldAutoParry and Toggles.ShieldAutoParry.Value) then break end
				if not isAlive() then break end
				local character = getCharacter()
				local tool = character and character:FindFirstChildOfClass("Tool")
				if tool then
					pcall(function() tool:Activate() end)
				end
				task.wait(0.15)
			end
			punishSwinging = false
		end)
	end

	local function isEnemySwinging(character, myPos, maxDist)
		local root = character:FindFirstChild("HumanoidRootPart")
		local hum = character:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then return false end
		if (root.Position - myPos).Magnitude > maxDist then return false end
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then return false end
		for _, trackObj in ipairs(animator:GetPlayingAnimationTracks()) do
			if trackObj.Speed > 0 and isSwingAnimation(trackObj) then
				return true
			end
		end
		return false
	end

	-- shieldReload = the shield broke and is recharging; it carries a multiplier
	-- on the weapon's PostureBreakTime. Stay down for that whole window, flag it
	-- for the HUD, and run Parry Punish if enabled.
	if TSG.ShieldReloadRemote then
		TSG.ShieldReloadRemote.OnClientEvent:Connect(function(multiplier)
			local mult = tonumber(multiplier) or 1
			local window = math.max(0.1, getPostureBreakTime() * mult)
			ShieldParryBreakUntil = tick() + window
			ShieldBreakStamp = tick()
			ShieldHudBlocks = (ShieldHudBlocks or 0) + 1
			triggerParryPunish(window)
		end)
	end

	-- Every blocked hit feeds the HUD's block counter.
	if TSG.ShieldHitRemote then
		TSG.ShieldHitRemote.OnClientEvent:Connect(function()
			ShieldHudBlocks = (ShieldHudBlocks or 0) + 1
		end)
	end

	local function updateShieldSystemVisibility()
		local autoShield = (Toggles.ShieldAutoParry and Toggles.ShieldAutoParry.Value) or false
		local customRefire = (Toggles.ShieldCustomRefire and Toggles.ShieldCustomRefire.Value) or false

		local function setVisible(option, visible)
			if not option then return end
			if option.Visible ~= nil then
				option.Visible = visible
			end
			if option.Holder then
				option.Holder.Visible = visible
			end
		end

		setVisible(Options.ShieldParryStuds, autoShield)
		setVisible(Options.ShieldParryLead, autoShield)
		setVisible(Options.ShieldParryHold, autoShield)
		setVisible(Toggles.ShieldParryPunish, autoShield)
		setVisible(Options.ShieldDamageRefire, customRefire)
		if CombatShieldSystem and CombatShieldSystem.Resize then
			CombatShieldSystem:Resize()
		end
		if ShieldSystemTabBox and ShieldSystemTabBox.Resize then
			ShieldSystemTabBox:Resize()
		end
	end

	local function updateAutoParry()
		if not (Toggles.ShieldAutoParry and Toggles.ShieldAutoParry.Value) then return end
		if not isAlive() then
			parryDrop()
			return
		end

		local now = tick()

		-- Shield is recharging (posture broken), we just took a hit, or Parry
		-- Punish is still swinging: stay down.
		if now < ShieldParryBreakUntil or now < ShieldAnimBreakUntil or now < punishUntil then
			parryDrop()
			return
		end

		local character = getCharacter()
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			parryDrop()
			return
		end

		local threat = false
		local maxDist = getParryDistance()
		for _, player in ipairs(TSG_PlayerList) do
			if player ~= LocalPlayer and player.Character and not isTeammate(player) then
				if isEnemySwinging(player.Character, root.Position, maxDist) then
					threat = true
					break
				end
			end
		end

		-- Block Lead: hold off raising the shield for this long after the swing is
		-- first seen, so the block lands on the strike rather than the windup.
		-- 0 reproduces the old raise-on-sight behaviour.
		if threat then
			if parrySwingStart == 0 then
				parrySwingStart = now
			end
		else
			parrySwingStart = 0
		end

		local lead = (Options.ShieldParryLead and Options.ShieldParryLead.Value) or 0
		local hold = (Options.ShieldParryHold and Options.ShieldParryHold.Value) or 0.35

		-- Refreshing while the attack is still landing keeps the guard up across a
		-- combo instead of dropping it between two swings.
		if threat and now >= parrySwingStart + lead then
			parryUntil = now + hold
		end

		if now < parryUntil then
			if not parryHolding or now - lastParryFire >= 0.15 then
				parryHolding = true
				lastParryFire = now
				FireSetShield(true)
			end
		else
			parryDrop()
		end
	end

	Toggles.ShieldAutoParry:OnChanged(function()
		disconnect("ShieldAutoParry_Loop")
		disconnect("ShieldAutoParry_CharacterAdded")
		parryDrop()
		parryUntil = 0
		parrySwingStart = 0
		punishUntil = 0

		updateShieldSystemVisibility()

		if not Toggles.ShieldAutoParry.Value then return end

		track("ShieldAutoParry_CharacterAdded", LocalPlayer.CharacterAdded:Connect(function()
			parryDrop()
			parryUntil = 0
			parrySwingStart = 0
		end))
		track("ShieldAutoParry_Loop", RunService.Heartbeat:Connect(updateAutoParry))
	end)

	if Toggles.ShieldCustomRefire then
		Toggles.ShieldCustomRefire:OnChanged(function()
			updateShieldSystemVisibility()
		end)
	end

	updateShieldSystemVisibility()
end

