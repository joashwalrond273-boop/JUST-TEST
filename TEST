	if not sinkOn and not riseOn then
		return
	end

	-- The first 1.5s of a sink/rise is deliberately gentle, then it switches to
	-- whatever the Fast PVP Speed slider is set to. The timers reset as soon as
	-- you stop looking down/up (or leave the water), so each dive ramps again.
	local RAMP_TIME = 1.5
	local RAMP_SPEED = 8
	local sinkStart = nil
	local riseStart = nil

	track("FastPVP", RunService.Heartbeat:Connect(function()
		local character = getCharacter()
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid then
			local isSwimming = humanoid:GetState() == Enum.HumanoidStateType.Swimming or character:GetAttribute("inWater")
			if isSwimming then
				local cam = workspace.CurrentCamera
				local lookY = cam and cam.CFrame.LookVector.Y or 0
				local speed = (Options.FastPVPSpeed and Options.FastPVPSpeed.Value) or 60
				local now = tick()

				if sinkOn and lookY <= -0.9 then
					if not sinkStart then
						sinkStart = now
					end
					local vel = math.min(speed, RAMP_SPEED)
					if now - sinkStart >= RAMP_TIME then
						vel = speed
					end
					root.AssemblyLinearVelocity = Vector3.new(
						root.AssemblyLinearVelocity.X,
						-vel,
						root.AssemblyLinearVelocity.Z
					)
				else
					sinkStart = nil
				end

				if riseOn and lookY >= 0.85 then
					if not riseStart then
						riseStart = now
					end
					local vel = math.min(speed, RAMP_SPEED)
					if now - riseStart >= RAMP_TIME then
						vel = speed
					end
					root.AssemblyLinearVelocity = Vector3.new(
						root.AssemblyLinearVelocity.X,
						vel,
						root.AssemblyLinearVelocity.Z
					)
				else
					riseStart = nil
				end
			else
				sinkStart = nil
				riseStart = nil
			end
		end
	end))
end)

