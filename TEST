do
	local PARTICLE_CLASSES = {
		ParticleEmitter = true,
		Fire = true,
		Smoke = true,
		Sparkles = true,
		Trail = true,
		Beam = true,
	}

	local originalStates = setmetatable({}, { __mode = "k" })

	local function disableParticle(v)
		if not v or not PARTICLE_CLASSES[v.ClassName] then return end

		if originalStates[v] == nil then
			originalStates[v] = {
				Enabled = v.Enabled,
				Rate = v:IsA("ParticleEmitter") and v.Rate or nil,
			}
		end

		pcall(function()
			v.Enabled = false
			if v:IsA("ParticleEmitter") then
				v.Rate = 0
				v:Clear()
			end
		end)
	end

	TSG_AntiLagGroup:AddCheckbox("RemoveParticles", {
		Text = "Remove Particles",
		Default = false,
		Callback = function(state)
			-- Hit effects are particle based; Remove Particles would hide them.
			if state and isHitEffectActive and isHitEffectActive() then
				Toggles.RemoveParticles:SetValue(false)
				Library:Notify({
					Title = "Remove Particles",
					Description = "Set your Hit Effect to None first.",
					Time = 3,
				})
				return
			end

			disconnect("RemoveParticles_Workspace")
			disconnect("RemoveParticles_Lighting")

			if state then
				-- Process workspace & lighting smoothly in chunks without freeze/stutter
				task.spawn(function()
					local containers = { workspace, game:GetService("Lighting") }
					for _, container in ipairs(containers) do
						local descendants = container:GetDescendants()
						for i = 1, #descendants do
							if not (Toggles.RemoveParticles and Toggles.RemoveParticles.Value) then break end
							local v = descendants[i]
							if v and v.Parent and PARTICLE_CLASSES[v.ClassName] then
								disableParticle(v)
							end
							if i % 300 == 0 then
								task.wait()
							end
						end
					end
				end)

				-- Direct fast class check without spawning leaking sub-connections per instance
				track("RemoveParticles_Workspace", workspace.DescendantAdded:Connect(function(v)
					if Toggles.RemoveParticles and Toggles.RemoveParticles.Value and PARTICLE_CLASSES[v.ClassName] then
						disableParticle(v)
					end
				end))

				track("RemoveParticles_Lighting", game:GetService("Lighting").ChildAdded:Connect(function(v)
					if Toggles.RemoveParticles and Toggles.RemoveParticles.Value and PARTICLE_CLASSES[v.ClassName] then
						disableParticle(v)
					end
				end))

				Library:Notify({ Title = "Remove Particles", Description = "Enabled", Time = 2 })
			else
				for v, stateInfo in pairs(originalStates) do
					if v and v.Parent then
						pcall(function()
							if stateInfo.Enabled ~= nil then
								v.Enabled = stateInfo.Enabled
							end
							if stateInfo.Rate ~= nil and v:IsA("ParticleEmitter") then
								v.Rate = stateInfo.Rate
							end
						end)
					end
				end
				table.clear(originalStates)
				Library:Notify({ Title = "Remove Particles", Description = "Disabled", Time = 2 })
			end
		end,
	})
end

do
	local HEAVY_POST_CLASSES = {
		DepthOfFieldEffect = true,
		SunRaysEffect = true,
		BloomEffect = true,
		ColorCorrectionEffect = true,
		MotionBlurEffect = true,
	}
	local originalPostEnabled = setmetatable({}, { __mode = "k" })
	local postPropConnections = {}

	local function isHeavyPost(v)
		return v and HEAVY_POST_CLASSES[v.ClassName]
	end

	local function disablePost(v)
		if not isHeavyPost(v) then return end
		if originalPostEnabled[v] == nil then
			originalPostEnabled[v] = v.Enabled
		end
		pcall(function() v.Enabled = false end)
		local conn = v:GetPropertyChangedSignal("Enabled"):Connect(function()
			if Toggles.KillHeavyPostEffects and Toggles.KillHeavyPostEffects.Value and v.Enabled then
				pcall(function() v.Enabled = false end)
			end
		end)
		table.insert(postPropConnections, conn)
	end

	local function restorePost(v)
		if not isHeavyPost(v) then return end
		local original = originalPostEnabled[v]
		if original ~= nil then
			pcall(function() v.Enabled = original end)
		end
	end

	TSG_AntiLagGroup:AddCheckbox("KillHeavyPostEffects", {
		Text = "Kill Heavy Post FX",
		Default = false,
		Callback = function(state)
			disconnect("KillHeavyPostEffects_ChildAdded")
			for _, conn in ipairs(postPropConnections) do
				pcall(function() conn:Disconnect() end)
			end
			table.clear(postPropConnections)

			local Lighting = game:GetService("Lighting")

			if state then
				local children = nil
				pcall(function() children = Lighting:GetChildren() end)
				if children then
					for _, v in ipairs(children) do
						disablePost(v)
					end
				end

				track("KillHeavyPostEffects_ChildAdded", Lighting.ChildAdded:Connect(function(child)
					if Toggles.KillHeavyPostEffects and Toggles.KillHeavyPostEffects.Value then
						task.defer(function() disablePost(child) end)
					end
				end))

				Library:Notify({ Title = "Kill Heavy Post FX", Description = "Enabled", Time = 2 })
			else
				local children = nil
				pcall(function() children = Lighting:GetChildren() end)
				if children then
					for _, v in ipairs(children) do
						restorePost(v)
					end
				end
				table.clear(originalPostEnabled)
				Library:Notify({ Title = "Kill Heavy Post FX", Description = "Disabled", Time = 2 })
			end
		end,
	})
end

-- Drop render quality to the lowest preset for a large GPU saving
do
	local qualityOriginal = nil
	local meshOriginal = nil

	TSG_AntiLagGroup:AddCheckbox("LowQualityLevel", {
		Text = "Low Quality Level",
		Default = false,
		Callback = function(state)
			pcall(function()
				if state then
					if qualityOriginal == nil then
						qualityOriginal = settings().Rendering.QualityLevel
					end
					if meshOriginal == nil then
						meshOriginal = settings().Rendering.MeshPartDetailLevel
					end
					-- Level01 is the minimum QualityLevel; also drop mesh LOD to its
					-- lowest so the GPU/CPU cost goes below what Level01 alone allows.
					settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
					settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level00
				else
					settings().Rendering.QualityLevel = qualityOriginal or Enum.QualityLevel.Automatic
					settings().Rendering.MeshPartDetailLevel = meshOriginal or Enum.MeshPartDetailLevel.Automatic
					qualityOriginal = nil
					meshOriginal = nil
				end
			end)
		end,
	})
end

-- Remote spam filter. A client can only intercept remote calls made from its own
-- VM (for example another script running in the same executor); calls that leave
-- someone else's machine for the server are never visible to us. So this caps
-- runaway FireServer/InvokeServer spam per remote and drops the excess.
-- Globals on purpose: the main chunk is at Luau's 200-local register limit.
TSG_RemoteSpamWindow = {}
TSG_RemoteSpamLimit = 150

-- Called as handler(previous, ...). Registered with the shared dispatcher only
-- while the checkbox is on, so it is never chained on top of the other hooks.
function TSG_RemoteSpamHook(previous, ...)
	local self = ...
	local method = getnamecallmethod()

	if method == "FireServer" or method == "InvokeServer" then
		local now = tick()
		local entry = TSG_RemoteSpamWindow[self]
		if not entry or now - entry.t > 1 then
			TSG_RemoteSpamWindow[self] = { t = now, n = 1 }
		else
			entry.n = entry.n + 1
			if entry.n > TSG_RemoteSpamLimit then
				return nil
			end
		end
	end

	return previous(...)
end

TSG_AntiLagGroup:AddCheckbox("BlockRemoteSpam", {
	Text = "Block Remote Spam",
	Default = false,
	Callback = function(state)
		if state then
			TSG_AddNamecallHook(TSG_RemoteSpamHook)
		else
			TSG_RemoveNamecallHook(TSG_RemoteSpamHook)
		end
	end,
})

