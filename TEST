-- Node Name Filter for the auto farms. The filter comes from a multi dropdown,
-- so its value is a table of selected node names: a node matches when its name
-- is one of the picks, and an empty pick list means "no filter" (farm them all).
-- A plain string is also accepted as a comma-separated list, matched as a
-- substring. Kept global on purpose: the main chunk is at Luau's 200-local limit.
function resourceNameMatches(obj, filterValue)
	local name = obj and obj.Name
	if not name or name == "" then return false end

	if type(filterValue) == "table" then
		local any = false
		for selected in pairs(filterValue) do
			any = true
			if selected == name then return true end
		end
		return not any
	end

	if filterValue == nil or filterValue == "" then return true end
	local lowered = string.lower(name)
	for token in string.gmatch(string.lower(tostring(filterValue)), "[^,]+") do
		local needle = string.match(token, "^%s*(.-)%s*$")
		if needle ~= "" and string.find(lowered, needle, 1, true) then
			return true
		end
	end
	return false
end

local function mineObject(obj)
	local slot = tonumber(Options.AutoMineSlot.Value) or 1
	local anchor = obj and getMineableAnchor(obj)
	if anchor then
		pcall(function()
			TSG.MineRemote:FireServer(slot, obj, CFrame.new(anchor.Position))
		end)
	end
end

local function autoMine()
	if not isAlive() or not isAutoMineRunning then return end
	local mineSpeed = (Options.AutoMineSpeed and Options.AutoMineSpeed.Value) or 5
	local mineCooldown = 1 / math.max(0.1, mineSpeed)
	if tick() - lastAutoMineHit < mineCooldown then return end

	local root = getRootPart()
	if not root then return end
	local maxRange = (Options.AutoMineRange and Options.AutoMineRange.Value) or 30
	local nameFilter = Options.AutoMineNameFilter and Options.AutoMineNameFilter.Value or ""
	local closest, dist = nil, maxRange
	forEachResourceNode(getMineableFolder(), function(obj)
		if not resourceNameMatches(obj, nameFilter) then return end
		local anchor = getMineableAnchor(obj)
		if anchor then
			local d = (root.Position - anchor.Position).Magnitude
			if d < dist then
				closest, dist = obj, d
			end
		end
	end)
	if closest then
		lastAutoMineHit = tick()
		mineObject(closest)
	end
end

