	track("AdminJoinNotify", Players.PlayerAdded:Connect(function(plr)
		if isAdmin(plr) then
			local adminName = getAdminName(plr)
			Library:Notify({ Title = "ADMIN JOINED", Description = adminName .. " joined the server!", Time = 5 })
			if Toggles.ServerHopOnAdmin and Toggles.ServerHopOnAdmin.Value then
