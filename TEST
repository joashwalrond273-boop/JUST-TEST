-- Collect a hover position for every node of the given name. anchorFor resolves
-- the part to stand near and hover is the extra height above it.
function collectResourcePositions(folder, name, anchorFor, hover)
	local positions = {}
	forEachResourceNode(folder, function(obj)
		if obj.Name == name then
			local part = anchorFor(obj)
			if part then
				table.insert(positions, part.Position + Vector3.new(0, part.Size.Y / 2 + (hover or 5), 0))
			end
		end
	end)
	return positions
end

