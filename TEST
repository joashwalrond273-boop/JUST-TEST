-- Shield Animation: replays the game's built-in shield hold poses, taken from
-- PlayerScripts.shield (HoldShield + HoldKatanaShield), as a visual only. It is
-- driven by Auto Shield: every setShield fire raises/lowers the pose.
-- Getting hit while shielding drops the pose and holds the shield down for the
-- Shield Refire delay. Swinging hides the pose briefly so the attack animation
-- shows; Auto Swing stays paused while the shield is up. The pose only shows
-- while a Samurai Sword (406) or Juggernaut Sword (545) is held. State lives in
-- globals to stay under the main chunk's local limit.
ShieldAnimObjects = nil
ShieldAnimTracks = nil
ShieldAnimHeld = false
-- The pose stays off until this timestamp after taking a hit (Shield Refire delay).
ShieldAnimBreakUntil = 0
ShieldAnimLastHealth = nil
-- While swinging, the pose hides so the attack animation shows.
ShieldAnimSwingUntil = 0

-- Auto Shield: the shield stays down until an enemy swings, and the game's own
-- posture break (shieldReload) keeps it down while the shield recharges.
ShieldParryBreakUntil = 0

-- Shield HUD 2.0 state: blocked-hit counter (fed by shieldHit) and the moment
-- the guard last broke, so the HUD can flash BREAK before RECHARGING.
ShieldHudBlocks = 0
ShieldBreakStamp = 0

-- Only these swords show the pose.
ShieldAnimSwordIds = { [406] = true, [545] = true }

function GetShieldAnimationObjects()
	if ShieldAnimObjects then return ShieldAnimObjects end
	local ps = LocalPlayer:FindFirstChild("PlayerScripts")
	if not ps then return nil end
	local objects = {}
	for _, name in ipairs({ "HoldShield", "HoldKatanaShield" }) do
		local anim = ps:FindFirstChild(name, true)
		if anim and anim:IsA("Animation") then
			table.insert(objects, anim)
		end
	end
	if #objects == 0 then return nil end
	ShieldAnimObjects = objects
	return objects
end

function GetHeldToolId()
	local id = tonumber(LocalPlayer:GetAttribute("equippedTool"))
	if id then return id end
	local character = LocalPlayer.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool then return nil end
	local toolModel = tool:FindFirstChild("toolModel")
	if toolModel then
		id = tonumber(toolModel:GetAttribute("itemId") or toolModel:GetAttribute("id"))
	end
	if id then return id end
	return tonumber(tool:GetAttribute("itemId") or tool:GetAttribute("id"))
end

function IsHoldingShieldSword()
	local id = GetHeldToolId()
	return id ~= nil and ShieldAnimSwordIds[id] == true
end

-- True only while an actual weapon is in hand. The game positions its build
-- preview from Mouse.Target / Mouse.UnitRay, and Silent Aim's "Mouse.Hit"
-- interception rewrites exactly those, so the rewrite is now limited to when a
-- weapon is held: with a build tool (or nothing) in hand the real mouse is left
-- alone and the preview follows the cursor instead of snapping onto whatever
-- player silent aim had locked on to.
function IsHoldingWeapon()
	local id = GetHeldToolId()
	if not id then return false end
	local data = TSG.Items and TSG.Items.getItemData(id)
	local types = data and data.itemType
	if not types then return false end
	if type(types) == "string" then
		return string.find(types, "Weapon", 1, true) ~= nil
	end
	for _, itemType in ipairs(types) do
		if type(itemType) == "string" and string.find(itemType, "Weapon", 1, true) then
			return true
		end
	end
	return false
end

function StopShieldAnimation()
	if ShieldAnimTracks then
		for _, track in ipairs(ShieldAnimTracks) do
			pcall(function() track:Stop(0.1) end)
		end
	end
	ShieldAnimTracks = nil
end

function PlayShieldAnimation()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	if ShieldAnimTracks and ShieldAnimTracks[1].Animator ~= animator then
		ShieldAnimTracks = nil
	end
	if not ShieldAnimTracks then
		local objects = GetShieldAnimationObjects()
		if not objects then return end
		ShieldAnimTracks = {}
		for _, animObj in ipairs(objects) do
			local track = animator:LoadAnimation(animObj)
			-- Action4 so the pose wins over the held weapon's own animations.
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = true
			table.insert(ShieldAnimTracks, track)
		end
	end
	for _, track in ipairs(ShieldAnimTracks) do
		if not track.IsPlaying then
			track:Play(0.1)
		end
	end
end

-- How long the shield stays down after a hit. The Custom checkbox unlocks the
-- Shield Refire slider; otherwise the built-in 2s delay is used.
function GetShieldRefireTime()
	if Toggles.ShieldCustomRefire and Toggles.ShieldCustomRefire.Value then
		return (Options.ShieldDamageRefire and Options.ShieldDamageRefire.Value) or 2
	end
	return 2
end

function TriggerShieldAnimBreak()
	local refire = GetShieldRefireTime()
	ShieldAnimBreakUntil = tick() + refire
	StopShieldAnimation()
	-- Once the refire delay is up the shield is available again, so re-check the pose.
	task.delay(refire + 0.05, UpdateShieldAnimation)
end

-- A swing hides the pose so the attack animation plays. Binding is per tool.
function BindSwingAnimStop(tool)
	if not tool or not tool:IsA("Tool") then return end
	if tool:GetAttribute("ShieldAnimSwingBound") then return end
	tool:SetAttribute("ShieldAnimSwingBound", true)
	tool.Activated:Connect(function()
		ShieldAnimSwingUntil = tick() + 0.6
		StopShieldAnimation()
		task.delay(0.65, UpdateShieldAnimation)
	end)
end

-- While the shield is up, the held tool is disabled so a screen tap / click can
-- not swing and drop the block. Auto Shield and Parry Punish only swing while
-- the shield is down, and the tool is re-enabled the moment the shield drops.
-- Declared as a global on purpose (the main chunk is at Luau's 200-local limit).
function ApplySwingBlock()
	local character = LocalPlayer.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool then return end
	local blocking = ShieldAnimHeld or (LocalPlayer:GetAttribute("IsShieldingClient") == true)
	local want = not blocking
	if tool.Enabled ~= want then
		tool.Enabled = want
	end
end

function UpdateShieldAnimation()
	-- Keep the no-swing-while-blocking state in sync with the shield.
	ApplySwingBlock()
	-- Shield is recharging after a hit: no pose until the refire delay has passed.
	if tick() < ShieldAnimBreakUntil then
		StopShieldAnimation()
		return
	end
	-- Mid-swing: let the attack animation play instead of the block pose.
	if tick() < ShieldAnimSwingUntil then
		StopShieldAnimation()
		return
	end
	if IsHoldingShieldSword() and ShieldAnimHeld then
		PlayShieldAnimation()
	else
		StopShieldAnimation()
	end
end

-- Every setShield fire now drives the pose as well as the remote.
function FireSetShield(state)
	pcall(function()
		ReplicatedStorage.remoteInterface.character.setShield:FireServer(state)
	end)
	ShieldAnimHeld = state and true or false
	UpdateShieldAnimation()
end

-- Ghost shield swap. setShield is server-authoritative and the server only
-- accepts it while a shield-capable sword is equipped, so Infinite Shield equips
-- one just long enough for the server to raise the block and then hands your own
-- weapon back. That is what makes the shield come up no matter what you happen to
-- be holding. Globals on purpose: the main chunk is already at Luau's 200-local
-- register limit.
ShieldGhostSwapBusy = false
ShieldGhostSwapLast = 0
-- Minimum gap between two swaps, so the equip remotes are never spammed.
ShieldGhostSwapInterval = 0.6

-- The shield sword the player actually owns, strongest first. Same ownership rule
-- as equipBestSword: getInventory() lists every item in the game, so being listed
-- does not mean it is owned.
function GetOwnedShieldSwordId()
	if not (TSG.ClientData and TSG.ClientData.getInventory) then return nil end
	local inventory = TSG.ClientData.getInventory() or {}
	for _, itemId in ipairs({ 545, 406 }) do
		local entry = inventory[itemId]
		if entry ~= nil and entry ~= false and (type(entry) ~= "number" or entry > 0) then
			return itemId
		end
	end
	return nil
end

function GhostShieldSwap()
	if ShieldGhostSwapBusy or IsHoldingShieldSword() then return end
	local equipRemote = TSG.EquipHotbarRemote
	if not equipRemote then return end
	local shieldId = GetOwnedShieldSwordId()
	if not shieldId then return end

	-- Same slot equipBestSword / the Atlantean swap use for swords.
	local slot = tonumber(Options.AutoArmorSlot and Options.AutoArmorSlot.Value) or 5
	local restoreId = GetHeldToolId()
	if restoreId == shieldId then restoreId = nil end

	ShieldGhostSwapBusy = true
	task.spawn(function()
		local equipped = pcall(function()
			equipRemote:InvokeServer("inventory", slot, shieldId)
		end)
		if equipped then
			-- Wait for the shield sword to actually be in hand instead of guessing
			-- with a fixed delay: the server drops setShield when it arrives before
			-- the sword does, which is the usual reason the block silently fails.
			local deadline = tick() + 0.6
			while not IsHoldingShieldSword() and tick() < deadline do
				task.wait(0.03)
			end

			FireSetShield(true)
			-- Let the server register the block before the sword is swapped back out.
			task.wait(0.1)

			-- Holding nothing is left alone on purpose: the sword stays in hand so the
			-- shield keeps holding instead of being dropped the moment it comes up.
			if restoreId then
				pcall(function()
					equipRemote:InvokeServer("inventory", slot, restoreId)
				end)
			end
		end
		ShieldGhostSwapBusy = false
	end)
end

-- The pose is only ever shown while setShield is actually held, so clear the
-- flag on respawn / death. Otherwise a stale flag leaves the character stuck in
-- the block pose even though setShield was never fired again.
function BindShieldAnimRespawn(character)
	ShieldAnimHeld = false
	ShieldAnimBreakUntil = 0
	ShieldAnimSwingUntil = 0
	ShieldAnimLastHealth = nil
	StopShieldAnimation()
	if not character then return end
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		ShieldAnimLastHealth = humanoid.Health
		-- Getting hit drops the pose and restarts the Shield Refire delay.
		humanoid.HealthChanged:Connect(function(health)
			local last = ShieldAnimLastHealth or health
			ShieldAnimLastHealth = health
			if health < last and health > 0 and ShieldAnimHeld then
				TriggerShieldAnimBreak()
			end
		end)
		humanoid.Died:Connect(function()
			ShieldAnimHeld = false
			ShieldAnimBreakUntil = 0
			StopShieldAnimation()
		end)
	end
	-- Watch the held tool so a swing can hide the pose.
	for _, child in ipairs(character:GetChildren()) do
		BindSwingAnimStop(child)
	end
	character.ChildAdded:Connect(BindSwingAnimStop)
	-- A freshly equipped tool must inherit the no-swing-while-blocking state.
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			task.defer(ApplySwingBlock)
		end
	end)
	ApplySwingBlock()
end

if LocalPlayer.Character then
	task.spawn(BindShieldAnimRespawn, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(function(character)
	task.spawn(BindShieldAnimRespawn, character)
	task.delay(0.5, UpdateShieldAnimation)
end)

-- Re-evaluate the pose whenever the held tool changes (sword equipped/unequipped).
LocalPlayer:GetAttributeChangedSignal("equippedTool"):Connect(UpdateShieldAnimation)

-- Manual blocking (right-click / shield button) flips this attribute, so mirror
-- it into the no-swing-while-blocking state too.
LocalPlayer:GetAttributeChangedSignal("IsShieldingClient"):Connect(function()
	if ApplySwingBlock then
		ApplySwingBlock()
	end
end)

