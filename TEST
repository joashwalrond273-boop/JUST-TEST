do
	local boatPlatform = nil

	local function destroyBoatPlatform()
		if boatPlatform then
			pcall(function() boatPlatform:Destroy() end)
			boatPlatform = nil
		end
	end

	Toggles.BoatSpeedToggle:OnChanged(function()
		local function getCurrentBoat()
			local humanoid = getHumanoid()
			local seat = humanoid and humanoid.SeatPart
			if not seat then return nil end
			local boats = workspace:FindFirstChild("boats")
			if not boats then return nil end
			if seat:FindFirstAncestorOfClass("Folder") == boats then
				return seat:FindFirstAncestorOfClass("Model")
			end
			return nil
		end

		local originalY = nil
		local boatCFrame = nil
		-- Cached part list for the boat we are currently in. Rebuilding it with
		-- GetDescendants() on every physics step was the single heaviest thing
		-- this feature did, so it is only rebuilt when the boat actually changes.
		local cachedBoat = nil
		local cachedBoatParts = nil
		local cachedSeat = nil
		local platformParked = false
		local nextPartRefresh = 0
		local nextPartFreeze = 0

		local function enableBoatSpeed()
			disconnect("boat_hover")
			originalY = nil
			boatCFrame = nil
			cachedBoat = nil
			cachedBoatParts = nil
			cachedSeat = nil
			platformParked = true
			nextPartRefresh = 0
			nextPartFreeze = 0

			pcall(function()
				boatPlatform = Instance.new("Part")
				boatPlatform.Name = "BoatPlatform"
				boatPlatform.Anchored = true
				boatPlatform.Size = Vector3.new(20, 1, 20)
				boatPlatform.Transparency = 1
				boatPlatform.CanCollide = true
				boatPlatform.CanTouch = false
				boatPlatform.CanQuery = false
				boatPlatform.CastShadow = false
				boatPlatform.Position = Vector3.new(0, -500, 0)
				boatPlatform.Parent = workspace
			end)

			track("boat_hover",
				RunService.Stepped:Connect(
					function()
						local now = tick()
						local humanoid = getHumanoid()
						local seat = humanoid and humanoid.SeatPart

						-- Only re-detect the boat when the seat actually changed
						-- (boarded / left / swapped) or the boat vanished. While you
						-- are not in a boat this becomes essentially free instead of
						-- running seat lookups 60x a second.
						if seat ~= cachedSeat or (cachedBoat and not cachedBoat.Parent) then
							cachedSeat = seat
							local detected = seat and getCurrentBoat() or nil
							if detected ~= cachedBoat then
								cachedBoat = detected
								cachedBoatParts = nil
								boatCFrame = nil
								originalY = nil
								platformParked = false
							end
							if not cachedBoat then
								-- Park the platform once, then stop touching it.
								if boatPlatform and not platformParked then
									platformParked = true
									boatPlatform.Position = Vector3.new(0, -500, 0)
								end
								return
							end
						end

						local boat = cachedBoat
						if not boat or not humanoid then
							return
						end

						if not boatCFrame then
							boatCFrame = boat:GetPivot()
						end
						if not originalY then
							originalY = boatCFrame.Position.Y
						end

						if not cachedBoatParts or now >= nextPartRefresh then
							nextPartRefresh = now + 5
							local parts = {}
							for _, v in ipairs(boat:GetDescendants()) do
								if v:IsA("Part") or v:IsA("MeshPart") or v:IsA("Union") then
									table.insert(parts, v)
								end
							end
							cachedBoatParts = parts
						end

						-- Zeroing every part's velocity is the pricey half of this
						-- loop, so it runs at ~20 Hz. PivotTo already re-pins the
						-- whole boat each step, so drift cannot build up in between.
						if now >= nextPartFreeze then
							nextPartFreeze = now + 0.05
							for _, v in ipairs(cachedBoatParts) do
								if v.Parent and v.AssemblyLinearVelocity.Magnitude > 0.01 then
									v.Velocity = Vector3.zero
								end
							end
						end

						boat:PivotTo(boatCFrame)
						local parent = humanoid.Parent
						if parent and not parent:GetAttribute("inTerrain") then
							boatCFrame =
								boatCFrame - Vector3.new(0, boatCFrame.Position.Y - originalY, 0)
						end
						local speedMult = Options.BoatSpeedValue and Options.BoatSpeedValue.Value or 0.9
						boatCFrame = boatCFrame + humanoid.MoveDirection * speedMult

						if boatPlatform then
							local pos = boatCFrame.Position
							boatPlatform.CFrame = CFrame.new(pos.X, pos.Y - 3, pos.Z)
						end
					end
				)
			)
		end

		local function disableBoatSpeed()
			disconnect("boat_hover")
			destroyBoatPlatform()
		end

		if Toggles.BoatSpeedToggle.Value then
			enableBoatSpeed()
		else
			disableBoatSpeed()
		end

		updateBoatVisibility()
	end)
end

